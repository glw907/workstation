#!/usr/bin/env bash
set -euo pipefail

# kitty-shot drives a REAL kitty terminal and captures what it paints: a
# PNG per named step (ImageMagick import) plus kitty's own ANSI text dump
# of the screen. Goldens, teatest, and tmux capture-pane all check text;
# only the painted terminal shows grounds, erase behavior, and pointer
# delivery. The tui-visual-verify skill explains each choice in here.
#
# HEADLESS IS THE DEFAULT (born 2026-09-21: captures on the live desktop
# interrupted the owner mid-session, stealing focus for the run's
# duration). By default this script hands off entirely to
# `kitty-headless-shot`, the workstation-level tool that drives kitty on
# an Xvfb display inside a distrobox: same real kitty, same painted
# glyphs, nothing appears on the owner's screen, no focus stolen. Pass
# `-d` (desktop) to opt into the old on-desktop path instead, forcing
# kitty onto XWayland and grabbing the window with xdotool/import against
# the LIVE session -- reserve this for the rare case the owner wants to
# watch the run happen, or for debugging the headless path itself.
#
#   scripts/kitty-shot [-d] [-o OUTDIR] [-t dark|light] [-s COLSxROWS] [-c CMD] STEP...
#   key:K           one character, or a kitty key name (escape, down)
#   type:TEXT       literal text
#   click:COL,ROW   left click on a cell, 1-based
#   wheel:up|down[@COL,ROW]
#   resize:COLSxROWS   live resize, in cells, verified against kitty
#   sleep:S
#   shot:NAME       OUTDIR/NAME.png + NAME.ansi, size appended to sizes.txt
#
# CMD is the app to drive, run under bash -c; give it an isolated state
# dir if a second instance would fight the real one's lock. -t light
# sets kitty's colors to a light ground so an app that queries the
# terminal background picks its light theme. Copy this file into the
# repo's scripts/ and set the app's defaults there.

desktop=no
outdir="${KITTY_SHOT_OUT:-captures/kitty-shot}"
theme=dark
size=120x36
cmd=""
steps=()
while [ $# -gt 0 ]; do
  case "$1" in
    -d) desktop=yes; shift ;;
    -o) outdir="$2"; shift 2 ;;
    -t) theme="$2"; shift 2 ;;
    -s) size="$2"; shift 2 ;;
    -c) cmd="$2"; shift 2 ;;
    *) steps+=("$1"); shift ;;
  esac
done
[ -n "$cmd" ] || { echo "kitty-shot: -c CMD is required (the app to drive)" >&2; exit 2; }

if [ "$desktop" = no ]; then
  command -v kitty-headless-shot >/dev/null 2>&1 || {
    echo "kitty-shot: kitty-headless-shot not on PATH (stow the dotfiles bin package)," \
         "or pass -d to run on the live desktop instead" >&2
    exit 1
  }
  exec kitty-headless-shot -o "$outdir" -t "$theme" -s "$size" -c "$cmd" "${steps[@]}"
fi

# --- everything below is the on-desktop path (-d): unchanged from the
# original harness, X11-only, forces kitty onto XWayland via kitty.conf's
# `linux_display_server x11` and grabs the window against the owner's own
# live session. ---

mkdir -p "$outdir"
outdir="$(cd "$outdir" && pwd)"

cols="${size%x*}"
rows="${size#*x}"
title="kitty-shot-$$"
sock="unix:@kitty-shot-$$"
colors=()
if [ "$theme" = light ]; then
  colors=(-o background='#E4E7EC' -o foreground='#262B33')
fi

kitty --title "$title" --listen-on "$sock" \
  -o allow_remote_control=yes -o remember_window_size=no \
  -o initial_window_width="${cols}c" -o initial_window_height="${rows}c" \
  -o enable_audio_bell=no -o window_padding_width=0 "${colors[@]}" \
  bash -c "$cmd; echo \"[kitty-shot] command exited \$?\"; sleep 600" >"$outdir/kitty.log" 2>&1 &
kpid=$!
trap 'kill $kpid 2>/dev/null || true' EXIT

wid=""
for _ in $(seq 50); do
  wid="$(xdotool search --name "^$title\$" 2>/dev/null | head -1 || true)"
  [ -n "$wid" ] && break
  sleep 0.2
done
[ -n "$wid" ] || { echo "kitty-shot: window never appeared" >&2; cat "$outdir/kitty.log" >&2; exit 1; }
focus() { xdotool windowactivate --sync "$wid"; }
focus
sleep 2

# actual reads the window's real cell grid back from kitty after a
# resize, since the OS window can land a cell or two off the request.
actual() {
  kitten @ --to "$sock" ls | python3 -c '
import json,sys
w=json.load(sys.stdin)[0]["tabs"][0]["windows"][0]
print(w["columns"], w["lines"])'
}

# Input goes through kitty's remote control straight into the window's
# pty, never through X focus: an X-level keystroke that misses its
# target lands in whoever has focus. A click is the SGR 1006 report a
# real kitty emits for that cell (press then release), which the
# kitty-shot calibration probe confirmed byte for byte, so the app
# sees exactly what a pointer would deliver.
send() { kitten @ --to "$sock" send-text "$@"; }
mouse() { printf '\033[<%s;%s;%sM\033[<%s;%s;%sm' "$1" "$2" "$3" "$1" "$2" "$3"; }

for step in "${steps[@]}"; do
  kind="${step%%:*}"
  arg="${step#*:}"
  case "$kind" in
    key)
      if [ "${#arg}" = 1 ]; then send "$arg"; else kitten @ --to "$sock" send-key "$arg"; fi
      sleep 0.4 ;;
    type) send "$arg"; sleep 0.4 ;;
    sleep) sleep "$arg" ;;
    resize)
      kitten @ --to "$sock" resize-os-window --unit cells --width "${arg%x*}" --height "${arg#*x}"
      sleep 1
      read -r cols rows < <(actual)
      [ "$cols" = "${arg%x*}" ] && [ "$rows" = "${arg#*x}" ] || echo "kitty-shot: asked $arg, got ${cols}x${rows}" >&2 ;;
    click)
      send "$(mouse 0 "${arg%,*}" "${arg#*,}")"; sleep 0.4 ;;
    wheel)
      # wheel:up|down[@COL,ROW], default cell 40,10
      dir="${arg%%@*}"; at="${arg#*@}"; [ "$at" = "$arg" ] && at=40,10
      b=65; [ "$dir" = up ] && b=64
      send "$(printf '\033[<%s;%s;%sM' "$b" "${at%,*}" "${at#*,}")"; sleep 0.4 ;;
    shot)
      import -window "$wid" "$outdir/$arg.png"
      kitten @ --to "$sock" get-text --extent screen --ansi >"$outdir/$arg.ansi"
      echo "$arg $(actual | tr ' ' x)" >>"$outdir/sizes.txt"
      echo "$outdir/$arg.png" ;;
    *) echo "kitty-shot: unknown step $step" >&2; exit 2 ;;
  esac
done
