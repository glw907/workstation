#!/usr/bin/env bash
set -euo pipefail

# kitty-headless-shot drives a REAL kitty terminal on a virtual X display
# that exists only inside a distrobox container, and photographs what it
# paints: a PNG per named step (ImageMagick `import` of the X window) plus
# kitty's own ANSI text dump. Nothing appears on the owner's desktop: the
# display is Xvfb, in memory, in a container, with no compositor or window
# manager connected to the live GNOME session. No window is created, no
# focus is stolen.
#
# Usage:
#   kitty-headless-shot [-o OUTDIR] [-t dark|light] [-s COLSxROWS] [-c CMD]
#                        [-b BOX] STEP...
#   kitty-headless-shot setup [-b BOX]
#   kitty-headless-shot --help
#
# Each STEP is one of
#   key:KEY           send a key by kitty name (q, 2, escape, question, down)
#   type:TEXT         type literal text
#   resize:COLSxROWS  resize the terminal live, in cells (works mid-run on
#                      a long-lived full-screen program, verified against
#                      kitty's own report of the grid it actually applied)
#   sleep:SECONDS     settle
#   shot:NAME         capture OUTDIR/NAME.png and OUTDIR/NAME.ansi
#   click:COL,ROW     left-click a cell (1-based)
#   wheel:up|down[@COL,ROW]  one wheel notch at a cell (default 40,10)
#
# CMD is the app to drive, run under bash -c inside the container; a
# full-screen TUI (a pager, an editor, a bubbletea program) stays running
# across every step, so key/click/wheel/resize can all be exercised against
# one live process, and the last step is usually key:q or similar to quit
# it before the harness tears the window down.
#
# `setup` creates the distrobox container fresh (idempotent: re-running it
# on an already-set-up box is a no-op) with everything the capture needs
# — Xvfb, kitty, ImageMagick, xdotool, software-GL Mesa, and fonts. Run it
# once per machine, or after `distrobox rm term-headless` on this machine.
#
# -t light overrides kitty's own background/foreground to a light ground,
# same override the on-desktop harness uses, so an app that queries the
# terminal background answers light. Everything else about the terminal
# (font, font size, the Nord palette, symbol_map glyph fallback) comes
# straight from the owner's own ~/.config/kitty/kitty.conf, shared into the
# container unchanged by distrobox's $HOME mount, so a capture uses the
# exact font the owner reads the real terminal in. -o WINDOW_PADDING is
# forced to 0 regardless of the owner's config: kitty counts padding
# inside a cell-unit resize, so a nonzero pad turns a requested COLSxROWS
# into the wrong grid.
#
# Design note (2026-09-21): an earlier on-desktop harness (this repo's
# tui-visual-verify skill, scripts/kitty-shot) drove kitty through xdotool
# and ImageMagick's `import -window`, both X11 tools, against the owner's
# real Wayland session forced onto XWayland. That works but puts a kitty
# window on the owner's live desktop and steals focus for the duration.
# This script gets the same real-kitty-paints-real-glyphs evidence without
# either cost, by giving kitty an X display that isn't the owner's: Xvfb
# under software GL (`LIBGL_ALWAYS_SOFTWARE=1`, Mesa llvmpipe; kitty needs
# OpenGL 3.3, llvmpipe answers 4.5) inside a distrobox, one distrobox
# already isolates from the host filesystem and package set. A headless
# Wayland compositor (sway/cage `WLR_BACKENDS=headless`) was the other
# candidate; Xvfb won because ImageMagick's `import` and xdotool are
# mature, well-understood X11 tools this workstation already depends on
# for the on-desktop harness, while grim/wtype against a headless
# wlroots compositor is a less-trodden path with no local track record.
# It also would not have saved a step on the host directly either way:
# this workstation's own ImageMagick has no X11 delegate wired up at all,
# and a screenshot portal or D-Bus route off the live GNOME session is
# denied or interactive. The distrobox's ImageMagick is a full build with
# X11 support, so capture only ever runs there, never against the host.
#
# Input goes through kitty's remote control straight into the pty, exactly
# as the on-desktop harness does, never through X: a click is the SGR 1006
# report bytes a real pointer produces, so the app cannot tell the
# difference. See tui-visual-verify's SKILL.md for the fuller reasoning
# (it applies unchanged here; only the display underneath moved).

box=term-headless
outdir="${KITTY_HEADLESS_SHOT_OUT:-captures/kitty-headless-shot}"
theme=dark
size=120x36
cmd=""

usage() { sed -n '4,33p' "$0" | sed 's/^# \{0,1\}//'; }

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then usage; exit 0; fi

if [ "${1:-}" = "setup" ]; then
  shift
  while getopts "b:" opt; do
    case "$opt" in
      b) box="$OPTARG" ;;
      *) exit 2 ;;
    esac
  done
  command -v distrobox >/dev/null 2>&1 || {
    echo "kitty-headless-shot: distrobox not found (see ~/.claude/docs/bluefin-admin.md, tier 5)" >&2
    exit 1
  }
  echo "kitty-headless-shot: creating (or confirming) distrobox '$box'..."
  distrobox create --name "$box" --image fedora:41 --yes
  echo "kitty-headless-shot: installing capture dependencies..."
  distrobox enter "$box" -- sudo dnf install -y \
    xorg-x11-server-Xvfb kitty ImageMagick xdotool \
    mesa-dri-drivers glx-utils jetbrains-mono-fonts
  echo "kitty-headless-shot: setup complete. Try: kitty-headless-shot -c 'echo hi' shot:test"
  exit 0
fi

while getopts "o:t:s:c:b:" opt; do
  case "$opt" in
    o) outdir="$OPTARG" ;;
    t) theme="$OPTARG" ;;
    s) size="$OPTARG" ;;
    c) cmd="$OPTARG" ;;
    b) box="$OPTARG" ;;
    *) exit 2 ;;
  esac
done
shift $((OPTIND - 1))

command -v distrobox >/dev/null 2>&1 || {
  echo "kitty-headless-shot: distrobox not found; install it first (tier 5 in bluefin-admin.md)" >&2
  exit 1
}
distrobox list 2>/dev/null | grep -qw "$box" || {
  echo "kitty-headless-shot: distrobox '$box' does not exist; run 'kitty-headless-shot setup' first" >&2
  exit 1
}
[ -n "$cmd" ] || { echo "kitty-headless-shot: -c CMD is required (the app to drive)" >&2; exit 2; }
[ "$#" -gt 0 ] || { echo "kitty-headless-shot: at least one STEP is required" >&2; exit 2; }

mkdir -p "$outdir"
outdir="$(cd "$outdir" && pwd)"

inner="$(mktemp /tmp/kitty-headless-shot-inner.XXXXXX.sh)"
trap 'rm -f "$inner"' EXIT
cat >"$inner" <<'INNER_EOF'
#!/usr/bin/env bash
set -euo pipefail

outdir="$1"; theme="$2"; size="$3"; cmd="$4"; shift 4
cols="${size%x*}"; rows="${size#*x}"
disp=":$(( (RANDOM % 8000) + 500 ))"
title="khs-$$"
sock="unix:@khs-$$"

Xvfb "$disp" -screen 0 1920x1080x24 >"$outdir/xvfb.log" 2>&1 &
xpid=$!
for _ in $(seq 25); do [ -e "/tmp/.X11-unix/X${disp#:}" ] && break; sleep 0.2; done

export DISPLAY="$disp"
export LIBGL_ALWAYS_SOFTWARE=1

colors=()
if [ "$theme" = light ]; then
  colors=(-o background='#E4E7EC' -o foreground='#262B33')
fi

confflag=()
[ -r "$HOME/.config/kitty/kitty.conf" ] && confflag=(--config "$HOME/.config/kitty/kitty.conf")

kitty "${confflag[@]}" --title "$title" --listen-on "$sock" \
  -o allow_remote_control=yes -o remember_window_size=no \
  -o initial_window_width="${cols}c" -o initial_window_height="${rows}c" \
  -o enable_audio_bell=no -o window_padding_width=0 "${colors[@]}" \
  bash -c "$cmd; echo \"[khs] command exited \$?\"; sleep 600" >"$outdir/kitty.log" 2>&1 &
kpid=$!

cleanup() { kill "$kpid" 2>/dev/null || true; kill "$xpid" 2>/dev/null || true; }
trap cleanup EXIT

wid=""
for _ in $(seq 50); do
  wid="$(xdotool search --name "^$title\$" 2>/dev/null | head -1 || true)"
  [ -n "$wid" ] && break
  sleep 0.2
done
[ -n "$wid" ] || { echo "kitty-headless-shot: window never appeared" >&2; cat "$outdir/kitty.log" >&2; exit 1; }
sleep 1

actual() {
  kitten @ --to "$sock" ls | python3 -c '
import json,sys
w=json.load(sys.stdin)[0]["tabs"][0]["windows"][0]
print(w["columns"], w["lines"])'
}
send() { kitten @ --to "$sock" send-text "$@"; }
mouse() { printf '\033[<%s;%s;%sM\033[<%s;%s;%sm' "$1" "$2" "$3" "$1" "$2" "$3"; }

for step in "$@"; do
  kind="${step%%:*}"; arg="${step#*:}"
  case "$kind" in
    key)
      if [ "${#arg}" = 1 ]; then send "$arg"; else kitten @ --to "$sock" send-key "$arg"; fi
      sleep 0.4 ;;
    type) send "$arg"; sleep 0.4 ;;
    sleep) sleep "$arg" ;;
    resize)
      kitten @ --to "$sock" resize-os-window --unit cells --width "${arg%x*}" --height "${arg#*x}"
      sleep 1
      read -r c r < <(actual)
      [ "$c" = "${arg%x*}" ] && [ "$r" = "${arg#*x}" ] || echo "kitty-headless-shot: asked $arg, got ${c}x${r}" >&2 ;;
    click)
      send "$(mouse 0 "${arg%,*}" "${arg#*,}")"; sleep 0.4 ;;
    wheel)
      dir="${arg%%@*}"; at="${arg#*@}"; [ "$at" = "$arg" ] && at=40,10
      b=65; [ "$dir" = up ] && b=64
      send "$(printf '\033[<%s;%s;%sM' "$b" "${at%,*}" "${at#*,}")"; sleep 0.4 ;;
    shot)
      import -window "$wid" "$outdir/$arg.png"
      kitten @ --to "$sock" get-text --extent screen --ansi >"$outdir/$arg.ansi"
      echo "$arg $(actual | tr ' ' x)" >>"$outdir/sizes.txt"
      echo "$outdir/$arg.png" ;;
    *) echo "kitty-headless-shot: unknown step $step" >&2; exit 2 ;;
  esac
done
INNER_EOF

distrobox enter "$box" -- bash "$inner" "$outdir" "$theme" "$size" "$cmd" "$@"
