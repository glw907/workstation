#!/usr/bin/env python3
"""PreToolUse hook denying a `claude --bg` pass launch whose plan skipped its pre-launch checks.

The hook finds the plan a launch runs: the prompt file named in `$(cat <file>)`, then the
`docs/plans/*.md` path that file names, else its sibling with `-prompt.txt` swapped for `.md`. The
plan's `## Pre-flight` section must carry a `Permissions checked:` line, saying how each task's
credentials and writes were read against auto mode, and a `Reviewed:` line naming the plan review.
A launch with no plan is not a pass and goes through. A plan launch is also denied when the
session's transcript never lists `standards:plan-reviewer`, because a session without the
`standards` plugin can't run the pass process it is launching. Per the hooks reference
(https://code.claude.com/docs/en/hooks) a denial is `hookSpecificOutput.permissionDecision:
"deny"` with a `permissionDecisionReason`, printed with exit 0. This is a slip guard, not a
security boundary. Every input the script cannot parse exits 0 silently.
"""

import json
from pathlib import Path
import re
import shlex
import sys

HEREDOC = re.compile(r"(?<!<)<<-?\s*(['\"]?)([A-Za-z_]\w*)\1")
ASSIGNMENT = re.compile(r"[A-Za-z_]\w*=")
PROMPT_FILE = re.compile(r"\$\s*\(\s*cat\s+[\"']?([^\"')\s]+)")
PLAN_PATH = re.compile(r"[\w./~-]*docs/plans/[\w./-]+\.md")
REQUIRED = ("Permissions checked:", "Reviewed:")


def strip_heredocs(command: str) -> str:
    """Drop heredoc bodies so their text is never tokenized as commands."""
    kept: list[str] = []
    delimiter = None
    for line in command.split("\n"):
        if delimiter is not None:
            if line.strip() == delimiter:
                delimiter = None
            continue
        kept.append(line)
        found = HEREDOC.search(line)
        if found:
            delimiter = found.group(2)
    return "\n".join(kept)


def stages(command: str) -> list[list[str]]:
    """Split a command into simple commands at pipes, `&&`, `||`, `;`, `&`, and newlines."""
    lexer = shlex.shlex(command.replace("\\\n", " "), posix=True, punctuation_chars="|;&()\n")
    lexer.whitespace = " \t\r"
    lexer.whitespace_split = True
    result: list[list[str]] = [[]]
    for token in lexer:
        if set(token) <= set("|;&()\n"):
            result.append([])
        else:
            result[-1].append(token)
    return [stage for stage in result if stage]


def words(stage: list[str]) -> list[str]:
    """Return a stage's words after any leading variable assignments."""
    index = 0
    while index < len(stage) and ASSIGNMENT.match(stage[index]):
        index += 1
    return stage[index:]


def launch_stage(command: str, cwd: Path) -> tuple[list[str], Path] | None:
    """Return the `claude --bg` stage and its working directory, or None when none runs."""
    base = cwd
    for stage in stages(strip_heredocs(command)):
        run = words(stage)
        if len(run) > 1 and run[0] == "cd":
            base = base / Path(run[1]).expanduser()
        elif run and Path(run[0]).name == "claude" and "--bg" in run:
            return run, base
    return None


def repo_root(prompt: Path) -> Path:
    """Return the folder that holds a prompt file's `docs/`, or the file's own folder."""
    for parent in prompt.parents:
        if parent.name == "docs":
            return parent.parent
    return prompt.parent


def plan_for(stage: list[str], base: Path) -> Path | None:
    """Return the plan a launch stage runs, or None for a launch that names no plan."""
    text = " ".join(stage)
    found = PROMPT_FILE.search(text)
    if not found:
        named = PLAN_PATH.search(text)
        return base / Path(named.group(0)).expanduser() if named else None
    prompt = base / Path(found.group(1)).expanduser()
    if not prompt.is_file():
        return None
    named = PLAN_PATH.search(prompt.read_text(errors="replace"))
    if named:
        for root in (base, repo_root(prompt)):
            plan = root / Path(named.group(0)).expanduser()
            if plan.is_file():
                return plan
    sibling = prompt.with_name(prompt.name.replace("-prompt.txt", ".md"))
    return sibling if sibling != prompt and sibling.is_file() else None


def missing(plan: Path) -> list[str]:
    """Return what the plan's `## Pre-flight` section lacks."""
    text = plan.read_text(errors="replace")
    section = re.search(r"^## Pre-flight\s*$(.*?)(?=^## |\Z)", text, re.M | re.S)
    if not section:
        return ["a `## Pre-flight` section", *(f"a `{line}` line" for line in REQUIRED)]
    return [f"a `{line}` line" for line in REQUIRED if line not in section.group(1)]


def lacks_standards(transcript: str | None) -> bool:
    """Return whether a readable transcript never lists the plan-review agent."""
    if not transcript:
        return False
    try:
        return "standards:plan-reviewer" not in Path(transcript).read_text(errors="replace")
    except OSError:
        return False


def main() -> None:
    """Read the hook input and deny a pass launch whose plan lacks its checks."""
    try:
        data = json.load(sys.stdin)
        launch = launch_stage(data["tool_input"]["command"], Path(data.get("cwd") or "."))
        if launch is None:
            return
        plan = plan_for(*launch)
        if plan is None or not plan.is_file():
            return
        gaps = missing(plan)
        if lacks_standards(data.get("transcript_path")):
            gaps.append("a session with the `standards` plugin loaded (restart the session)")
    except (AttributeError, KeyError, OSError, RuntimeError, TypeError, ValueError):
        return
    if not gaps:
        return
    reason = (
        f"{plan} needs {', '.join(gaps)} before launch. Read every task for a credential, a "
        "remote write, a settings write, or new public surface; give each a `[you]` item or a "
        "probe that proved it; and run the plan review (`pass-core`, Lifecycle step 4)."
    )
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}))


if __name__ == "__main__":
    main()
