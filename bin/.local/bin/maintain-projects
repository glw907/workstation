#!/usr/bin/env bash
# maintain-projects: the monthly update for every project in maintenance mode. For each repo in
# bluefin/maintenance-projects.txt it takes the in-range updates at least seven days old, runs the
# repo's gate, pushes to main, and waits for CI to deploy. A quiet run says nothing; a failure
# leaves main alone where it can and raises one normal notification. What `npm outdated` still
# lists goes in the state directory, so a later feature pass can see what is held, and each held
# major is checked against the peer ranges of what is installed, so that pass sees what refuses it.
# The maintenance-mode skill holds the rules. --dry-run stops before the commit, and --status
# lists each project's last run and how many packages are held behind.
set -uo pipefail

root=${MAINTAIN_ROOT:-$HOME/Projects}
list=${MAINTAIN_LIST:-$HOME/.dotfiles/bluefin/maintenance-projects.txt}
state=${MAINTAIN_STATE:-$HOME/.local/state/maintain-projects}
hold_days=7
dry_run=
[ "${1:-}" = --dry-run ] && dry_run=1

# A unit starts with no login shell, and these go last so a test's stubs win.
export PATH="$PATH:$HOME/.local/share/mise/installs/node/lts/bin:/home/linuxbrew/.linuxbrew/bin"
# A lockfile may name a git+ssh dependency, and a timer has no SSH agent.
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=url.https://github.com/.insteadOf GIT_CONFIG_VALUE_0=ssh://git@github.com/

failed=0

report() { # repo message
    printf '%s: %s\n' "$1" "$2" >&2
    failed=1
    printf 'failed: %s\n' "$2" >"$state/$1.result"
    notify-send --urgency=normal "Maintenance: $1" "$2" 2>/dev/null || true
}

# held_majors: one line per held major, naming each installed package whose peer range refuses it.
# Node, because the repo's own semver reads the ranges.
held_majors() {
    node -e '
const fs = require("fs"), path = require("path");
const semver = require(path.resolve("node_modules/semver"));
const major = (v) => Number(v.split(".")[0]);
const installed = fs.readdirSync("node_modules").flatMap((d) =>
  d.startsWith("@") ? fs.readdirSync(path.join("node_modules", d)).map((s) => path.join(d, s)) : [d]);
const peers = installed.flatMap((d) => {
  try {
    const p = JSON.parse(fs.readFileSync(path.join("node_modules", d, "package.json"), "utf8"));
    return [{ name: p.name, peers: p.peerDependencies ?? {} }];
  } catch {
    return [];
  }
});
for (const [pkg, v] of Object.entries(JSON.parse(fs.readFileSync(0, "utf8") || "{}"))) {
  if (!v.current || !v.latest || major(v.latest) <= major(v.current)) continue;
  const refused = peers.filter((p) => p.peers[pkg] && !semver.satisfies(v.latest, p.peers[pkg]));
  const names = refused.map((p) => `${p.name} (${p.peers[pkg]})`).join(", ");
  console.log(`${pkg} ${v.latest}: ${names ? `refused by ${names}` : "no peer refuses it"}`);
}'
}

ci_passes() { # repo sha
    local run='' tries=0
    while [ -z "$run" ] && [ "$tries" -lt 20 ]; do
        run=$(gh run list -R "glw907/$1" --commit "$2" --limit 1 --json databaseId --jq '.[0].databaseId // empty')
        [ -n "$run" ] || { sleep "${MAINTAIN_CI_WAIT:-15}"; tries=$((tries + 1)); }
    done
    [ -n "$run" ] && gh run watch "$run" -R "glw907/$1" --exit-status >/dev/null
}

update_tree() { # repo checkout tree log
    local repo=$1 src=$2 tree=$3 log=$4 sha
    cd "$tree" || return 1
    npm ci >>"$log" 2>&1 || { report "$repo" "npm ci failed. See $log"; return 1; }
    npm update --save --min-release-age="$hold_days" >>"$log" 2>&1 \
        || { report "$repo" "npm update failed. See $log"; return 1; }
    npm audit fix >>"$log" 2>&1 || true
    [ ! -x node_modules/.bin/playwright ] || npx --no-install playwright install chromium >>"$log" 2>&1 \
        || { report "$repo" "The browser install failed. See $log"; return 1; }
    npm outdated >"$state/$repo.held" 2>&1 || true
    { npm outdated --json 2>/dev/null || true; } | held_majors >"$state/$repo.blocked" 2>>"$log" || true

    if git diff --quiet -- package.json package-lock.json; then
        echo "ok: nothing to update" | tee "$state/$repo.result"
        return 0
    fi
    npm run check >>"$log" 2>&1 \
        || { report "$repo" "The gate failed on this month's updates, and main is unchanged. See $log"; return 1; }
    if [ -n "$dry_run" ]; then
        git diff --stat -- package.json package-lock.json
        return 0
    fi

    git commit -q -m "Take the month's dependency updates" -- package.json package-lock.json \
        || { report "$repo" "git commit failed, and main is unchanged."; return 1; }
    git push -q origin HEAD:main >>"$log" 2>&1 \
        || { report "$repo" "The push to main failed. See $log"; return 1; }
    sha=$(git rev-parse HEAD)
    ci_passes "$repo" "$sha" \
        || { report "$repo" "CI failed on $sha, which is on main and may not have deployed."; return 1; }
    git -C "$src" pull -q --ff-only >>"$log" 2>&1 && (cd "$src" && npm ci >>"$log" 2>&1) \
        || { report "$repo" "CI passed, but the main checkout did not update. See $log"; return 1; }
    echo "ok: updated and deployed $sha" | tee "$state/$repo.result"
}

maintain() { # repo
    local repo=$1 src=$root/$1 log=$state/$1.log tree tmp
    : >"$log"
    if [ "$(git -C "$src" branch --show-current)" != main ] || [ -n "$(git -C "$src" status --porcelain --untracked-files=no)" ]; then
        report "$repo" "Skipped: the main checkout is busy, so it will try again next month."
        return
    fi
    git -C "$src" fetch -q origin main || { report "$repo" "git fetch failed."; return; }
    tmp=$(mktemp -d)
    tree=$tmp/$repo
    git -C "$src" worktree add -q --detach "$tree" origin/main || { report "$repo" "git worktree add failed."; return; }
    update_tree "$repo" "$src" "$tree" "$log"
    cd "$root" || exit 1
    git -C "$src" worktree remove --force "$tree"
    rm -rf "$tmp"
}

status() { # repo
    local last=never held=0 blocked=0 result='not run'
    [ -f "$state/$1.log" ] && last=$(date -r "$state/$1.log" +%F)
    [ -s "$state/$1.held" ] && held=$(($(wc -l <"$state/$1.held") - 1))
    [ -f "$state/$1.blocked" ] && blocked=$(grep -c 'refused by' "$state/$1.blocked")
    [ -f "$state/$1.result" ] && result=$(cat "$state/$1.result")
    printf '%s: last run %s, %s held behind, %s majors refused by a peer, %s\n' "$1" "$last" "$held" "$blocked" "$result"
}

mkdir -p "$state"
[ -r "$list" ] || { report maintain-projects "The project list is missing: $list"; exit 1; }
while read -r repo <&3; do
    case $repo in '' | '#'*) continue ;; esac
    if [ "${1:-}" = --status ]; then status "$repo"; else maintain "$repo"; fi
done 3<"$list"
exit "$failed"
