#!/usr/bin/env bash
# PreToolUse hook (Write|Edit): when the target is a file under a project's memory directory,
# inject a reminder that a rule belongs in its execution path, not in memory. Never blocks.
set -euo pipefail
path=$(jq -r '.tool_input.file_path // empty')
case "$path" in
  "$HOME"/.claude/projects/*/memory/MEMORY.md|/var"$HOME"/.claude/projects/*/memory/MEMORY.md) exit 0 ;;
  "$HOME"/.claude/projects/*/memory/*|/var"$HOME"/.claude/projects/*/memory/*) ;;
  *) exit 0 ;;
esac
jq -n --arg msg "Memory write check. Route this record first: a rule goes in its execution path (a tool, runner, or hook; else a skill or agent definition; else the global or repo CLAUDE.md); initiative state goes in STATUS, ROADMAP, or HISTORY; a repo fact goes in that repo's docs; a workstation fact goes in ~/.claude/docs. Memory holds only a preference or the why behind a ruling that no file can hold, and a project memory reaches no other project." '{hookSpecificOutput: {hookEventName: "PreToolUse", additionalContext: $msg}}'
