#!/usr/bin/env bash
set -euo pipefail

# thunderbird-theme-sync: rebuild the Thunderbird GNOME theme install from
# upstream plus this repo's local layer.
# Usage: thunderbird-theme-sync           # update and reinstall
#        thunderbird-theme-sync --check   # read-only: does the profile match?
#
# The theme (rafaelmardojai/thunderbird-gnome-theme) is plain CSS copied into
# each Thunderbird profile's chrome/ folder, so nothing updates it for us. The
# local layer lives in ~/.dotfiles/thunderbird/:
#   customChrome.css   overrides for the main window; the theme imports it
#                      last and never ships one
#   customContent.css  overrides for Settings, the address book, and account
#                      settings, which load as content pages that
#                      userChrome.css never reaches
#   user.js            preferences (the theme's two, plus tag colors),
#                      copied over the profile's user.js
#   patches/*.patch    fixes carried until upstream merges them
#
# A profile exists only after Thunderbird's first launch, so on a fresh
# machine: launch Thunderbird, sign in, quit, then run this.
#
# A sync resets the clone to upstream main, applies each carried patch
# (reporting any upstream has since merged), runs the theme's installer
# against the Flatpak profile folder, copies both override files and user.js
# in, and rewrites the profile's userChrome.css and userContent.css so they
# import exactly the theme and the overrides. Quit Thunderbird first; it reads
# its stylesheets and user.js only at startup. Run it after a Thunderbird update that breaks
# the look, or whenever upstream moves.

LAYER="$HOME/.dotfiles/thunderbird"
CLONE="$HOME/.local/share/thunderbird-gnome-theme"
UPSTREAM="https://github.com/rafaelmardojai/thunderbird-gnome-theme"
TB_DIR="$HOME/.var/app/org.mozilla.thunderbird/.thunderbird"

# Prints each profile directory listed in profiles.ini, one per line.
profiles() {
    [[ -f "$TB_DIR/profiles.ini" ]] || return 0
    sed -n 's/^Path=//p' "$TB_DIR/profiles.ini" | while read -r p; do
        [[ "$p" == /* ]] && echo "$p" || echo "$TB_DIR/$p"
    done
}

# The profile's top-level stylesheets. The theme's installer appends its own
# import lines; writing these whole keeps them exact across reinstalls.
chrome_imports()  { echo '@import "thunderbird-gnome-theme/userChrome.css";'; }
content_imports() {
    echo '@import "thunderbird-gnome-theme/userContent.css";'
    echo '@import "thunderbird-gnome-theme/customContent.css";'
}

# Fails with a hint when Thunderbird has never run, since there is no
# profile to install into yet.
require_profile() {
    [[ -n "$(profiles)" ]] && return 0
    echo "x no Thunderbird profile yet: launch Thunderbird once, sign in, quit, then run thunderbird-theme-sync"
    return 1
}

check() {
    local fail=0 p dest
    require_profile || return 1
    [[ -d "$CLONE/.git" ]] || { echo "x theme clone missing at $CLONE"; return 1; }
    while read -r p; do
        dest="$p/chrome/thunderbird-gnome-theme"
        if [[ ! -d "$dest" ]]; then
            echo "x $(basename "$p"): theme not installed"; fail=1; continue
        fi
        for f in customChrome.css customContent.css; do
            if ! diff -q "$LAYER/$f" "$dest/$f" >/dev/null 2>&1; then
                echo "x $(basename "$p"): $f differs from the dotfiles copy"; fail=1
            fi
        done
        if ! diff -q "$LAYER/user.js" "$p/user.js" >/dev/null 2>&1; then
            echo "x $(basename "$p"): user.js differs from the dotfiles copy"; fail=1
        fi
        if ! diff -q <(content_imports) "$p/chrome/userContent.css" >/dev/null 2>&1; then
            echo "x $(basename "$p"): userContent.css doesn't import the overrides"; fail=1
        fi
        if ! diff -rq "$CLONE/theme" "$dest/theme" >/dev/null 2>&1; then
            echo "x $(basename "$p"): installed theme differs from the clone"; fail=1
        fi
        [[ "$fail" -eq 0 ]] && echo "+ $(basename "$p"): theme and overrides match"
    done < <(profiles)
    return "$fail"
}

sync() {
    if pgrep -f '/app/lib/thunderbird/thunderbird' >/dev/null; then
        echo "Thunderbird is running; quit it first." >&2
        exit 1
    fi
    require_profile || exit 1
    [[ -d "$CLONE/.git" ]] || git clone -q "$UPSTREAM" "$CLONE"
    git -C "$CLONE" fetch -q origin
    git -C "$CLONE" reset -q --hard origin/main
    git -C "$CLONE" clean -qfd
    echo "Theme at $(git -C "$CLONE" log -1 --format='%h %cs %s')"

    local patch
    for patch in "$LAYER"/patches/*.patch; do
        [[ -e "$patch" ]] || continue
        if git -C "$CLONE" apply --reverse --check "$patch" 2>/dev/null; then
            echo "Merged upstream, delete it: $(basename "$patch")"
        elif git -C "$CLONE" apply "$patch"; then
            echo "Applied $(basename "$patch")"
        else
            echo "Patch no longer applies: $(basename "$patch"); resolve before syncing." >&2
            exit 1
        fi
    done

    # The installer probes $(tty) for colors; give it no terminal to probe.
    # Its -t flag imports color files the theme no longer ships, so omit it.
    (cd "$CLONE" && ./scripts/install.sh -f "$TB_DIR" </dev/null >/dev/null 2>&1)

    local p
    while read -r p; do
        cp "$LAYER/customChrome.css" "$LAYER/customContent.css" "$p/chrome/thunderbird-gnome-theme/"
        chrome_imports > "$p/chrome/userChrome.css"
        content_imports > "$p/chrome/userContent.css"
        cp "$LAYER/user.js" "$p/user.js"
    done < <(profiles)
    check
}

case "${1:-}" in
    --check) check ;;
    "") sync ;;
    *) echo "usage: thunderbird-theme-sync [--check]" >&2; exit 2 ;;
esac
