#!/usr/bin/env python3
"""Deny Claude Code tool calls that would write secret-shaped material.

PreToolUse hook for Write, Edit, and Bash. Reads the hook payload from stdin,
scans the text that would land on disk (file content, edit replacement, or the
command text) for credential shapes, and exits 2 with a reason to block the
call. Born from the 2026-01-30 incident where a live Cloudflare API token was
committed to the public workstation repo in plaintext.

For a Bash call it also refuses a Git command that would commit a `.env` or
`.env.<x>` file, apart from the example names in ENV_EXAMPLES: a `git add` that
names one, and a `git commit` when one is staged, named, or (with `-a`) a
modified tracked file. After a whole-tree add earlier in the same command, the
commit check covers modified and untracked names too. It reads the repo the way
claude-merge-guard does, through that script's parser, and allows the command
when Git fails or the parser can't load. File contents at commit time are left
to gitleaks in the pre-commit hook.

Set CLAUDE_SECRET_GUARD_ALLOW=1 in the command environment to bypass one
deliberate write of a known-fake value (test fixtures, documentation examples).
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import sys
from pathlib import Path

ASSIGNMENT_NAME = "credential-shaped assignment with a literal value"

PATTERNS = [
    (r"sk-ant-[A-Za-z0-9_-]{20,}", "Anthropic API key"),
    (r"\bsk-[A-Za-z0-9]{32,}", "provider API key (sk-...)"),
    (r"\bgh[pousr]_[A-Za-z0-9]{36,}", "GitHub token"),
    (r"\bgithub_pat_[A-Za-z0-9_]{36,}", "GitHub fine-grained PAT"),
    (r"\bxox[baprs]-[A-Za-z0-9-]{10,}", "Slack token"),
    (r"\bAKIA[0-9A-Z]{16}\b", "AWS access key id"),
    (r"AGE-SECRET-KEY-1[A-Z0-9]{20,}", "age private key"),
    (r"\bpst_[A-Za-z0-9_-]{12,}::[A-Za-z0-9+/_=-]{12,}", "Proton Pass access token"),
    (r"-----BEGIN [A-Z ]*PRIVATE KEY-----", "PEM private key"),
    (r"\beyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{20,}", "JWT"),
    (
        r"(?i)^\s*(export\s+)?(?P<name>[A-Z0-9_]*(TOKEN|SECRET|PASSWORD|PASSWD|API_KEY|"
        r"PRIVATE_KEY|CLIENT_SECRET)[A-Z0-9_]*)\s*=\s*['\"]?(?P<value>[A-Za-z0-9+/_.=-]{16,})",
        ASSIGNMENT_NAME,
    ),
]

# An assignment is not a value when the variable names a file and the value is a path
# (RESTIC_PASSWORD_FILE=/etc/servers/restic-password), or when the value calls itself fake.
PATH_NAME = re.compile(r"(?i)_(FILE|PATH|DIR)$")
PATH_VALUE = re.compile(r"[/~.$]")
FAKE_VALUE = re.compile(r"(?i)dummy|fake|sentinel|example")

# A line matching one of these is a reference or placeholder, not a value.
# "secret-guard-allow" is the inline bypass: put it on the same line as a
# known-fake value (a test fixture, a docs example) to write it deliberately.
# Only deliberate placeholder markers belong here. Never add broad markers
# like $VAR or pass:// references: a real token can share a line with either,
# and a line-level skip would wave it through (it did, once, in testing).
ALLOW = re.compile(
    r"redacted|placeholder|<value|1x0{20}|"
    r"changeme|your[-_]?token|xxxx|secret-guard-allow",
    re.IGNORECASE,
)


def scan(text):
    """Return (pattern name, offending line) for the first hit, else None."""
    for line in text.splitlines():
        if ALLOW.search(line):
            continue
        for pattern, name in PATTERNS:
            found = re.search(pattern, line, re.MULTILINE)
            if found and not (name == ASSIGNMENT_NAME and not_a_value(found)):
                return name, line[:80]
    return None


def not_a_value(found):
    """Report whether a credential-shaped assignment holds a file path or a self-declared fake."""
    if PATH_NAME.search(found.group("name")) and PATH_VALUE.match(found.group("value")):
        return True
    return FAKE_VALUE.search(found.group("value")) is not None


ENV_NAME = re.compile(r"\.env(?:\.[^/]+)?")
ENV_EXAMPLES = {".env.example", ".env.sample", ".env.template", ".env.dist"}
GIT_STAGING = re.compile(r"(?<![\w.-])git(?![\w.-])[\s\S]*(?<![\w.-])(?:add|stage|commit)(?![\w.-])")


def env_file(path):
    """Report whether a path names a .env or .env.<x> file that isn't an example."""
    name = path.rstrip("/").rsplit("/", 1)[-1]
    return ENV_NAME.fullmatch(name) is not None and name not in ENV_EXAMPLES


def load_merge_guard():
    """Load claude-merge-guard from beside this script, or return None."""
    path = Path(__file__).resolve().parent / "claude-merge-guard"
    try:
        loader = importlib.machinery.SourceFileLoader("claude_merge_guard", str(path))
        spec = importlib.util.spec_from_loader("claude_merge_guard", loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
    except (OSError, SyntaxError, ImportError):
        return None
    return module


def env_commit(command, cwd):
    """Return the .env path a Git command would commit, or None."""
    if not GIT_STAGING.search(command):
        return None
    guard = load_merge_guard()
    if guard is None:
        return None
    whole_add = False
    try:
        for _, _, git in guard.git_stages(command, Path(cwd) if cwd else None):
            if git.subcommand in ("add", "stage"):
                _, named = guard.operands(git.args, {"--chmod", "--pathspec-from-file"})
                found = next((path for path in named if env_file(path)), None)
                if found:
                    return found
                whole_add = whole_add or guard.whole_tree(git)
            elif git.subcommand == "commit":
                found = committed_env(guard, git, whole_add)
                if found:
                    return found
    except Exception:  # noqa: BLE001 - a parser crash must not block every command
        return None
    return None


def committed_env(guard, git, whole_add):
    """Return a .env path a git commit stage would record, or None."""
    options, named = guard.operands(git.args, guard.COMMIT_VALUE_LONG, guard.COMMIT_VALUE_SHORT)
    found = next((path for path in named if env_file(path)), None)
    if found:
        return found
    listings = [("diff", "--cached", "--name-only")]
    if whole_add or guard.whole_tree(git):
        listings.append(("diff", "--name-only"))
    if whole_add:
        listings.append(("ls-files", "--others", "--exclude-standard"))
    for listing in listings:
        names = git.lines("-c", "core.quotePath=off", *listing)
        found = next((path for path in names or [] if env_file(path)), None)
        if found:
            return found
    return None


def gather_text(payload):
    """Extract the text a tool call would persist, from the hook payload.

    Unknown tools fall back to scanning the whole serialized input, so a
    matcher that catches more tools than this function knows (MultiEdit,
    NotebookEdit, future editors) still gets scanned rather than waved
    through.
    """
    tool = payload.get("tool_name", "")
    inp = payload.get("tool_input", {})
    if tool == "Write":
        return inp.get("content", "")
    if tool == "Edit":
        return inp.get("new_string", "")
    if tool == "MultiEdit":
        return "\n".join(e.get("new_string", "") for e in inp.get("edits", []))
    if tool == "NotebookEdit":
        return inp.get("new_source", "")
    if tool == "Bash":
        return inp.get("command", "")
    try:
        return json.dumps(inp)
    except (TypeError, ValueError):
        return ""


def main():
    """Read the hook payload, scan it, and exit 2 on a hit."""
    if os.environ.get("CLAUDE_SECRET_GUARD_ALLOW") == "1":
        return 0
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0  # fail open on malformed payload; gitleaks backstops commits
    text = gather_text(payload)
    if not text:
        return 0
    if payload.get("tool_name") == "Bash" and isinstance(text, str):
        cwd = payload.get("cwd")
        found = env_commit(text, cwd if isinstance(cwd, str) else None)
        if found:
            sys.stderr.write(
                "claude-secret-guard: blocked, this command would commit {!r}, a .env file. "
                "Keep real values in ~/.local/secrets or the age store and commit a "
                ".env.example with placeholders instead. Unstage it with "
                "git restore --staged <path> if it is already staged.\n".format(found)
            )
            return 2
    hit = scan(text)
    if hit:
        name, line = hit
        sys.stderr.write(
            "claude-secret-guard: blocked, {} detected in tool input "
            "(line starts: {!r}). For a known-fake value, add "
            "'secret-guard-allow' on that line (or set "
            "CLAUDE_SECRET_GUARD_ALLOW=1 in the session). A real secret "
            "belongs in the age store via secret-set.sh, never in tracked "
            "files.\n".format(name, line)
        )
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
