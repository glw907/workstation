#!/usr/bin/env bash
# Run a gate command string to completion and print its tail, pacing the wait so an
# implementer never polls a log.
#
# The first call starts the gate detached (keyed by the gate string and the working
# directory) and blocks up to CAIRN_GATE_WAIT seconds (default 540, under the shell
# tool's ten-minute cap). If the gate finishes inside that window, the exit status and
# the last 60 lines print. If not, the call prints "gate still running" and exits 75;
# the caller re-issues the SAME command, which reattaches to the running gate and waits
# again. A finished gate's result is printed once and then cleared, so a later call with
# the same string starts a fresh run.
#
# Usage: cairn-run-gate '<gate string>' [log path]
# Memory: the gate runs in a transient user scope capped by CAIRN_GATE_MEMORY_HIGH (7G),
# CAIRN_GATE_MEMORY_MAX (8G), and CAIRN_GATE_SWAP_MAX (4G); override per call as needed.
# Lanes: gates queue on one machine-wide lock per lane. The default lane, heavy, is for a
# browser-bearing gate that peaks near the laptop's RAM. CAIRN_GATE_LANE=light is for a gate
# that launches no browser (a Go `make check`, a lint-only run): it queues on its own lock, so
# it never waits behind a browser gate, and it runs under a smaller cap (2G high, 3G max, 1G
# swap) so one light gate beside one heavy gate still fits in RAM. Light gates serialize among
# themselves. CAIRN_GATE_PARALLEL=1 skips every lock and is kept for callers that set it.
# Exit status: the gate's when it has finished; 75 while it is still running.
set -u
gate="${1:?gate string required}"
wait_s="${CAIRN_GATE_WAIT:-540}"
key=$(printf '%s\n%s' "$PWD" "$gate" | sha256sum | cut -c1-16)
gatedir="${TMPDIR:-/tmp}/cairn-gate-$(id -u)"
state="$gatedir/$key"
mkdir -p "$state"
log="${2:-$state/gate.log}"
pidfile="$state/pid"
statusfile="$state/status"

if [ ! -e "$pidfile" ]; then
  rm -f "$statusfile"
  : >"$log"
  # Run the gate in its own transient cgroup with a memory ceiling, so a runaway headless
  # browser is throttled and then killed inside the gate instead of driving system-wide
  # pressure that systemd-oomd resolves by killing the desktop session (two concurrent
  # gates cost the GNOME session on 2026-09-14). Empty prefix where systemd-run is absent.
  lane="${CAIRN_GATE_LANE:-heavy}"
  case "$lane" in
    heavy) mem_high=7G mem_max=8G swap_max=4G ;;
    light) mem_high=2G mem_max=3G swap_max=1G ;;
    *) echo "cairn-run-gate: unknown CAIRN_GATE_LANE '$lane' (heavy or light)" >&2; rm -rf "$state"; exit 2 ;;
  esac
  scope=()
  if command -v systemd-run >/dev/null 2>&1; then
    scope=(systemd-run --user --scope -q
      -p "MemoryHigh=${CAIRN_GATE_MEMORY_HIGH:-$mem_high}"
      -p "MemoryMax=${CAIRN_GATE_MEMORY_MAX:-$mem_max}"
      -p "MemorySwapMax=${CAIRN_GATE_SWAP_MAX:-$swap_max}")
  fi
  # One gate per machine at a time: a browser-bearing gate peaks near the laptop's RAM, so
  # concurrent gates from parallel chains queue on a shared lock instead of running side
  # by side. A browserless gate takes the light lane instead of waiting behind a browser.
  # The heavy lane keeps the original lock file name, so a gate started by an older copy of
  # this script and one started by this copy still exclude each other.
  if [ "${CAIRN_GATE_PARALLEL:-0}" = "1" ]; then
    lock=()
  elif [ "$lane" = "light" ]; then
    lock=(flock "$gatedir/machine-light.lock")
  else
    lock=(flock "$gatedir/machine.lock")
  fi
  # Stamp when the run was queued and when it got the lock, so the result can say how long the
  # gate waited on another gate. The stamp runs inside the lock, before the gate itself.
  date +%s >"$state/queued"
  echo "$lane" >"$state/lane"
  ( "${lock[@]}" "${scope[@]}" bash -c 'date +%s >"$1"; exec bash -c "$2"' _ "$state/acquired" "$gate" >"$log" 2>&1; echo $? >"$statusfile" ) </dev/null &
  echo $! >"$pidfile"
  echo "gate started (log: $log)"
fi

pid=$(cat "$pidfile")
waited=0
while [ ! -e "$statusfile" ] && [ "$waited" -lt "$wait_s" ]; do
  sleep 5
  waited=$((waited + 5))
  if ! kill -0 "$pid" 2>/dev/null && [ ! -e "$statusfile" ]; then
    sleep 2
    break
  fi
done

if [ ! -e "$statusfile" ]; then
  if kill -0 "$pid" 2>/dev/null; then
    echo "gate still running after ${waited}s more (log: $log, $(wc -l <"$log") lines so far)."
    echo "Re-run this exact cairn-run-gate command to keep waiting; do not tail, wc, ps, or sleep on the log."
    exit 75
  fi
  echo "gate process vanished without a status; treating as failure (log: $log)"
  status=1
else
  status=$(cat "$statusfile")
fi

# Tell whoever ran this gate when it lost real time to the queue. The rule that a browserless
# gate belongs on the light lane is easy to not know; the wait is where it costs, so say it here.
hint_after="${CAIRN_GATE_HINT_AFTER:-120}"
if [ -e "$state/queued" ] && [ -e "$state/acquired" ]; then
  lock_wait=$(( $(cat "$state/acquired") - $(cat "$state/queued") ))
  if [ "$lock_wait" -ge "$hint_after" ] && [ "$(cat "$state/lane" 2>/dev/null)" = "heavy" ]; then
    echo "NOTE: this gate waited ${lock_wait}s for another gate to release the machine lock."
    echo "NOTE: if it launches no browser (a Go make check, a lint-only run), run it as"
    echo "NOTE:   CAIRN_GATE_LANE=light cairn-run-gate '<gate string>'"
    echo "NOTE: which has its own lock. Report this NOTE to your conductor verbatim."
  fi
fi
rm -f "$pidfile" "$statusfile" "$state/queued" "$state/acquired" "$state/lane"
echo "gate exit: $status (log: $log, $(wc -l <"$log") lines)"
echo "--- last 60 lines ---"
tail -60 "$log"
exit $status
