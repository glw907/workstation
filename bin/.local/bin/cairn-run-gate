#!/usr/bin/env bash
# Run a gate command string to completion and print its tail, pacing the wait so an
# implementer never polls a log.
#
# The first call starts the gate detached (keyed by the gate string and the working
# directory) and blocks up to CAIRN_GATE_WAIT seconds (default 540, under the shell
# tool's ten-minute cap). If the gate finishes inside that window, the exit status and
# the last 60 lines print. If not, the call prints "gate still running" and exits 75;
# the caller re-issues the SAME command, which reattaches to the running gate and waits
# again. A finished gate's result is printed once and then cleared, so a later call with
# the same string starts a fresh run.
#
# Vanish: if the tracked pid dies with no status file (an OOM kill outside the scope, a
# signal that raced the writer, or a state directory an older copy of this script left with
# no status at all), the run state clears and the call exits 75 with "gate vanished;
# re-issue starts a fresh run" and prints no "gate exit:" line, so the standing "re-issue on
# 75 until gate exit:" instruction already covers it. A state directory's vanish count bounds
# the loop: the third consecutive vanish prints the terminal "gate exit: 1 (vanished 3
# times)" and exits 1. A gate that itself completes with exit 75 is still distinguishable,
# since only a real completion prints "gate exit:". CAIRN_GATE_POLL_INTERVAL (default 5) and
# CAIRN_GATE_GRACE (default 15) set the wait loop's poll and post-death grace seconds; a test
# shortens both so a staged dead pid resolves in about a second.
#
# Usage: cairn-run-gate '<gate string>' [log path]
#        cairn-run-gate --receipt '<gate string>'
#        cairn-run-gate --records <toplevel> <branch>
# Memory: the gate runs in a transient user scope capped by CAIRN_GATE_MEMORY_HIGH (7G),
# CAIRN_GATE_MEMORY_MAX (8G), and CAIRN_GATE_SWAP_MAX (4G); override per call as needed.
# Lanes: gates queue on one machine-wide lock per lane. The default lane, heavy, is for a
# browser-bearing gate that peaks near the laptop's RAM. CAIRN_GATE_LANE=light is for a gate
# that launches no browser (a Go `make check`, a lint-only run): it queues on its own lock, so
# it never waits behind a browser gate, and it runs under a smaller cap (2G high, 3G max, 1G
# swap) so one light gate beside one heavy gate still fits in RAM. Light gates serialize among
# themselves. CAIRN_GATE_PARALLEL=1 skips every lock and is kept for callers that set it.
# Sleep: the gate runs under `awake`, which holds a sleep inhibitor (who "cairn-gate-<lane>")
# for the gate's own run and releases it when the gate exits; see it in `systemd-inhibit --list`.
# Exit status: the gate's when it has finished; 75 while it is still running.
#
# Receipts (Geoff, 2026-10-08): every run that prints "gate exit:" also writes a receipt, so a
# second party can prove the same gate already ran on the same tree instead of rerunning it. A
# receipt lives in its own state directory (CAIRN_GATE_RECEIPT_DIR, default
# ~/.local/state/cairn-run-gate/receipts), never in the repo, one per repo toplevel, working
# directory, and exact gate string. It records the toplevel, the working directory, HEAD, a
# fingerprint, the gate string as run, the lane, the exit code, a copy of the log ending in the
# "gate exit: N" line, and a timestamp. The fingerprint hashes what the gate reads beyond the
# commit (caching is sound only for hermetic inputs, https://bazel.build/basics/hermeticity):
# the toplevel and working directory, the tree `git write-tree` would produce after `git add -A`
# (tracked and untracked non-ignored content, committed or not, so committing the gated tree keeps
# the match), the package-lock.json and node_modules/.package-lock.json at the root and under
# examples/*/, the realpath of each examples/*/node_modules/@glw907/* link, the effective lane, and the
# environment values of E2E_PORT, CI, and every CAIRN_* name the gate string mentions (an export
# inside the gate string is already part of the string). It is taken when the run starts and
# again when it finishes; a tree that changed in between gets no receipt. The start fingerprint is
# keyed by the run's pid, so a run started by an older copy of this script, which writes none,
# never compares against a stale one and gets no receipt.
#
# Run records: every run also appends one JSON line to ${CAIRN_GATE_RECORDS_DIR:-
# ~/.local/state/cairn-run-gate}/runs.jsonl, under flock on runs.lock in that directory, so a pass
# can score its gate and CI time from one file. A gate line carries kind "gate", gate, tree,
# toplevel, branch, head, lane, start, end (ISO 8601 UTC), lockWaitSeconds (the time the run queued
# on the machine lock), exit, and outcome. The detached run writes the "exit" line after its gate
# command exits and before it writes the status file, so a caller that abandons the run still
# leaves a record and a re-issued call writes none. The caller writes "vanished" when it detects a
# lost run and "receipt" on a receipt hit. A CI wait line (kind "ci", written by ci-green) shares
# the file. A record write is best effort: an unwritable directory, a jq missing from the run's
# PATH, or a lock held past CAIRN_GATE_RECORDS_LOCK_WAIT seconds (default 10) prints one warning
# and never changes the exit, the status, or the receipt.
#
# Summary: `cairn-run-gate --records <toplevel> <branch>` prints one line summing, for that
# toplevel and branch, the gate time of completed runs (end minus start minus lock wait), the lock
# wait, and the CI wait (end minus start of each CI line), and counts any malformed line it skips.
# An absent records file prints zero sums and exits 0.
#
# Lookup: `cairn-run-gate --receipt '<gate string>'` recomputes the fingerprint for the current
# tree and, when the receipt for this exact gate string matches it, recorded exit 0, and its log
# ends in "gate exit: 0", prints "receipt: exit 0 (log: ...) fingerprint ..." and exits 0. Any
# other case prints a line starting "receipt: none" and exits 1: no receipt, another fingerprint,
# or a failing run (a failing receipt never stands in for the gate). Lookup never starts a gate.
set -u
mode=run
if [ "${1:-}" = "--receipt" ]; then
  mode=receipt
  shift
fi
records_dir="${CAIRN_GATE_RECORDS_DIR:-$HOME/.local/state/cairn-run-gate}"

if [ "${1:-}" = "--records" ]; then
  [ $# -eq 3 ] || { echo "usage: cairn-run-gate --records <toplevel> <branch>" >&2; exit 2; }
  command -v jq >/dev/null 2>&1 || { echo "cairn-run-gate: --records needs jq" >&2; exit 2; }
  if [ -f "$records_dir/runs.jsonl" ]; then
    src="$records_dir/runs.jsonl"
  else
    src=/dev/null
  fi
  jq -Rrn --arg top "$2" --arg br "$3" '
    def secs: fromdateiso8601;
    def delta:
      if .kind == "gate" then
        (if .outcome == "exit"
          then {g: ((.end | secs) - (.start | secs) - .lockWaitSeconds), gn: 1, l: .lockWaitSeconds}
          else {} end)
      elif .kind == "ci" then {c: ((.end | secs) - (.start | secs)), cn: 1}
      else {} end;
    reduce (inputs | select(. != "")) as $line ({g: 0, gn: 0, l: 0, c: 0, cn: 0, m: 0};
      (try ($line | fromjson) catch null) as $o
      | if ($o | type) != "object" then .m += 1
        elif $o.toplevel != $top or $o.branch != $br then .
        else
          (try ($o | delta) catch null) as $d
          | if $d == null then .m += 1
            else .g += ($d.g // 0) | .gn += ($d.gn // 0) | .l += ($d.l // 0)
              | .c += ($d.c // 0) | .cn += ($d.cn // 0)
            end
        end)
    | "gate \(.g)s (\(.gn) runs), lock wait \(.l)s, ci wait \(.c)s (\(.cn) waits), malformed \(.m)"
  ' <"$src"
  exit $?
fi
gate="${1:?gate string required}"
receipt_root="${CAIRN_GATE_RECEIPT_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/cairn-run-gate/receipts}"

# Prints the tree fingerprint described above, or nothing outside a git work tree. The tree part
# is commit-invariant: a scratch index copied from the real one (so unchanged files keep their
# stat cache) takes `git add -A` and `git write-tree`, so the same content hashes the same whether
# it is committed, staged, or only on disk. Optional git locks stay off so a fingerprint never
# contends with an agent's own commit for index.lock.
gate_tree() {
  local top idx tree
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  idx=$(mktemp "${TMPDIR:-/tmp}/cairn-gate-index.XXXXXX") || return 0
  cp "$(git -C "$top" rev-parse --path-format=absolute --git-path index 2>/dev/null)" "$idx" 2>/dev/null || rm -f "$idx"
  tree=$(export GIT_OPTIONAL_LOCKS=0 GIT_INDEX_FILE="$idx"
    git -C "$top" add -A >/dev/null 2>&1 && git -C "$top" write-tree 2>/dev/null)
  rm -f "$idx" "$idx.lock"
  printf '%s' "$tree"
}

gate_fingerprint() {
  local cwd="$PWD" top tree
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  tree=$(gate_tree)
  [ -n "$tree" ] || return 0
  (
    printf 'top=%s\ncwd=%s\ntree=%s\n' "$top" "$cwd" "$tree"
    echo '--- lockfiles'
    for f in "$top/package-lock.json" "$top/node_modules/.package-lock.json" \
      "$top"/examples/*/package-lock.json "$top"/examples/*/node_modules/.package-lock.json; do
      [ -f "$f" ] && printf '%s %s\n' "${f#"$top"/}" "$(sha256sum <"$f" | cut -c1-64)"
    done
    # A feature worktree's example can link the engine from another checkout; which one it
    # resolves to is part of what the gate proves.
    echo '--- engine links'
    for f in "$top"/examples/*/node_modules/@glw907/*; do
      [ -e "$f" ] && printf '%s -> %s\n' "${f#"$top"/}" "$(realpath "$f")"
    done
    echo '--- env'
    printf 'lane=%s\n' "${CAIRN_GATE_LANE:-heavy}"
    for v in E2E_PORT CI $(grep -oE 'CAIRN_[A-Za-z0-9_]+' <<<"$gate" | sort -u); do
      if [ -n "${!v+x}" ]; then printf '%s=%s\n' "$v" "${!v}"; else printf '%s unset\n' "$v"; fi
    done
  ) | sha256sum | cut -c1-64
}

# Appends one line to the run records under the records lock. Best effort: any failure prints one
# warning and returns 0, so a record never changes the gate's exit, status, or receipt.
append_record() {
  local line="$1" status
  mkdir -p "$records_dir" 2>/dev/null || { echo "cairn-run-gate: record not written (cannot create $records_dir)" >&2; return 0; }
  ( 2>/dev/null
    flock -w "${CAIRN_GATE_RECORDS_LOCK_WAIT:-10}" 9 || exit 3
    printf '%s\n' "$line" >>"$records_dir/runs.jsonl" || exit 4
  ) 2>/dev/null 9>>"$records_dir/runs.lock"
  status=$?
  case "$status" in
    0) ;;
    3) echo "cairn-run-gate: record not written (the records lock stayed held)" >&2 ;;
    *) echo "cairn-run-gate: record not written (cannot write $records_dir/runs.jsonl)" >&2 ;;
  esac
  return 0
}

# write_gate_record <outcome> <exit code or null> <start epoch> <lock wait seconds> <head> <lane>
write_gate_record() {
  local outcome="$1" code="$2" start_epoch="$3" lock_wait="$4" head="$5" lane="$6" top branch tree line
  command -v jq >/dev/null 2>&1 || { echo "cairn-run-gate: record not written (jq not found on PATH)" >&2; return 0; }
  top=$(git rev-parse --show-toplevel 2>/dev/null) || top=""
  branch=$(git branch --show-current 2>/dev/null) || branch=""
  tree=$(gate_tree)
  line=$(jq -nc --arg gate "$gate" --arg tree "$tree" --arg top "$top" --arg branch "$branch" \
    --arg head "$head" --arg lane "$lane" --arg outcome "$outcome" \
    --arg start "$(date -u -d "@$start_epoch" +%FT%TZ 2>/dev/null)" --arg end "$(date -u +%FT%TZ)" \
    --argjson wait "${lock_wait:-0}" --argjson code "$code" \
    '{kind: "gate", gate: $gate, tree: $tree, toplevel: $top, branch: $branch, head: $head, lane: $lane,
      start: $start, end: $end, lockWaitSeconds: $wait, exit: $code, outcome: $outcome}' 2>/dev/null) \
    || { echo "cairn-run-gate: record not written (jq failed)" >&2; return 0; }
  append_record "$line"
}

# The receipt directory for this toplevel, working directory, and exact gate string.
receipt_dir() {
  printf '%s/%s' "$receipt_root" "$(printf '%s\n%s\n%s' "$1" "$PWD" "$gate" | sha256sum | cut -c1-32)"
}

if [ "$mode" = receipt ]; then
  top=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "receipt: none (not inside a git work tree)"; exit 1; }
  rdir=$(receipt_dir "$top")
  if [ ! -f "$rdir/receipt" ] || ! printf '%s' "$gate" | cmp -s - "$rdir/gate" 2>/dev/null; then
    echo "receipt: none"
    exit 1
  fi
  fp=$(gate_fingerprint)
  rfp=$(sed -n 's/^fingerprint=//p' "$rdir/receipt")
  rexit=$(sed -n 's/^exit=//p' "$rdir/receipt")
  if [ -z "$fp" ] || [ "$fp" != "$rfp" ]; then
    echo "receipt: none (the tree or environment differs from the last recorded run)"
    exit 1
  fi
  if [ "$rexit" != "0" ] || [ "$(tail -n 1 "$rdir/log" 2>/dev/null)" != "gate exit: 0" ]; then
    echo "receipt: none (the last run on this tree exited ${rexit:-unknown}; only a pass stands in for the gate)"
    exit 1
  fi
  now=$(date +%s)
  write_gate_record receipt 0 "$now" 0 "$(git rev-parse HEAD 2>/dev/null || echo none)" "${CAIRN_GATE_LANE:-heavy}"
  echo "receipt: exit 0 (log: $rdir/log) fingerprint $fp head $(sed -n 's/^head=//p' "$rdir/receipt") recorded $(sed -n 's/^timestamp=//p' "$rdir/receipt")"
  exit 0
fi

wait_s="${CAIRN_GATE_WAIT:-540}"
poll_s="${CAIRN_GATE_POLL_INTERVAL:-5}"
grace_s="${CAIRN_GATE_GRACE:-15}"
key=$(printf '%s\n%s' "$PWD" "$gate" | sha256sum | cut -c1-16)
gatedir="${TMPDIR:-/tmp}/cairn-gate-$(id -u)"
state="$gatedir/$key"
mkdir -p "$state"
log="${2:-$state/gate.log}"
pidfile="$state/pid"
statusfile="$state/status"
vanishfile="$state/vanished"

if [ ! -e "$pidfile" ]; then
  rm -f "$statusfile"
  : >"$log"
  # Run the gate in its own transient cgroup with a memory ceiling, so a runaway headless
  # browser is throttled and then killed inside the gate instead of driving system-wide
  # pressure that systemd-oomd resolves by killing the desktop session (two concurrent
  # gates cost the GNOME session on 2026-09-14). Empty prefix where systemd-run is absent.
  lane="${CAIRN_GATE_LANE:-heavy}"
  case "$lane" in
    heavy) mem_high=7G mem_max=8G swap_max=4G ;;
    light) mem_high=2G mem_max=3G swap_max=1G ;;
    *) echo "cairn-run-gate: unknown CAIRN_GATE_LANE '$lane' (heavy or light)" >&2; rm -rf "$state"; exit 2 ;;
  esac
  scope=()
  if command -v systemd-run >/dev/null 2>&1; then
    scope=(systemd-run --user --scope -q
      -p "MemoryHigh=${CAIRN_GATE_MEMORY_HIGH:-$mem_high}"
      -p "MemoryMax=${CAIRN_GATE_MEMORY_MAX:-$mem_max}"
      -p "MemorySwapMax=${CAIRN_GATE_SWAP_MAX:-$swap_max}")
  fi
  # One gate per machine at a time: a browser-bearing gate peaks near the laptop's RAM, so
  # concurrent gates from parallel chains queue on a shared lock instead of running side
  # by side. A browserless gate takes the light lane instead of waiting behind a browser.
  # The heavy lane keeps the original lock file name, so a gate started by an older copy of
  # this script and one started by this copy still exclude each other.
  if [ "${CAIRN_GATE_PARALLEL:-0}" = "1" ]; then
    lock=()
  elif [ "$lane" = "light" ]; then
    lock=(flock "$gatedir/machine-light.lock")
  else
    lock=(flock "$gatedir/machine.lock")
  fi
  # Hold the laptop awake for exactly as long as the gate itself runs (inside the lock and
  # the scope, so a queued gate holds nothing). A suspend mid-gate froze an overnight gate on
  # 2026-09-23. awake never fails the command; empty prefix where it is absent.
  keep_awake=()
  if command -v awake >/dev/null 2>&1; then
    keep_awake=(awake --who "cairn-gate-$lane" --why "cairn-run-gate in ${PWD##*/}: ${gate:0:80}" --)
  fi
  # Stamp when the run was queued and when it got the lock, so the result can say how long the
  # gate waited on another gate. The stamp runs inside the lock, before the gate itself.
  date +%s >"$state/queued"
  echo "$lane" >"$state/lane"
  # The receipt's start fingerprint and HEAD; the fingerprint is written with the run's pid below.
  rm -f "$state/fingerprint" "$state/record-warning"
  start_fp=$(gate_fingerprint)
  git rev-parse HEAD >"$state/head" 2>/dev/null || echo none >"$state/head"
  # The exit record is written here, after the gate exits and before the status file: the caller
  # deletes the run's state once the status appears, and may have gone away entirely. Its warning
  # lands in a file the caller prints, since this process outlives the call that started it.
  ( "${lock[@]}" "${scope[@]}" "${keep_awake[@]}" bash -c 'date +%s >"$1"; exec bash -c "$2"' _ "$state/acquired" "$gate" >"$log" 2>&1
    rc=$?
    queued_at=$(cat "$state/queued" 2>/dev/null || date +%s)
    acquired_at=$(cat "$state/acquired" 2>/dev/null || echo "$queued_at")
    write_gate_record exit "$rc" "$queued_at" "$((acquired_at - queued_at))" "$(cat "$state/head" 2>/dev/null)" "$lane" 2>>"$state/record-warning"
    echo "$rc" >"$statusfile" ) </dev/null &
  echo $! >"$pidfile"
  [ -n "$start_fp" ] && printf '%s %s\n' "$!" "$start_fp" >"$state/fingerprint"
  echo "gate started (log: $log)"
fi

# Writes this run's receipt (see the header) when its start fingerprint still matches the tree.
# Never fails the call: a receipt is an optimization, so any error just leaves none.
write_receipt() {
  local status_code="$1" start_pid start_fp end_fp top rdir
  [ -f "$state/fingerprint" ] && read -r start_pid start_fp <"$state/fingerprint" || return 0
  [ -n "$start_fp" ] && [ "$start_pid" = "$pid" ] || return 0
  end_fp=$(gate_fingerprint)
  [ "$start_fp" = "$end_fp" ] || return 0
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  rdir=$(receipt_dir "$top")
  mkdir -p "$rdir" 2>/dev/null || return 0
  { cat "$log" 2>/dev/null; echo "gate exit: $status_code"; } >"$rdir/log.tmp" && mv -f "$rdir/log.tmp" "$rdir/log"
  printf '%s' "$gate" >"$rdir/gate.tmp" && mv -f "$rdir/gate.tmp" "$rdir/gate"
  {
    echo "top=$top"
    echo "cwd=$PWD"
    echo "head=$(cat "$state/head" 2>/dev/null)"
    echo "fingerprint=$end_fp"
    echo "lane=$(cat "$state/lane" 2>/dev/null)"
    echo "exit=$status_code"
    echo "log=$rdir/log"
    echo "source_log=$log"
    echo "timestamp=$(date -u +%FT%TZ)"
  } >"$rdir/receipt.tmp" && mv -f "$rdir/receipt.tmp" "$rdir/receipt"
  find "$receipt_root" -mindepth 1 -maxdepth 1 -type d -mtime +14 -exec rm -rf {} + 2>/dev/null
  return 0
}

pid=$(cat "$pidfile")
waited=0
while [ ! -e "$statusfile" ] && [ "$waited" -lt "$wait_s" ]; do
  sleep "$poll_s"
  waited=$((waited + poll_s))
  if ! kill -0 "$pid" 2>/dev/null && [ ! -e "$statusfile" ]; then
    # The status file can land a few seconds after the recorded pid exits (the scope and flock
    # layers finish after it), so allow a grace period before calling the gate lost.
    grace=0
    while [ ! -e "$statusfile" ] && [ "$grace" -lt "$grace_s" ]; do
      sleep 1
      grace=$((grace + 1))
    done
    break
  fi
done

if [ ! -e "$statusfile" ]; then
  if kill -0 "$pid" 2>/dev/null; then
    echo "gate still running after ${waited}s more (log: $log, $(wc -l <"$log") lines so far)."
    echo "Re-run this exact cairn-run-gate command to keep waiting; do not tail, wc, ps, or sleep on the log."
    exit 75
  fi
  # The recorded pid died and no status file ever appeared (an OOM kill outside the scope, a
  # signal that raced the writer, or a state directory an older cairn-run-gate left with no
  # status at all). Clear the run state so a re-issued command starts a fresh gate instead of
  # reattaching to a dead pid, and count consecutive vanishes so a gate command that always
  # vanishes still terminates instead of looping forever.
  vanish_count=$(( $(cat "$vanishfile" 2>/dev/null || echo 0) + 1 ))
  [ "$vanish_count" -ge 3 ] && write_receipt 1
  queued_at=$(cat "$state/queued" 2>/dev/null || date +%s)
  acquired_at=$(cat "$state/acquired" 2>/dev/null || echo "$queued_at")
  write_gate_record vanished null "$queued_at" "$((acquired_at - queued_at))" "$(cat "$state/head" 2>/dev/null || git rev-parse HEAD 2>/dev/null || echo none)" "$(cat "$state/lane" 2>/dev/null || echo "${CAIRN_GATE_LANE:-heavy}")"
  rm -f "$pidfile" "$statusfile" "$state/queued" "$state/acquired" "$state/lane" "$state/fingerprint" "$state/head" "$state/record-warning"
  if [ "$vanish_count" -ge 3 ]; then
    rm -f "$vanishfile"
    echo "gate exit: 1 (vanished 3 times)"
    exit 1
  fi
  echo "$vanish_count" >"$vanishfile"
  echo "gate vanished; re-issue starts a fresh run"
  exit 75
else
  status=$(cat "$statusfile")
fi
rm -f "$vanishfile"

# Tell whoever ran this gate when it lost real time to the queue. The rule that a browserless
# gate belongs on the light lane is easy to not know; the wait is where it costs, so say it here.
hint_after="${CAIRN_GATE_HINT_AFTER:-120}"
if [ -e "$state/queued" ] && [ -e "$state/acquired" ]; then
  lock_wait=$(( $(cat "$state/acquired") - $(cat "$state/queued") ))
  if [ "$lock_wait" -ge "$hint_after" ] && [ "$(cat "$state/lane" 2>/dev/null)" = "heavy" ]; then
    echo "NOTE: this gate waited ${lock_wait}s for another gate to release the machine lock."
    echo "NOTE: if it launches no browser (a Go make check, a lint-only run), run it as"
    echo "NOTE:   CAIRN_GATE_LANE=light cairn-run-gate '<gate string>'"
    echo "NOTE: which has its own lock. Report this NOTE to your conductor verbatim."
  fi
fi
write_receipt "$status"
[ -s "$state/record-warning" ] && cat "$state/record-warning" >&2
rm -f "$pidfile" "$statusfile" "$state/queued" "$state/acquired" "$state/lane" "$state/fingerprint" "$state/head" "$state/record-warning"
echo "gate exit: $status (log: $log, $(wc -l <"$log") lines)"
echo "--- last 60 lines ---"
tail -60 "$log"
exit $status
