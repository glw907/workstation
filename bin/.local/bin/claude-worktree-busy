#!/usr/bin/env -S python3 -I
"""Report whether a worktree path is in use: exit 0 and print nothing when free, exit 1 with one line when busy.

Three checks run in order: a process whose command line holds the path, a `claude agents --json` row whose
cwd is the path or under it, and an uncommitted file edited in the last 60 minutes.
"""

import json
import os
import re
import subprocess
import sys
import time

RECENT_SECONDS = 60 * 60


def ancestors():
    """Return the pids of this process and every ancestor."""
    pids = set()
    pid = os.getpid()
    while pid > 0:
        pids.add(pid)
        with open(f"/proc/{pid}/stat") as f:
            stat = f.read()
        pid = int(stat.rsplit(")", 1)[1].split()[1])
    return pids


def process_hit(path):
    """Return a message naming a process whose command line holds the path, or None."""
    skip = ancestors()
    # The path must start and end where an argument or path component does, so /x/a-3 never matches
    # /x/a-30 or /y/x/a-3.
    held = re.compile(r"(?<![^\0\s=:'\"])" + re.escape(path) + r"(?![\w.-])")
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) in skip:
            continue
        try:
            with open(f"/proc/{entry}/cmdline", "rb") as f:
                cmdline = f.read().decode(errors="replace")
        except OSError:
            continue
        if held.search(cmdline):
            return f"busy: process {entry} has the path in its command line"
    return None


def under(cwd, path):
    """Report whether cwd is the path or a directory under it, by whole components."""
    return cwd == path or cwd.startswith(path.rstrip("/") + "/")


def session_hit(path):
    """Return a message naming a claude session whose cwd is in the path, or None; skips with a note on stderr."""
    try:
        out = subprocess.run(["claude", "agents", "--json"], capture_output=True, text=True, check=True).stdout
        rows = json.loads(out)
    except (OSError, subprocess.CalledProcessError, ValueError):
        print("claude-worktree-busy: skipping the claude agents check (claude absent or output unreadable)", file=sys.stderr)
        return None
    for row in rows:
        cwd = row.get("cwd") or ""
        if cwd and under(os.path.realpath(cwd), path):
            return f"busy: claude session {row.get('id')} has its cwd in the path"
    return None


def edit_hit(path):
    """Return a message naming an uncommitted file edited in the last hour, or None; None for a non-git directory."""
    proc = subprocess.run(
        ["git", "-C", path, "status", "--porcelain", "-z", "-uall"], capture_output=True, text=True
    )
    if proc.returncode != 0:
        return None
    now = time.time()
    fields = iter(proc.stdout.split("\0"))
    for entry in fields:
        name = entry[3:]
        if entry[:1] in ("R", "C"):
            next(fields, None)  # a rename or copy carries its old path as a bare next field
        try:
            age = now - os.stat(os.path.join(path, name)).st_mtime
        except OSError:
            continue
        if entry and age < RECENT_SECONDS:
            return f"busy: uncommitted file {name} edited in the last 60 minutes"
    return None


def main():
    """Run the checks on the path argument and exit with the verdict."""
    if len(sys.argv) != 2 or not os.path.isdir(sys.argv[1]):
        print("usage: claude-worktree-busy <directory>", file=sys.stderr)
        return 2
    path = os.path.realpath(sys.argv[1])
    for check in (process_hit, session_hit, edit_hit):
        message = check(path)
        if message:
            print(message)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
