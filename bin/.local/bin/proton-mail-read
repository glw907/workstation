#!/usr/bin/env -S python3 -I
"""Read the Services folder of Geoff's Proton mailbox through Proton Mail Bridge, read-only.

The folder is opened with EXAMINE and every fetch is BODY.PEEK, so no message is marked seen.
Nothing here moves, deletes, flags, or sends mail, and any folder but Folders/Services is refused.
"""

import argparse
import email
import email.policy
import hashlib
import hmac
import imaplib
import os
import re
import shlex
import socket
import ssl
import stat
import sys
from datetime import datetime
from html.parser import HTMLParser
from pathlib import Path

FOLDER = "Folders/Services"
HOST = "127.0.0.1"  # never configurable: the password must not leave loopback
DEFAULT_PORT = 1143  # Bridge's default IMAP port; `info` in the Bridge CLI shows the real one.
LIST_FIELDS = "(BODY.PEEK[HEADER.FIELDS (DATE FROM SUBJECT)])"
MONTHS = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")


class ReadError(Exception):
    """A failure the user can act on; main prints it and exits non-zero."""


def read_secret_file(path):
    """Return the NAME=value pairs of an `export NAME=value` file, or nothing when it is unusable.

    A file that is not a regular file owned by the caller, or that group or others can write, is
    skipped, so a planted overlay cannot supply credentials.
    """
    pairs = {}
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
            return pairs
        lines = Path(path).read_text().splitlines()
    except (OSError, UnicodeDecodeError):
        return pairs
    for line in lines:
        name, sep, value = line.removeprefix("export ").partition("=")
        if sep and re.fullmatch(r"[A-Z_][A-Z0-9_]*", name):
            try:
                words = shlex.split(value)
            except ValueError:
                continue
            if len(words) == 1:
                pairs[name] = words[0]
    return pairs


def credentials():
    """Return the Bridge username and password from the workstation secrets files."""
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    main = os.environ.get("PROTON_MAIL_READ_SECRETS", str(Path.home() / ".local/secrets"))
    found = {}
    # A pass that has not merged yet keeps its names in an overlay; the main file wins a clash.
    for overlay in sorted(Path(runtime, "self-hosting").glob("secrets-*")) if runtime else []:
        found.update(read_secret_file(overlay))
    found.update(read_secret_file(main))
    missing = [n for n in ("PROTON_BRIDGE_USER", "PROTON_BRIDGE_PASSWORD") if not found.get(n)]
    if missing:
        raise ReadError(f"{', '.join(missing)} not found in {main}; store it with secret-receive")
    return found["PROTON_BRIDGE_USER"], found["PROTON_BRIDGE_PASSWORD"]


def check_folder(name):
    """Refuse every folder but the Services folder, before any connection is made."""
    if name != FOLDER:
        raise ReadError(f"refused: only {FOLDER} may be read, not {name!r}")


def bridge_port():
    """Return the Bridge IMAP port, from PROTON_MAIL_READ_PORT when set."""
    raw = os.environ.get("PROTON_MAIL_READ_PORT", str(DEFAULT_PORT))
    if not raw.isdigit() or not 1024 <= int(raw) <= 65535:
        raise ReadError(f"PROTON_MAIL_READ_PORT must be a port from 1024 to 65535, not {raw!r}")
    return int(raw)


def check_pin(conn):
    """Compare Bridge's certificate with the pinned fingerprint, pinning it on first use.

    Bridge's certificate is self-signed, so the pin is what tells the real Bridge from any other
    process that took the port while Bridge was down. A mismatch refuses before login.
    """
    pin_file = Path(os.environ.get("PROTON_MAIL_READ_PIN", str(Path.home() / ".local/state/proton-mail-read/bridge-cert.sha256")))
    seen = hashlib.sha256(conn.sock.getpeercert(binary_form=True)).hexdigest()
    try:
        pinned = pin_file.read_text().strip()
    except OSError:
        pin_file.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        pin_file.write_text(seen + "\n")
        pin_file.chmod(0o600)
        return
    if not hmac.compare_digest(pinned.encode(), seen.encode()):
        raise ReadError(f"the certificate on this port is not the one pinned in {pin_file}; "
                        "if Bridge was reinstalled, delete that file and run again")


def connect(user, password):
    """Return a logged-in, read-only connection to Bridge on loopback.

    STARTTLS is required, because the password must never cross a connection that may not be
    Bridge.
    """
    port = bridge_port()
    try:
        conn = imaplib.IMAP4(HOST, port, timeout=15)
    except OSError:
        raise ReadError(
            f"Proton Bridge is not listening on {HOST}:{port}; "
            "start it with `systemctl --user start proton-bridge.service`"
        ) from None
    try:
        if "STARTTLS" not in " ".join(conn.capabilities):
            raise ReadError(f"the service on {HOST}:{port} offers no STARTTLS, so it is not Bridge")
        context = ssl.create_default_context()
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
        conn.starttls(context)
        check_pin(conn)
        conn.login(user, password)
        # readonly=True makes imaplib send EXAMINE, which cannot set any flag.
        status, _ = conn.select(f'"{FOLDER}"', readonly=True)
        if status != "OK":
            raise ReadError(f"Bridge would not open {FOLDER}; has the Sieve filter created it?")
    except BaseException:
        conn.shutdown()
        raise
    return conn


def quote(text):
    """Return text as an IMAP quoted string, rejecting anything that could end the command."""
    if not text.isascii() or re.search(r"[\x00-\x1f\x7f]", text):
        raise ReadError("search text must be printable ASCII on one line")
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def imap_date(text):
    """Convert YYYY-MM-DD to the DD-Mon-YYYY form IMAP SEARCH takes."""
    try:
        day = datetime.strptime(text, "%Y-%m-%d")
    except ValueError:
        raise ReadError(f"--since wants YYYY-MM-DD, not {text!r}") from None
    return f"{day.day:02d}-{MONTHS[day.month - 1]}-{day.year}"


def search_uids(conn, criteria):
    """Return the UIDs that match, oldest first."""
    status, data = conn.uid("SEARCH", *criteria)
    if status != "OK":
        raise ReadError("search failed")
    return [int(u) for u in data[0].split()]


def clean(text):
    """Collapse whitespace and drop control characters so a header prints on one line."""
    return re.sub(r"\s+", " ", UNSAFE.sub(" ", str(text or ""))).strip()


def summaries(conn, uids):
    """Return (uid, date, sender, subject) for each UID, via a peeked header fetch."""
    if not uids:
        return []
    status, data = conn.uid("FETCH", ",".join(map(str, uids)), LIST_FIELDS)
    if status != "OK":
        raise ReadError("fetch failed")
    rows = []
    for i, item in enumerate(data):
        if not isinstance(item, tuple):
            continue
        # Bridge sends UID after the header literal, so it lands in the bytes item that follows the tuple.
        trailer = data[i + 1] if i + 1 < len(data) and isinstance(data[i + 1], bytes) else b""
        uid = re.search(rb"UID (\d+)", item[0]) or re.search(rb"UID (\d+)", trailer)
        if uid is None:
            raise ReadError("fetch response carried no UID")
        headers = email.message_from_bytes(item[1], policy=email.policy.default)
        rows.append((int(uid.group(1)), clean(headers["Date"]), clean(headers["From"]), clean(headers["Subject"])))
    return sorted(rows)


def print_rows(rows):
    for uid, date, sender, subject in rows:
        print(f"{uid}\t{date}\t{sender}\t{subject}")


class TextExtractor(HTMLParser):
    """Collect the visible text of an HTML part, skipping script and style."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.parts = []
        self.skip = 0

    def handle_starttag(self, tag, attrs):
        if tag in ("script", "style"):
            self.skip += 1
        elif tag in ("br", "p", "div", "tr", "li", "h1", "h2", "h3"):
            self.parts.append("\n")

    def handle_endtag(self, tag):
        if tag in ("script", "style") and self.skip:
            self.skip -= 1

    def handle_data(self, data):
        if not self.skip:
            self.parts.append(data)


def html_to_text(html):
    parser = TextExtractor()
    parser.feed(html)
    text = "".join(parser.parts)
    return re.sub(r"\n{3,}", "\n\n", re.sub(r"[ \t]+", " ", text)).strip()


UNSAFE = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u200b-\u200f\u202a-\u202e\u2028\u2029\u2060-\u2064\u2066-\u2069\u061c\ufeff]")


def message_text(msg):
    """Return the text/plain body, or the HTML body reduced to text when that is all there is."""
    body = msg.get_body(preferencelist=("plain", "html"))
    if body is None:
        return "(no text part)"
    try:
        content = body.get_content()
    except LookupError:
        content = body.get_payload(decode=True).decode("utf-8", "replace")
    text = html_to_text(content) if body.get_content_type() == "text/html" else content.strip()
    # Escape sequences and bidi controls in a body would reach the terminal and the agent as-is.
    return UNSAFE.sub(" ", text)


def cmd_list(conn, args):
    criteria = ["SINCE", imap_date(args.since)] if args.since else ["ALL"]
    uids = search_uids(conn, criteria)[-args.limit:]
    print_rows(summaries(conn, uids))


def cmd_search(conn, args):
    if args.sender:
        criteria = ["FROM", quote(args.sender)]
    else:
        criteria = ["SUBJECT", quote(args.subject)]
    print_rows(summaries(conn, search_uids(conn, criteria)))


def cmd_read(conn, args):
    status, data = conn.uid("FETCH", str(args.uid), "(BODY.PEEK[])")
    raw = next((item[1] for item in data if isinstance(item, tuple)), None)
    if status != "OK" or raw is None:
        raise ReadError(f"no message with UID {args.uid}")
    msg = email.message_from_bytes(raw, policy=email.policy.default)
    for name in ("Date", "From", "To", "Cc", "Subject"):
        if msg[name]:
            print(f"{name}: {clean(msg[name])}")
    print()
    print(message_text(msg))


def parser():
    top = argparse.ArgumentParser(prog="proton-mail-read", description=__doc__.splitlines()[0])
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--folder", default=FOLDER, help=f"only {FOLDER} is accepted")
    sub = top.add_subparsers(dest="command", required=True)
    ls = sub.add_parser("list", parents=[common], help="list messages, newest last")
    ls.add_argument("--since", metavar="YYYY-MM-DD")
    ls.add_argument("--limit", type=int, default=20, metavar="N")
    ls.set_defaults(run=cmd_list)
    se = sub.add_parser("search", parents=[common], help="find messages by sender or subject")
    group = se.add_mutually_exclusive_group(required=True)
    group.add_argument("--from", dest="sender", metavar="TEXT")
    group.add_argument("--subject", metavar="TEXT")
    se.set_defaults(run=cmd_search)
    rd = sub.add_parser("read", parents=[common], help="print one message's headers and text")
    rd.add_argument("uid", type=int)
    rd.set_defaults(run=cmd_read)
    return top


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        check_folder(args.folder)
        if getattr(args, "limit", 1) < 1:
            raise ReadError("--limit must be at least 1")
        if getattr(args, "since", None):
            imap_date(args.since)
        if args.command == "search":
            quote(args.sender or args.subject)
        user, password = credentials()
        conn = connect(user, password)
        try:
            args.run(conn, args)
        finally:
            conn.logout()
    except ReadError as err:
        print(f"proton-mail-read: {err}", file=sys.stderr)
        return 2
    except imaplib.IMAP4.error:
        print("proton-mail-read: Bridge refused the request", file=sys.stderr)
        return 2
    except (OSError, ssl.SSLError, ValueError):
        print("proton-mail-read: the connection to Bridge failed", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
