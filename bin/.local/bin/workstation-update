#!/usr/bin/env bash
set -euo pipefail

# Workstation maintenance: update tools outside the ujust update flow
# Usage: workstation-update
#
# `ujust update` handles the system image, Flatpaks, and Homebrew together
# (including Go, which is brewed) and is the preferred path for that tier;
# run it separately, interactively, since it can prompt for a reboot.
#
# This script covers what ujust update does not: mise-managed runtimes, uv
# tool installs, kitty (deliberately upstream-installed as a test harness,
# never brewed or flatpaked), the Android SDK, and the Thunderbird GNOME
# theme (thunderbird-theme-sync; quit Thunderbird first).
#
# Run manually; nothing schedules it. After a brew Go bump, poplar's go.mod
# toolchain pin is a deliberate per-repo commit, not this script's job.

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

ERRORS=()

section() {
    echo ""
    echo -e "${BOLD}━━━ $1 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# ── kitty ──────────────────────────────────────────────────────────────────

section "kitty"
if command -v update-kitty &>/dev/null; then
    if ! update-kitty; then
        echo -e "${RED}✗ update-kitty failed${NC}"
        ERRORS+=("kitty")
    fi
else
    echo -e "${YELLOW}⚠ update-kitty not on PATH, skipping${NC}"
fi

# ── mise ───────────────────────────────────────────────────────────────────

section "mise"
if command -v mise &>/dev/null; then
    if mise upgrade; then
        echo -e "${GREEN}✓ mise-managed runtimes updated${NC}"
    else
        echo -e "${RED}✗ mise upgrade failed${NC}"
        ERRORS+=("mise")
    fi
else
    echo -e "${YELLOW}⚠ mise not on PATH, skipping${NC}"
fi

# ── uv tools ───────────────────────────────────────────────────────────────

section "uv tools"
if command -v uv &>/dev/null; then
    if uv tool upgrade --all; then
        echo -e "${GREEN}✓ uv-managed tools updated${NC}"
    else
        echo -e "${RED}✗ uv tool upgrade failed${NC}"
        ERRORS+=("uv")
    fi
else
    echo -e "${YELLOW}⚠ uv not on PATH, skipping${NC}"
fi

# ── Android SDK ─────────────────────────────────────────────────────────────

section "Android SDK"
if [[ -n "${ANDROID_HOME:-}" ]] && command -v sdkmanager &>/dev/null; then
    if sdkmanager --update; then
        echo -e "${GREEN}✓ Android SDK updated${NC}"
    else
        echo -e "${YELLOW}⚠ sdkmanager exited with warnings (usually normal)${NC}"
    fi
else
    echo -e "${YELLOW}⚠ ANDROID_HOME not set or sdkmanager not found, skipping${NC}"
fi

# ── Thunderbird theme ────────────────────────────────────────────────────────

section "Thunderbird theme"
if command -v thunderbird-theme-sync &>/dev/null; then
    if ! thunderbird-theme-sync; then
        echo -e "${RED}✗ thunderbird-theme-sync failed (is Thunderbird open?)${NC}"
        ERRORS+=("thunderbird-theme")
    fi
else
    echo -e "${YELLOW}⚠ thunderbird-theme-sync not on PATH, skipping${NC}"
fi

# ── Summary ──────────────────────────────────────────────────────────────────

section "Done"
if [[ ${#ERRORS[@]} -eq 0 ]]; then
    echo -e "${GREEN}✓ All updates completed — run 'ujust update' separately for the system image, Flatpaks, and Homebrew${NC}"
    echo -e "Then: ${BOLD}check-drift${NC} to reconcile the manifests against the live system"
else
    echo -e "${RED}✗ Errors in: ${ERRORS[*]}${NC}"
    exit 1
fi
