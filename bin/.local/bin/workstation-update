#!/usr/bin/env bash
set -euo pipefail

# Workstation maintenance: update tools outside the ujust update flow
# Usage: workstation-update
#
# uupd handles the system image, Flatpaks, and Homebrew (including Go, which
# is brewed) on its own timer; `ujust update` runs the same tier by hand.
#
# This script covers what ujust update does not: mise-managed runtimes, uv
# tool installs, kitty (deliberately upstream-installed as a test harness,
# never brewed or flatpaked), the Android SDK.
#
# workstation-sync runs this daily. After a brew Go bump, poplar's go.mod
# toolchain pin is a deliberate per-repo commit, not this script's job.

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

ERRORS=()

section() {
    echo ""
    echo -e "${BOLD}━━━ $1 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# ── Claude Code ────────────────────────────────────────────────────────────

# A Homebrew install never updates itself, and uupd skips brew when its hardware check fails.
section "Claude Code"
if brew upgrade --cask claude-code@latest; then
    echo -e "${GREEN}✓ Claude Code current${NC}"
else
    echo -e "${RED}✗ Claude Code upgrade failed${NC}"
    ERRORS+=("claude-code")
fi

# ── kitty ──────────────────────────────────────────────────────────────────

section "kitty"
if command -v update-kitty &>/dev/null; then
    if ! update-kitty; then
        echo -e "${RED}✗ update-kitty failed${NC}"
        ERRORS+=("kitty")
    fi
else
    echo -e "${YELLOW}⚠ update-kitty not on PATH, skipping${NC}"
fi

# ── mise ───────────────────────────────────────────────────────────────────

section "mise"
if command -v mise &>/dev/null; then
    if mise upgrade; then
        echo -e "${GREEN}✓ mise-managed runtimes updated${NC}"
    else
        echo -e "${RED}✗ mise upgrade failed${NC}"
        ERRORS+=("mise")
    fi
else
    echo -e "${YELLOW}⚠ mise not on PATH, skipping${NC}"
fi

# ── uv tools ───────────────────────────────────────────────────────────────

section "uv tools"
if command -v uv &>/dev/null; then
    if uv tool upgrade --all; then
        echo -e "${GREEN}✓ uv-managed tools updated${NC}"
    else
        echo -e "${RED}✗ uv tool upgrade failed${NC}"
        ERRORS+=("uv")
    fi
else
    echo -e "${YELLOW}⚠ uv not on PATH, skipping${NC}"
fi

# ── Android SDK ─────────────────────────────────────────────────────────────

section "Android SDK"
if [[ -n "${ANDROID_HOME:-}" ]] && command -v sdkmanager &>/dev/null; then
    if sdkmanager --update; then
        echo -e "${GREEN}✓ Android SDK updated${NC}"
    else
        echo -e "${YELLOW}⚠ sdkmanager exited with warnings (usually normal)${NC}"
    fi
else
    echo -e "${YELLOW}⚠ ANDROID_HOME not set or sdkmanager not found, skipping${NC}"
fi

# ── Summary ──────────────────────────────────────────────────────────────────

section "Done"
if [[ ${#ERRORS[@]} -eq 0 ]]; then
    echo -e "${GREEN}✓ All updates completed${NC}"
    else
    echo -e "${RED}✗ Errors in: ${ERRORS[*]}${NC}"
    exit 1
fi
