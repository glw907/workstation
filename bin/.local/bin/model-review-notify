#!/usr/bin/env bash
set -uo pipefail

# model-review-notify: timer-facing launcher for the monthly Claude model,
# effort, and skill review. Runs Anthropic's prompt audit on the workstation and
# on the standards plugin, then an unattended review session in a fresh
# worktree, driven by /goal from docs/model-review/prompt.txt.
# --dry-run skips the pull and tells the session to commit locally and stop:
# no push, no PR, no notification. Logs to the journal.
#
# Only pavilion runs the review. A run that cannot pull, or that finds the
# month's branch on origin, stops before any session starts.
# MODEL_REVIEW_PULL_DELAY sets the seconds between pull retries (default 60).

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/home/linuxbrew/.linuxbrew/bin:/usr/bin:$PATH"

dry_run=0
[[ "${1:-}" == "--dry-run" ]] && dry_run=1

repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)
report=$(mktemp /tmp/model-review-audit.XXXXXX)
report_standards=$(mktemp /tmp/model-review-audit-standards.XXXXXX)
trap 'rm -f "$report" "$report_standards"' EXIT

# The standards checkout sits on a feature branch, so it is never pulled. A
# detached worktree of it moves to origin/main each run and carries the plugin
# audit. MODEL_REVIEW_STANDARDS_REPO points a test elsewhere.
standards_repo="${MODEL_REVIEW_STANDARDS_REPO:-$HOME/Projects/standards}"
standards_wt="$standards_repo/.claude/worktrees/model-review-audit"

# audit_standards writes the plugin audit to $report_standards. It returns
# non-zero when the plugin cannot be fetched, checked out, or audited.
audit_standards() {
    git -C "$standards_repo" fetch origin || { echo "standards fetch failed"; return 1; }
    if [[ -d "$standards_wt" ]]; then
        git -C "$standards_wt" checkout --detach origin/main || return 1
    else
        git -C "$standards_repo" worktree add --detach "$standards_wt" origin/main || return 1
    fi
    (cd "$standards_wt" && claude -p --model opus --effort medium \
        "/doctor prompt-audit plugins/standards") > "$report_standards"
}

if (( ! dry_run )) && [[ "$(hostname -s)" != pavilion ]]; then
    echo "not pavilion: the monthly review runs there only"
    exit 0
fi

# worktree.baseRef is "head", and the session cannot pull the main checkout
# after its own self-merge, so the pull happens here. A stale tree would spend
# a full review on old rules, so a pull that keeps failing ends the run.
if (( ! dry_run )); then
    pulled=0
    for try in 1 2 3 4 5; do
        if git -C "$repo" pull --ff-only; then
            pulled=1
            break
        fi
        echo "pull failed (try $try of 5)"
        (( try < 5 )) && sleep "${MODEL_REVIEW_PULL_DELAY:-60}"
    done
    if (( ! pulled )); then
        notify-send -u normal "Model review: pull failed" \
            "Rerun with: systemctl --user start model-review.service"
        exit 1
    fi
    # ls-remote --exit-code answers 0 for a found ref and 2 for none. Any other
    # code is a transport or auth error, and guessing "absent" would start a
    # duplicate review.
    git -C "$repo" ls-remote --exit-code origin \
        "refs/heads/worktree-model-review-$(date +%Y-%m)" > /dev/null
    case $? in
        0)
            echo "this month's review branch is already on origin; nothing to do"
            exit 0
            ;;
        2) ;;
        *)
            echo "could not check origin for this month's review branch"
            notify-send -u normal "Model review: branch check failed" \
                "Rerun with: systemctl --user start model-review.service"
            exit 1
            ;;
    esac
fi

cd "$repo" || exit 1
echo "monthly model review starting from $repo (dry run: $dry_run)"

status=0

if claude -p --model opus --effort medium "/doctor prompt-audit" > "$report"; then
    # A /goal keeps an unattended session going until the condition holds, so
    # a text-only end of turn with steps still owed does not end the run.
    # The condition carries the whole task, since /goal takes no other text.
    prompt="/goal Follow every step of $repo/docs/model-review/prompt.txt. The workstation audit report is at $report."
    if audit_standards; then
        prompt+=" The standards plugin audit report is at $report_standards."
    else
        echo "standards audit failed; the review runs without it"
        prompt+=" The standards plugin audit failed this run: note that gap in your hand-over."
    fi
    condition=" Done when every step of that file is complete and your final message names the PR URL or says the month was quiet."
    if (( dry_run )); then
        condition=" This is a dry run: commit on your branch and stop. Do not push, open a PR, or send a notification. Done when the commit exists and your final message says so."
    fi
    prompt+="$condition"

    claude -p --model opus --effort high --permission-mode auto \
        -w "model-review-$(date +%Y-%m)" "$prompt" || {
        echo "review session failed"
        status=1
    }
else
    echo "prompt audit failed"
    status=1
fi

# The writing review and the cairn docs cycle are separate sessions that only
# pavilion launches. Their results never change this script's exit status.
if [[ "$(hostname -s)" == pavilion ]]; then
    review_args=()
    (( dry_run )) && review_args+=(--dry-run)
    survey-writing-review "${review_args[@]}" || echo "writing review launch failed"
    cairn-docs-cycle "${review_args[@]}" || echo "cairn docs cycle launch failed"
fi

exit "$status"
