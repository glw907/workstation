#!/usr/bin/env -S python3 -I
"""Print a Markdown report of how long passes took, from GitHub, gate records, and the approval queue.

Environment seams: PASS_REPORT_GH names the gh binary, PASS_REPORT_HOME replaces $HOME for the
toplevel mapping and the default state paths, XDG_CACHE_HOME moves the cache.
"""

import argparse
import hashlib
import json
import math
import os
import re
import statistics
import subprocess
import sys
import time
from collections import Counter
from datetime import datetime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

OWNER = "glw907"
RUN_LIST_CAP = 1000
RATE_WAIT_CAP = 900
HOUR = 3600
DEFAULT_BRANCHES = {"main", "master"}
SCORE_KEYS = ("planPathMin", "actualPathMin", "fixRounds", "reds", "attended", "escapes")
SCORE_RE = re.compile(r"<!--\s*pass-score\s+(\{.*?\})\s*-->")


def ts(text):
    """Parse an ISO-8601 timestamp that carries an offset or a Z."""
    when = datetime.fromisoformat(text.replace("Z", "+00:00"))
    if when.tzinfo is None:
        raise ValueError("timestamp without an offset")
    return when


def iso(when):
    return when.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


class GhError(Exception):
    pass


class Gh:
    """Run gh through a file cache, tracking which repos ended with partial data."""

    def __init__(self, binary, cache_root, use_cache):
        self.binary = binary
        self.root = cache_root
        self.use_cache = use_cache
        self.partial = set()

    def _path(self, repo, args, window):
        key = hashlib.sha256(json.dumps([repo, args, window]).encode()).hexdigest()
        return self.root / (repo or "_") / f"{key}.json"

    def _read(self, path, ttl):
        try:
            if ttl is not None and time.time() - path.stat().st_mtime > ttl:
                return None
            return json.loads(path.read_text())
        except (OSError, ValueError):
            return None

    def _call(self, args):
        run = subprocess.run([self.binary, *args], capture_output=True, text=True)
        if run.returncode != 0:
            raise GhError(run.stderr.strip() or run.stdout.strip() or f"gh exited {run.returncode}")
        return json.loads(run.stdout)

    @staticmethod
    def _rate_wait(message):
        """Seconds to wait for the reset time a rate-limit message names, capped."""
        found = re.search(r"\d{4}-\d\d-\d\dT[\d:]+(?:Z|[+-]\d\d:\d\d)", message)
        if found:
            wait = (ts(found.group(0)) - datetime.now(timezone.utc)).total_seconds()
        else:
            found = re.search(r"\b(\d{10})\b", message)
            wait = int(found.group(1)) - time.time() if found else 60
        return max(0, min(wait, RATE_WAIT_CAP))

    def json(self, args, repo=None, window="", ttl=HOUR):
        """Return gh's parsed JSON, or None when a rate limit left this repo without data."""
        path = self._path(repo, args, window)
        if self.use_cache:
            cached = self._read(path, ttl)
            if cached is not None:
                return cached
        for attempt in (0, 1):
            try:
                data = self._call(args)
            except GhError as err:
                if "rate limit" not in str(err).lower():
                    raise
                if attempt == 0:
                    time.sleep(self._rate_wait(str(err)))
                    continue
                self.partial.add(repo or "(repo list)")
                return self._read(path, None) if self.use_cache else None
            if self.use_cache:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(json.dumps(data))
            return data


def repo_of_toplevel(top, home):
    """Map a worktree toplevel to a repo name, or None when it belongs to no known repo."""
    try:
        parts = Path(top).relative_to(home).parts
    except ValueError:
        return None
    if not parts:
        return None
    if parts[0] == ".dotfiles" or parts[0].startswith(".dotfiles-"):
        return "workstation"
    if parts[0] == "Projects" and len(parts) > 1:
        if parts[1] == "workstation-wt":
            return "workstation" if len(parts) > 2 else None
        return parts[1]
    return None


def parse_record(line):
    """Parse one runs.jsonl line into a record, or None for a kind the report ignores.

    Raises ValueError for a line that is not a usable gate or ci record.
    """
    obj = json.loads(line)
    if not isinstance(obj, dict):
        raise ValueError("not an object")
    kind = obj.get("kind")
    if kind not in ("gate", "ci"):
        return None
    rec = {
        "kind": kind,
        "toplevel": obj.get("toplevel"),
        "branch": obj.get("branch"),
        "outcome": obj.get("outcome"),
        "pr": obj.get("pr"),
        "lock": 0,
    }
    rec["start"] = ts(obj["start"])
    rec["end"] = ts(obj["end"])
    seconds = (rec["end"] - rec["start"]).total_seconds()
    if kind == "gate" and rec["outcome"] == "exit":
        rec["lock"] = obj["lockWaitSeconds"]
        if not isinstance(rec["lock"], (int, float)):
            raise ValueError("lockWaitSeconds")
        seconds -= rec["lock"]
    rec["seconds"] = seconds
    return rec


def join_records(records, prs, repo_names, home):
    """Attach each record to its PR; return ({(repo, number): [records]}, dropped count).

    A record whose toplevel maps to a listed repo joins inside that repo (ci records by pr
    number, gate records by branch). Any other record joins by branch only when one merged PR
    in the window carries that branch. A branch join needs the record inside the PR's life
    (created minus 7 days to merged) because some branch names repeat.
    """
    by_branch = {}
    for pr in prs:
        by_branch.setdefault(pr["branch"], []).append(pr)
    joined = {}
    dropped = 0
    for rec in records:
        name = repo_of_toplevel(rec["toplevel"], home) if rec["toplevel"] else None
        target = None
        if name in repo_names:
            if rec["kind"] == "ci":
                found = [p for p in prs if p["repo"] == name and p["number"] == rec["pr"]]
            else:
                found = [p for p in by_branch.get(rec["branch"], []) if p["repo"] == name and _alive(p, rec)]
            if found:
                target = max(found, key=lambda p: p["created"])
        else:
            found = by_branch.get(rec["branch"], [])
            if rec["kind"] == "gate" and len(found) == 1 and _alive(found[0], rec):
                target = found[0]
            else:
                dropped += 1
        if target:
            joined.setdefault((target["repo"], target["number"]), []).append(rec)
    return joined, dropped


def _alive(pr, rec):
    return pr["created"] - timedelta(days=7) <= rec["end"] <= pr["merged"]


def pr_gate_seconds(pr, records, prs, repo_names, home):
    """Return the gate seconds the join gives one PR: end - start - lock wait per exited gate run."""
    joined, _ = join_records(records, prs, repo_names, home)
    return sum(
        r["seconds"]
        for r in joined.get((pr["repo"], pr["number"]), [])
        if r["kind"] == "gate" and r["outcome"] == "exit"
    )


def union_seconds(intervals):
    """Return the total length of the union of (start, end) datetime pairs."""
    total = 0.0
    cur_start = cur_end = None
    for start, end in sorted(intervals):
        if cur_end is None or start > cur_end:
            if cur_end is not None:
                total += (cur_end - cur_start).total_seconds()
            cur_start, cur_end = start, end
        elif end > cur_end:
            cur_end = end
    if cur_end is not None:
        total += (cur_end - cur_start).total_seconds()
    return total


def fetch_runs(gh, repo, lo, hi):
    """List runs created in [lo, hi] (epoch seconds), halving any range gh caps at 1,000."""
    window = f"{iso(datetime.fromtimestamp(lo, timezone.utc))}..{iso(datetime.fromtimestamp(hi, timezone.utc))}"
    runs = gh.json(
        ["run", "list", "-R", f"{OWNER}/{repo}", "--created", window, "--json",
         "databaseId,workflowName,headBranch,headSha,event,conclusion,status,startedAt,updatedAt",
         "--limit", str(RUN_LIST_CAP)],
        repo, window,
    )
    if runs is None:
        return []
    if len(runs) < RUN_LIST_CAP or hi - lo <= 1:
        return runs
    mid = lo + (hi - lo) // 2
    merged = {}
    for run in fetch_runs(gh, repo, lo, mid) + fetch_runs(gh, repo, mid, hi):
        merged[run["databaseId"]] = run
    return list(merged.values())


def parse_score(body):
    """Return the score dict from a PR body, None when absent; raise ValueError when malformed."""
    found = SCORE_RE.search(body or "")
    if not found:
        return None
    obj = json.loads(found.group(1))
    return _score_values(obj)


def _score_values(obj):
    if not isinstance(obj, dict):
        raise ValueError("score is not an object")
    out = {}
    for key in SCORE_KEYS:
        val = obj.get(key)
        if val is not None and (isinstance(val, bool) or not isinstance(val, (int, float))):
            raise ValueError(key)
        out[key] = val
    return out


def decision_wait(line):
    """Return (repo, wait minutes) for a pr or design decision line, None for other kinds."""
    obj = json.loads(line)
    if obj.get("kind") not in ("pr", "design"):
        return None
    found = re.match(rf"{OWNER}/([^#:]+)[#:]", obj["ref"])
    if not found:
        raise ValueError("ref")
    queued = datetime.strptime(obj["packet"][:15], "%Y%m%dT%H%M%S").replace(tzinfo=ZoneInfo("America/Anchorage"))
    decided = ts(obj["time"])
    return found.group(1), decided, (decided - queued).total_seconds() / 60


def percentile(vals, frac):
    ordered = sorted(vals)
    return ordered[max(0, math.ceil(frac * len(ordered)) - 1)]


def fmt(num):
    return f"{num:.1f}"


def stat_row(label, vals, total=True):
    if not vals:
        return None
    tot = fmt(sum(vals)) if total else "-"
    return f"| {label} | {len(vals)} | {fmt(statistics.median(vals))} | {fmt(percentile(vals, 0.9))} | {tot} |"


def read_lines(path, missing):
    """Yield non-blank lines of a file, noting it in `missing` when absent."""
    try:
        text = path.read_text()
    except FileNotFoundError:
        missing.append(str(path))
        return
    for line in text.splitlines():
        if line.strip():
            yield line


def load_backfill(path, missing, malformed):
    rows = {}
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        missing.append(str(path))
        return rows
    except ValueError:
        malformed[0] += 1
        return rows
    for row in data.get("rows", []) if isinstance(data, dict) else []:
        try:
            rows[(row["repo"], row["pr"])] = _score_values(row)
        except (KeyError, TypeError, ValueError):
            malformed[0] += 1
    return rows


def build_pr(repo, raw):
    return {
        "repo": repo,
        "number": raw["number"],
        "branch": raw["headRefName"],
        "created": ts(raw["createdAt"]),
        "merged": ts(raw["mergedAt"]),
        "body": raw.get("body") or "",
    }


def failing_steps(gh, repo, runs):
    steps = Counter()
    for run in runs:
        if run["conclusion"] != "failure":
            continue
        data = gh.json(
            ["run", "view", str(run["databaseId"]), "-R", f"{OWNER}/{repo}", "--json", "jobs"],
            repo, "", ttl=None,
        )
        for job in (data or {}).get("jobs", []):
            if job.get("conclusion") != "failure":
                continue
            for step in job.get("steps", []):
                if step.get("conclusion") == "failure":
                    steps[step["name"]] += 1
                    break
    return steps


def repo_section(repo, prs, runs, joined, waits, scores, gh):
    mins = 60.0
    rows = [stat_row("PR open to merge", [(p["merged"] - p["created"]).total_seconds() / mins for p in prs])]
    gate, lock, ci_sess, ci_wait = [], [], [], []
    for pr in prs:
        recs = joined.get((repo, pr["number"]), [])
        exited = [r for r in recs if r["kind"] == "gate" and r["outcome"] == "exit"]
        if exited:
            gate.append(sum(r["seconds"] for r in exited) / mins)
            lock.append(sum(r["lock"] for r in exited) / mins)
        sess = [r for r in recs if r["kind"] == "ci"]
        if sess:
            ci_sess.append(sum(r["seconds"] for r in sess) / mins)
        mine = [
            (max(ts(r["startedAt"]), pr["created"]), min(ts(r["updatedAt"]), pr["merged"]))
            for r in runs
            if r["headBranch"] == pr["branch"]
        ]
        mine = [(a, b) for a, b in mine if b > a]
        if mine:
            ci_wait.append(union_seconds(mine) / mins)
    rows += [
        stat_row("Local gates", gate),
        stat_row("CI wait on the PR", ci_wait),
        stat_row("CI waits a session sat through", ci_sess),
        stat_row(
            "CI on the default branch",
            [(ts(r["updatedAt"]) - ts(r["startedAt"])).total_seconds() / mins
             for r in runs if r["event"] == "push" and r["headBranch"] in DEFAULT_BRANCHES],
        ),
    ]
    steps = Counter()
    failed = [r for r in runs if r["conclusion"] == "failure"]
    if runs:
        rows.append(f"| Reds | {len(runs)} | - | - | {len(failed)} failed ({100 * len(failed) / len(runs):.1f}%) |")
        steps = failing_steps(gh, repo, failed)
    rows.append(stat_row("Waiting on Geoff", waits))
    both = [s for s in scores if s["planPathMin"] and s["actualPathMin"] is not None]
    rows += [
        stat_row("Planned path (min)", [s["planPathMin"] for s in both]),
        stat_row("Actual path (min)", [s["actualPathMin"] for s in both]),
        stat_row("Actual / planned", [s["actualPathMin"] / s["planPathMin"] for s in both], total=False),
    ]
    for label, key in (("Fix rounds", "fixRounds"), ("Attended events", "attended"), ("Escapes", "escapes")):
        rows.append(stat_row(label, [s[key] for s in scores if s[key] is not None]))
    rows = [r for r in rows if r]
    if not rows:
        return f"### {repo}\n\nNo data in the window.\n", lock
    out = [f"### {repo}", "", "| Row | n | Median | p90 | Total |", "|---|---|---|---|---|", *rows, ""]
    if lock:
        out += [f"Lock wait behind other gates: {fmt(sum(lock))} min across {len(lock)} PRs.", ""]
    if steps:
        top = ", ".join(f"`{name}` ({n})" for name, n in steps.most_common(5))
        out += [f"Top failing steps: {top}.", ""]
    return "\n".join(out), lock


def parse_args(argv):
    ap = argparse.ArgumentParser(prog="pass-report", description="Report pass timing as Markdown.")
    ap.add_argument("--since", help="window start, YYYY-MM-DD (default: 30 days ago)")
    ap.add_argument("--repo", action="append", default=[], help="limit to a repo name; repeatable")
    ap.add_argument("--records", action="append", default=[], help="extra gate records file; repeatable")
    ap.add_argument("--backfill", help="score backfill JSON file")
    ap.add_argument("--no-cache", action="store_true", help="skip the gh cache")
    return ap.parse_args(argv)


def main(argv):
    args = parse_args(argv)
    home = Path(os.environ.get("PASS_REPORT_HOME") or os.environ["HOME"])
    cache_base = Path(os.environ.get("XDG_CACHE_HOME") or Path(os.environ["HOME"]) / ".cache")
    for name in args.records:
        if not Path(name).is_file():
            print(f"pass-report: records file not found: {name}", file=sys.stderr)
            return 2
    now = datetime.now(timezone.utc)
    since_day = args.since or (now - timedelta(days=30)).strftime("%Y-%m-%d")
    since = datetime.strptime(since_day, "%Y-%m-%d").replace(tzinfo=timezone.utc)
    gh = Gh(os.environ.get("PASS_REPORT_GH", "gh"), cache_base / "pass-report", not args.no_cache)

    try:
        listed = gh.json(["repo", "list", OWNER, "--json", "name", "--limit", "200"], None, "")
        if listed is None:
            print("pass-report: gh rate limit hit listing repos", file=sys.stderr)
            return 1
        repo_names = {r["name"] for r in listed}
        repos = sorted(n for n in repo_names if not args.repo or n in args.repo)
        prs_by_repo = {}
        for repo in repos:
            raw = gh.json(
                ["pr", "list", "-R", f"{OWNER}/{repo}", "--state", "merged", "--search", f"merged:>={since_day}",
                 "--json", "number,headRefName,createdAt,mergedAt,body", "--limit", "300"],
                repo, since_day,
            )
            prs_by_repo[repo] = [build_pr(repo, p) for p in raw or []]
        runs_by_repo = {}
        for repo in repos:
            lo = min([since] + [p["created"] for p in prs_by_repo[repo]])
            fetched = fetch_runs(gh, repo, int(lo.timestamp()), int(now.timestamp()))
            runs_by_repo[repo] = [r for r in fetched if r["status"] == "completed" and r["event"] != "dynamic"]
    except GhError as err:
        print(f"pass-report: gh failed: {err}", file=sys.stderr)
        return 1

    missing = []
    malformed = [0]
    state = home / ".local/state"
    record_files = [state / "cairn-run-gate/runs.jsonl", *map(Path, args.records)]
    records = []
    for path in record_files:
        for line in read_lines(path, missing):
            try:
                rec = parse_record(line)
            except (ValueError, KeyError, TypeError):
                malformed[0] += 1
                continue
            if rec:
                records.append(rec)
    all_prs = [p for repo in repos for p in prs_by_repo[repo]]
    joined, dropped = join_records(records, all_prs, repo_names, home)

    waits = {}
    negative = 0
    for line in read_lines(state / "approval-queue/decisions.jsonl", missing):
        try:
            got = decision_wait(line)
        except (ValueError, KeyError, TypeError):
            malformed[0] += 1
            continue
        if not got or got[1] < since:
            continue
        name, _, wait = got
        if wait < 0:
            negative += 1
        else:
            waits.setdefault(name, []).append(wait)

    backfill_path = Path(args.backfill) if args.backfill else home / "Projects/initiatives/dev-speed/research/score-backfill.json"
    backfill = load_backfill(backfill_path, missing, malformed)
    unscored = 0
    scores = {}
    for pr in all_prs:
        try:
            score = parse_score(pr["body"])
        except (ValueError, TypeError):
            malformed[0] += 1
            score = None
        score = score or backfill.get((pr["repo"], pr["number"]))
        if score:
            scores.setdefault(pr["repo"], []).append(score)
        else:
            unscored += 1

    out = ["# Pass score report", "", f"Window: {since_day} to {now.strftime('%Y-%m-%d')}", ""]
    for repo in repos:
        section, _ = repo_section(
            repo, prs_by_repo[repo], runs_by_repo[repo], joined, waits.get(repo, []), scores.get(repo, []), gh,
        )
        out.append(section)
    out += ["## Notes", ""]
    out.append("- Gate records read: " + ", ".join(str(p) for p in record_files))
    out += [f"- Not found: {m}" for m in missing]
    out.append(f"- Dropped gate records: {dropped}")
    out.append(f"- Negative waits dropped: {negative}")
    out.append(f"- Malformed lines or rows skipped: {malformed[0]}")
    out.append(f"- PRs with no score: {unscored}")
    if gh.partial:
        out.append("- Partial data (gh rate limit, cache used): " + ", ".join(sorted(gh.partial)))
    print("\n".join(out))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
