#!/usr/bin/env python3
"""PreToolUse hook denying every `gh pr merge`, so a merge goes through `approval-queue`.

A merge lands through `approval-queue merge <id>` (a decided packet) or `approval-queue land`
(a PR that needs no packet); the `## Before merge` check lives in
`approval-queue merge --premerge-done`. Quoted text, escapes, comments, and heredoc bodies never
count as shell syntax, so a command that only mentions `gh pr merge` goes through. Per the hooks
reference (https://code.claude.com/docs/en/hooks) a denial is `hookSpecificOutput.permissionDecision:
"deny"` with a `permissionDecisionReason`, printed with exit 0. This is a slip guard, not a
security boundary; its registration sets `onFailure: "block"` because a timed-out hook does not
block the call. Every input the script cannot parse exits 0 silently.
"""

import json
import re
import sys

PREFILTER = re.compile(r"gh\s+pr\s+merge")
HEREDOC = re.compile(r"(?<!<)<<-?\s*(['\"]?)([A-Za-z_]\w*)\1")
REDIRECT = re.compile(r"\d*[<>]&\d*")
SEPARATORS = re.compile(r"[$`()|&;\n]")
ASSIGNMENT = re.compile(r"[A-Za-z_]\w*=")
WRAPPERS = {"command", "env", "nohup", "exec", "time", "timeout", "sudo", "xargs", "!", "{", "if",
            "then", "do", "else", "elif", "while", "until"}
SKIPPED = re.compile(r"-\S*|\d+[smhd]?|[A-Z]{3,}|\d*[<>]\S*")
GH = re.compile(r"(\S*/)?gh")
REASON = (
    "Blocked: merge through approval-queue, never `gh pr merge`. Use `approval-queue merge <id>` for a "
    "decided packet (after an approve), or `approval-queue land <owner/repo#n> <claim>` for a PR that "
    "needs no packet; the `approval-packet` skill has the procedure. The `## Before merge` check now "
    "lives in `approval-queue merge --premerge-done <owner/repo#n> <id>`."
)


def blank_heredocs(command: str) -> str:
    """Replace heredoc bodies with spaces, keeping every character's position."""
    kept: list[str] = []
    delimiter = None
    for line in command.split("\n"):
        if delimiter is not None:
            if line.strip() == delimiter:
                delimiter = None
            kept.append(" " * len(line))
            continue
        kept.append(line)
        found = HEREDOC.search(line)
        if found:
            delimiter = found.group(2)
    return "\n".join(kept)


def mask(command: str) -> str:
    """Blank quoted text, escapes, and comments, so only live shell syntax stays in place.

    A `$(...)` or backtick span inside double quotes runs, so it stays live; `stack` holds the open
    spans (a paren depth for `$(`, or a backtick marker).
    """
    out = list(command)
    index, quote = 0, ""
    stack: list[int | str] = []
    while index < len(out):
        char = out[index]
        if char == "\\" and quote != "'":
            out[index] = " "
            if index + 1 < len(out):
                out[index + 1] = " "
            index += 2
            continue
        if stack and not quote:
            if stack[-1] == "`" and char == "`":
                stack.pop()
                quote = '"'
                index += 1
                continue
            if stack[-1] != "`" and char in "()":
                stack[-1] += 1 if char == "(" else -1
                if stack[-1] == 0:
                    stack.pop()
                    quote = '"'
                    index += 1
                    continue
        if quote == '"' and char == "$" and command[index + 1:index + 2] == "(":
            stack.append(1)
            quote = ""
            index += 2
            continue
        if quote == '"' and char == "`":
            stack.append("`")
            quote = ""
            index += 1
            continue
        if quote:
            if char == quote:
                quote = ""
            out[index] = " "
        elif char in "'\"":
            quote = char
            out[index] = " "
        elif char == "#" and (index == 0 or out[index - 1] in " \t\n;&|("):
            while index < len(out) and out[index] != "\n":
                out[index] = " "
                index += 1
            continue
        index += 1
    return REDIRECT.sub(lambda found: " " * len(found.group(0)), "".join(out))


def merges(masked: str) -> bool:
    """Return whether any stage of masked text runs `gh pr merge`, past assignments and wrappers."""
    for stage in SEPARATORS.split(masked):
        words = stage.split()
        while words and (ASSIGNMENT.match(words[0]) or SKIPPED.fullmatch(words[0])
                         or words[0] in WRAPPERS):
            del words[:1]
        if len(words) >= 3 and GH.fullmatch(words[0]) and words[1:3] == ["pr", "merge"]:
            return True
    return False


def main() -> int:
    """Read the hook input and deny a command that merges a PR."""
    try:
        command = json.load(sys.stdin)["tool_input"]["command"]
    except (KeyError, TypeError, ValueError):
        return 0
    if not isinstance(command, str):
        return 0
    masked = mask(blank_heredocs(command))
    if PREFILTER.search(masked) and merges(masked):
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": REASON,
        }}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
