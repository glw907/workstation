#!/usr/bin/env bash
set -euo pipefail

# Asks Geoff for the sudo password in a hidden-entry dialog and caches it for the Claude
# session in tmpfs. The cache lives in /dev/shm so it never touches persistent disk and
# vanishes on reboot; claude-sudo-clear shreds it on session exit. The password is typed or
# pasted by a person, never fetched by a script, so root stays behind a human step.
#
# Usage: claude-sudo-setup

CACHE="${CLAUDE_SUDO_CACHE:-/dev/shm/claude-sudo-$(id -u)}"
# claude-askpass and claude-sudo-clear read and shred only the /dev/shm path, so an override is for
# tests and must stay on tmpfs: a password never lands on persistent disk.
case "$CACHE" in
    /dev/shm/*|"${XDG_RUNTIME_DIR:-/nonexistent}"/*) ;;
    *) echo "Error: CLAUDE_SUDO_CACHE must be under /dev/shm or \$XDG_RUNTIME_DIR." >&2; exit 1 ;;
esac

command -v zenity >/dev/null || { echo "Error: zenity not installed." >&2; exit 1; }

# --entry --hide-text instead of --password: the bare password dialog reads as a system login
# prompt and invites a reflex entry (the secret-receive pattern).
PASSWORD=$(zenity --entry --hide-text --title "Claude sudo" --ok-label "Cache" \
    --text "Type or paste the sudo password for $(hostname -s)." --timeout 300 2>/dev/null) || PASSWORD=""

if [ -z "$PASSWORD" ]; then
    echo "Error: no sudo password entered (dialog cancelled, timed out, or no display); nothing cached." >&2
    exit 1
fi

umask 077
rm -f "$CACHE"  # the umask guarantee holds only for a freshly created file
printf '%s\n' "$PASSWORD" > "$CACHE"
echo "Sudo password cached in tmpfs."
