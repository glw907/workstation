#!/usr/bin/env bash
# Print the Fastmail app password vdirsyncer sends for CardDAV. vdirsyncer runs from a systemd
# user unit with no shell profile, so this sources the workstation's credential store itself.
set -euo pipefail

# shellcheck source=/dev/null
source "$HOME/.local/secrets"
printf '%s\n' "${FASTMAIL_DAV_PASSWORD:?is empty after sourcing ~/.local/secrets}"
