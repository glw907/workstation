#!/usr/bin/env bash
set -uo pipefail

# check-drift: reconcile this repo against the live machine. Read-only; it
# never modifies the repo, the packages, or $HOME.
#
# Sections: stow state per package, rpm-ostree layered set, Homebrew,
# flatpaks (against the manifest, with Bluefin's stock set implicit), uv
# tools, staged /etc drops, untracked ~/.local/bin executables, the
# git state, user lingering, and the Proton Pass wiring (including the grant map against
# pass-access, and every Claude agent's token expiry from that map). Exit 0 only
# when everything matches; exit 1 with per-item detail otherwise. The
# manifests record intent; this script reports what happened.

DOTFILES="$HOME/.dotfiles"
BLUEFIN="$DOTFILES/bluefin"

fail=0
bad() { echo "  x $*"; fail=1; }
ok()  { echo "  + $*"; }
warn() { echo "  ! $*"; }

# Reads a list file, dropping comment and blank lines. Same expression as
# bootstrap.sh's read_list; duplicated so this script stays standalone.
read_list() { grep -vE '^[[:space:]]*(#|$)' "$1"; }

# The initiatives clone: the SessionStart hook reads its records. A missing or
# stale clone warns and never fails the run, and an unreachable remote is its
# own line, since the machine may simply be offline.
check_initiatives() {
    local dir="${INITIATIVES_DIR:-$HOME/Projects/initiatives}" url remote local_head
    echo "Initiatives clone (~/Projects/initiatives):"
    if [[ ! -d "$dir/.git" ]]; then
        warn "no clone at $dir (gh repo clone glw907/initiatives $dir)"
        return 0
    fi
    url=$(git -C "$dir" config remote.origin.url) || url=""
    local_head=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || local_head=""
    if [[ -z "$url" ]] || ! remote=$(timeout "${INITIATIVES_TIMEOUT:-5}" git ls-remote "$url" HEAD 2>/dev/null) \
        || [[ -z "$remote" ]]; then
        warn "remote unreachable, behind-ness not checked"
        return 0
    fi
    remote=${remote%%[[:space:]]*}
    if [[ "$remote" == "$local_head" ]] || git -C "$dir" merge-base --is-ancestor "$remote" HEAD 2>/dev/null; then
        ok "clone is current"
    else
        warn "clone is behind origin (git -C $dir pull --ff-only)"
    fi
}

# Work this host holds that the other cannot see, and anything Syncthing could not reconcile. A
# dirty repo is normal, so each item warns and never fails the run. Behind-ness uses the last fetch.
check_work() {
    local root="${WORK_ROOT:-$HOME/Projects}" repo name def dirty ahead behind copy found=""
    echo "Work left on this host:"
    for repo in "$DOTFILES" "$root"/*/; do
        repo=${repo%/}
        [[ -d "$repo/.git" && ! -L "$repo" ]] || continue
        name=${repo##*/}
        dirty=$(git -C "$repo" status --porcelain | wc -l)
        ahead=$(git -C "$repo" rev-list --count HEAD --not --remotes 2>/dev/null) || ahead=0
        def=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
        behind=$(git -C "$repo" rev-list --count "HEAD..${def:-origin/main}" 2>/dev/null) || behind=0
        (( dirty > 0 )) && { warn "$name: $dirty uncommitted"; found=1; }
        (( ahead > 0 )) && { warn "$name: $ahead unpushed"; found=1; }
        (( behind > 0 )) && { warn "$name: $behind behind origin"; found=1; }
    done
    while IFS= read -r copy; do
        warn "sync conflict: $copy"
        found=1
    done < <(find "${WORK_DOCUMENTS:-$HOME/Documents}" "${WORK_MEMORY:-$HOME/.claude/projects}" \
        -path '*/.stversions' -prune -o -name '*.sync-conflict-*' -print 2>/dev/null)
    [[ -n "$found" ]] || ok "nothing left here"
}

# Proton Pass wiring (self-hosting Pass W): the pass-cli version brew holds (never by running
# pass-cli), and which path this host reads the age key on. A host with no agent token
# (path=none) fails; a token within 30 days of expiry warns and an expired one fails. Claude's
# own agent gets an informational line after.
check_proton() {
    local brew_bin="${BREW:-brew}" key_bin="${WS_PASS_KEY:-ws-pass-key}" ver status days
    echo "Proton Pass (pass-cli, agent token):"
    ver=$("$brew_bin" list --versions proton-pass-cli 2>/dev/null) || ver=""
    if [[ -n "$ver" ]]; then
        ok "pass-cli: ${ver#proton-pass-cli }"
    else
        bad "proton-pass-cli is not installed (brew bundle)"
    fi
    if ! status=$("$key_bin" --status 2>/dev/null); then
        bad "ws-pass-key --status failed (stow bin)"
    else
        case "$status" in
            path=none*)
                bad "age key path: no agent token in the keyring (ws-pass-key --store)" ;;
            path=proton*)
                ok "age key path: Proton Pass agent token"
                days=$(sed -n 's/.* days=\(-\{0,1\}[0-9]*\).*/\1/p' <<< "$status")
                if [[ -z "$days" ]]; then
                    warn "agent token expiry unknown (ws-pass-key --store records it)"
                elif (( days < 0 )); then
                    bad "agent token expired $(( -days )) days ago (renew it, then ws-pass-key --store)"
                elif (( days <= 30 )); then
                    warn "agent token expires in $days days (renew it)"
                else
                    ok "agent token expires in $days days"
                fi ;;
            *)
                bad "unexpected ws-pass-key --status output" ;;
        esac
    fi
    check_claude_agent
    check_grants
}

# The grant map (secrets/proton-grants.tsv) against what this host's agents can reach, and every
# Claude agent's token expiry from the map. The grant comparison covers only this host's rows
# (<host>-claude, <host>-scripts), since a token is readable only where its keyring is; the
# expiry leg reads every Claude row, so either host warns for both. A "keyring" expiry (the
# scripts agents) is not date-checked here: ws-pass-key --status above reads it. A failed
# sign-in warns, because Proton throttles the agent after a few quick logins and the weekly
# timer would otherwise fail on a throttle. PASS_ACCESS_SKIP=1 skips the sign-ins for a session
# that reruns this script. PASS_ACCESS and PASS_GRANTS point the leg at a stub and a test map.
check_grants() {
    local gfail=0 expires_epoch map="${PASS_GRANTS:-$DOTFILES/secrets/proton-grants.tsv}" access="${PASS_ACCESS:-pass-access}"
    local host="${WS_HOST:-$(hostname -s)}" want got row agent expires today days
    if [[ ! -s "$map" ]] || [[ -z "$(tail -n +2 "$map")" ]]; then
        bad "no grant map rows at $map (secrets/proton-grants.tsv)"
        return 0
    fi
    if [[ "${PASS_ACCESS_SKIP:-}" == 1 ]]; then
        warn "grant check skipped (PASS_ACCESS_SKIP=1); no sign-in made"
    elif ! got=$("$access" 2>/dev/null); then
        warn "pass-access could not sign in (Proton throttles agent logins after a few quick calls; retry in 25 minutes)"
    else
        want=$(awk -F'\t' -v OFS='\t' -v h="$host" 'NR > 1 && ($1 == h "-claude" || $1 == h "-scripts") { print $1, $2, $3 }' "$map" | LC_ALL=C sort)
        got=$(LC_ALL=C sort <<< "$got")
        while IFS= read -r row; do
            [[ -n "$row" ]] && { bad "grant missing: $row"; gfail=1; }
        done < <(LC_ALL=C comm -23 <(printf '%s\n' "$want") <(printf '%s\n' "$got"))
        while IFS= read -r row; do
            [[ -n "$row" ]] && { bad "grant extra: $row"; gfail=1; }
        done < <(LC_ALL=C comm -13 <(printf '%s\n' "$want") <(printf '%s\n' "$got"))
        if (( gfail == 0 )); then ok "grants match the map for $host"; fi
    fi
    today=$(date -u +%s -d "$(date +%F)")
    while IFS=$'\t' read -r agent expires; do
        if ! expires_epoch=$(date -u +%s -d "$expires" 2>/dev/null) || [[ ! "$expires" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
            bad "$agent: malformed expires '$expires' in the grant map"
            continue
        fi
        days=$(( (expires_epoch - today) / 86400 ))
        if (( days < 0 )); then
            bad "$agent expired $(( -days )) days ago (renew it)"
        elif (( days <= 30 )); then
            warn "$agent expires in $days days (renew it)"
        else
            ok "$agent expires in $days days"
        fi
    done < <(awk -F'\t' 'NR > 1 && $1 ~ /-claude$/ && !seen[$1 FS $4]++ { print $1 "\t" $4 }' "$map")
}

# Claude's own Proton Pass agent (<host>-claude, reached through claude-pass). Informational:
# a host where Geoff has not created one yet is reported and never fails the run.
check_claude_agent() {
    local claude_bin="${CLAUDE_PASS:-claude-pass}" status
    if ! status=$("$claude_bin" --status 2>/dev/null); then
        warn "claude-pass --status failed (stow bin)"
        return 0
    fi
    case "$status" in
        path=proton*) ok "Claude's agent: token in the keyring (claude-pass)" ;;
        path=none*) warn "Claude's agent: none on this host yet (Geoff creates <host>-claude; bluefin-admin.md "Secrets")" ;;
        *) warn "unexpected claude-pass --status output" ;;
    esac
}

# The item-title lint (monthly, from the model review): reads the five Claude vaults through
# claude-pass, PASS_TITLE_GAP seconds apart (default 150: Proton throttles agent logins after a
# few quick calls), and applies the naming scheme (decisions, "Naming and notes"): no domain as a
# title, no generic title, no lowercase start, a qualifier only in one trailing parenthesis, and
# no two active items with one title in a vault. Exceptions (brands written in lowercase) come
# one per line from PASS_TITLE_EXCEPTIONS, a private file; a title equal to, or starting with, one
# passes. Findings go to PASS_TITLE_FINDINGS (mode 600) as vault, title, and reason; stdout gets
# the count and that path only, so no title reaches a transcript or a public PR.
check_titles() {
    local claude_bin="${CLAUDE_PASS:-claude-pass}" gap="${PASS_TITLE_GAP:-150}" state="$HOME/.local/state/credential-hygiene"
    local ex_file="${PASS_TITLE_EXCEPTIONS:-$state/title-exceptions.txt}" out="${PASS_TITLE_FINDINGS:-$state/title-findings.tsv}"
    local vault list first=1 exceptions="[]" count
    echo "Proton Pass item titles:"
    if [[ -r "$ex_file" ]]; then
        exceptions=$(jq -Rn '[inputs | select(length > 0)]' < "$ex_file")
    else
        warn "no exceptions file at $ex_file; running with none"
    fi
    mkdir -p "$(dirname "$out")"
    rm -f "$out"; ( umask 077; : > "$out" )
    for vault in Infrastructure Projects ASC "Test accounts" "Age key"; do
        (( first )) || sleep "$gap"
        first=0
        if ! list=$("$claude_bin" item list --vault-name "$vault" --output json 2>/dev/null) || ! jq -e . >/dev/null 2>&1 <<< "$list"; then
            bad "could not list a vault (Proton throttles agent logins; retry in 25 minutes)"
            continue
        fi
        if ( umask 077; jq -r --arg v "$vault" --argjson ex "$exceptions" '
            def active: ((.state // "Active") | tostring | ascii_downcase) as $s | ($s == "active" or $s == "1" or $s == "?");
            [(.items // .)[] | select(active) | (.content.title // .title // "untitled")] as $titles
            | ($titles | group_by(.) | map({key: .[0], value: length}) | from_entries) as $count
            | ($titles | unique)[] as $t
            | [ (if ($t | test("^[A-Za-z0-9_.-]+\\.(com|org|net|io|me|life|gov|edu|app|co|biz|ai|us|is|tv)$"; "i")) then "a domain, not the service'"'"'s name" else empty end),
                (if ($t | gsub("^\\s+|\\s+$"; "") | ascii_downcase | IN("login", "account", "id", "password", "untitled", "new item")) then "a generic title" else empty end),
                (if ($t | test("^[a-z]")) and (($t | split(" ")[0]) as $w | $w == ($w | ascii_downcase) and ($w | test("[a-z]")))
                    and ($ex | any(. as $e | $t == $e or ($t | startswith($e + " "))) | not) then "starts lowercase" else empty end),
                (if ($t | test("^[^()]+( \\([^()]+\\))?$") | not) then "qualifier not in one trailing parenthesis" else empty end),
                (if $count[$t] > 1 then "same title twice in this vault; add a qualifier" else empty end) ]
            | select(length > 0) | [$v, $t, join("; ")] | @tsv' <<< "$list" > "$out.part" 2>/dev/null ); then
            cat "$out.part" >> "$out"
        else
            bad "could not read the titles of a vault"
        fi
        rm -f "$out.part"
    done
    chmod 600 "$out"
    count=$(wc -l < "$out")
    if (( count > 0 )); then
        bad "$count findings (details: $out)"
    else
        ok "no findings in the vaults read"
    fi
}

if [[ "${1:-}" == "--titles" ]]; then
    check_titles
    exit "$fail"
fi

if [[ "${1:-}" == "--proton-only" ]]; then
    check_proton
    exit "$fail"
fi

if [[ "${1:-}" == "--initiatives-only" ]]; then
    check_initiatives
    exit 0
fi

if [[ "${1:-}" == "--work-only" ]]; then
    check_work
    exit 0
fi

echo "Stow state (bluefin/stow-packages.txt):"
mapfile -t packages < <(read_list "$BLUEFIN/stow-packages.txt")
for pkg in "${packages[@]}"; do
    if [[ ! -d "$DOTFILES/$pkg" ]]; then
        bad "$pkg: listed but no package directory"
        continue
    fi
    # A simulated plain stow plans no LINK for a fully stowed package and
    # exits 0; a conflict aborts with a nonzero exit and "conflicts" prose.
    out=$(cd "$DOTFILES" && stow -n -v "$pkg" 2>&1) && rc=0 || rc=$?
    plan=$(grep -iE 'LINK|conflict' <<< "$out" || true)
    if [[ "$rc" -ne 0 || -n "$plan" ]]; then
        bad "$pkg: not fully stowed"
        sed 's/^/      /' <<< "$plan"
    else
        ok "$pkg"
    fi
done

echo ""
echo "Layered RPMs (bluefin/layered-packages.txt):"
live_layered=$(rpm-ostree status --json 2>/dev/null \
    | jq -r '.deployments[0]["requested-packages"][]?' | sort) || live_layered=""
want_layered=$(read_list "$BLUEFIN/layered-packages.txt" | sort)
if [[ "$live_layered" == "$want_layered" ]]; then
    ok "exact match"
else
    bad "layered set differs from the manifest:"
    diff <(echo "$want_layered") <(echo "$live_layered") | sed 's/^/      /'
fi

echo ""
echo "Homebrew (bluefin/Brewfile):"
if brew bundle check --file="$BLUEFIN/Brewfile" >/dev/null 2>&1; then
    ok "every Brewfile entry installed"
else
    bad "Brewfile entries missing (brew bundle check failed):"
    brew bundle check --verbose --file="$BLUEFIN/Brewfile" 2>&1 | sed 's/^/      /'
fi
# brew leaves names a tapped formula with its tap (stalwartlabs/tap/vandelay) and the Brewfile
# by its bare name, so both sides drop the tap before comparing.
extra_brews=$(comm -23 \
    <(brew leaves 2>/dev/null | sed 's|.*/||' | sort) \
    <(grep -oP '^brew "\K[^"]+' "$BLUEFIN/Brewfile" | sed 's|.*/||' | sort))
if [[ -n "$extra_brews" ]]; then
    bad "installed leaves not in the Brewfile (adopt or uninstall):"
    sed 's/^/      /' <<< "$extra_brews"
else
    ok "no unmanifested leaves"
fi

echo ""
echo "Flatpaks (bluefin/flatpaks.txt; Bluefin stock set implicit):"
stock=$(grep -hoP '^flatpak "\K[^"]+' \
    /usr/share/ublue-os/homebrew/system-flatpaks.Brewfile \
    /usr/share/ublue-os/homebrew/system-dx-flatpaks.Brewfile 2>/dev/null | sort -u)
installed=$(flatpak list --app --columns=application 2>/dev/null | sort -u)
manifest=$(read_list "$BLUEFIN/flatpaks.txt" | sort -u)
missing=$(comm -23 <(echo "$manifest") <(echo "$installed"))
[[ -n "$missing" ]] && { bad "in manifest but not installed:"; sed 's/^/      /' <<< "$missing"; } \
    || ok "every manifest entry installed"
extras=$(comm -23 <(echo "$installed") <(sort -u <(echo "$stock") <(echo "$manifest")))
[[ -n "$extras" ]] && { bad "installed, neither stock nor in manifest (adopt or remove):"; sed 's/^/      /' <<< "$extras"; } \
    || ok "no unmanifested apps beyond the stock set"

echo ""
echo "uv tools (bluefin/uv-tools.txt):"
# Package lines are "name vX.Y.Z"; executable lines start "- name" and are
# not packages ("-" sits inside the character class, so filter them first).
live_uv=$(uv tool list 2>/dev/null | grep -v '^- ' | awk '/ v[0-9]/{print $1}' | sort)
want_uv=$(read_list "$BLUEFIN/uv-tools.txt" | sed 's/[[ ].*//' | sort)
if [[ "$live_uv" == "$want_uv" ]]; then
    ok "exact match"
else
    bad "uv tool set differs from the manifest:"
    diff <(echo "$want_uv") <(echo "$live_uv") | sed 's/^/      /'
fi

echo ""
echo "Staged /etc drops (bluefin/etc/):"
etc_pair() {
    local src="$1" dst="$2"
    if sudo -n true 2>/dev/null || [[ -r "$dst" ]]; then
        if diff -q "$src" "$dst" >/dev/null 2>&1; then
            ok "$dst"
        else
            bad "$dst differs from staged copy (or is absent)"
        fi
    else
        echo "  ? $dst unreadable without sudo, skipped"
    fi
}
for f in "$BLUEFIN"/etc/chromium-policies/*.json; do
    etc_pair "$f" "/etc/chromium/policies/managed/$(basename "$f")"
done
etc_pair "$BLUEFIN/etc/udev/51-android.rules" /etc/udev/rules.d/51-android.rules
# Pavilion unlocks its disk through the TPM, so it keeps auto-login off.
if [[ "$(hostname)" == pavilion ]]; then
    etc_pair "$BLUEFIN/etc/gdm/custom.conf.pavilion" /etc/gdm/custom.conf
else
    etc_pair "$BLUEFIN/etc/gdm/custom.conf" /etc/gdm/custom.conf
fi
etc_pair "$BLUEFIN/etc/systemd/system/systemd-remount-fs.service" /etc/systemd/system/systemd-remount-fs.service
# Keychron K3 reconnect settings, installed on pavilion only.
if [[ "$(hostname)" == pavilion ]]; then
    etc_pair "$BLUEFIN/etc/bluetooth/main.conf" /etc/bluetooth/main.conf
    etc_pair "$BLUEFIN/etc/modprobe.d/btusb-no-autosuspend.conf" /etc/modprobe.d/btusb-no-autosuspend.conf
fi
# Wi-Fi power save adds per-packet latency on a desktop, pavilion only.
if [[ "$(hostname)" == pavilion ]]; then
    etc_pair "$BLUEFIN/etc/NetworkManager/conf.d/wifi-powersave-off.conf" /etc/NetworkManager/conf.d/wifi-powersave-off.conf
fi
# The phonebook runs and the maintenance run, pavilion only (their services carry ConditionHost=pavilion).
if [[ "$(hostname)" == pavilion ]]; then
    for unit in phonebook-nightly.timer phonebook-nightly.service phonebook-gate.timer phonebook-gate.service maintain-projects.timer maintain-projects.service; do
        etc_pair "$BLUEFIN/etc/systemd/system/$unit" "/etc/systemd/system/$unit"
    done
fi
# The clean room's user and the sudoers rule that lets glw907 act as it.
etc_pair "$BLUEFIN/etc/sysusers.d/cleanroom.conf" /etc/sysusers.d/cleanroom.conf
etc_pair "$BLUEFIN/etc/sudoers.d/cleanroom" /etc/sudoers.d/cleanroom

echo ""
echo "Untracked ~/.local/bin executables (bluefin/untracked-bin.txt):"
strays=$(comm -23 \
    <(find "$HOME/.local/bin" -maxdepth 1 -type f -perm -u+x -printf '%f\n' | sort) \
    <(read_list "$BLUEFIN/untracked-bin.txt" | sort))
[[ -n "$strays" ]] && { bad "plain-file executables not in the known-untracked list:"; sed 's/^/      /' <<< "$strays"; } \
    || ok "no unexplained strays"

echo ""
# Prints a --schemadir option for a schema that ships inside a GNOME Shell
# extension (dash-to-dock, say), which the global schema cache doesn't
# include. Prints nothing for any other schema. Same function as bootstrap.sh's;
# duplicated so each script stays standalone.
schema_dir_opt() {
    [[ "$1" == org.gnome.shell.extensions.* ]] || return 0
    local d
    for d in /usr/share/gnome-shell/extensions/*/schemas \
             "$HOME"/.local/share/gnome-shell/extensions/*/schemas; do
        if grep -qs "id=\"$1\"" "$d"/*.gschema.xml; then
            echo "--schemadir $d"
            return 0
        fi
    done
}

# Always /usr/bin/gsettings: Homebrew's glib puts its own gsettings first on
# PATH, and that build has no dconf module, so it silently falls back to a
# keyfile (~/.config/glib-2.0/settings/keyfile) the desktop never reads.
echo "GNOME settings (bluefin/gnome-settings.txt):"
# Manifest values are the serialized form `gsettings get` prints, so the
# two sides compare byte for byte.
while read -r schema key want; do
    # shellcheck disable=SC2046 # the option is two words on purpose
    live=$(/usr/bin/gsettings $(schema_dir_opt "$schema") get "$schema" "$key" 2>/dev/null)
    if [[ "$live" == "$want" ]]; then
        ok "$schema $key = $want"
    else
        bad "$schema $key is ${live:-unreadable}, manifest says $want"
    fi
done < <(read_list "$BLUEFIN/gnome-settings.txt")

echo ""
echo "Git state:"
drift=$(cd "$DOTFILES" && git status --porcelain)
if [[ -n "$drift" ]]; then
    bad "uncommitted changes:"
    sed 's/^/      /' <<< "$drift"
    echo "  Review and commit the specific files (never git add -A)."
else
    ok "working tree clean"
fi

echo ""
echo "User lingering (bootstrap.sh setup_upkeep_timer):"
if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" == "yes" ]]; then
    ok "on"
else
    bad "off; user timers stop at logout. Run: loginctl enable-linger \"\$USER\""
fi

echo ""
check_initiatives

echo ""
check_work

echo ""
check_proton

echo ""
echo "Claude Code tooling (claude/tooling manifests):"
if command -v claude-tooling-sync >/dev/null 2>&1; then
    claude-tooling-sync verify | sed 's/^/  /' || fail=1
else
    bad "claude-tooling-sync not on PATH (stow bin)"
fi

[[ "$fail" -eq 0 ]] && echo "check-drift: clean" || echo "check-drift: DRIFT FOUND"
exit "$fail"
