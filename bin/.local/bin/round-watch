#!/usr/bin/env python3
"""Wake a round's conductor when one of its passes changes state.

A conductor runs this as a background Bash command, and the harness re-invokes
the conductor when it exits (pass-core references/conductor.md "Run").

    round-watch <session-prefix> <owner/repo> <branch-prefix>

It records the round's sessions (`claude agents --json --all`, names that
start with the session prefix) and its open pull requests (`gh pr list`,
branches that start with the branch prefix) when it starts. It then polls, and
exits 0 with the changed lines once the record differs and no session of the
round is working. A change while a session works is that session's business,
so the watch stays up. A command that fails keeps its last reading, so a
dropped network link never reads as a change. Prefixes that match no session
and no pull request exit 4 at once, since such a watch could never fire.

Test hooks: ROUND_WATCH_EVERY (seconds between polls, default 120) and
ROUND_WATCH_POLLS (give up with exit 3 after this many polls, default never).
"""

import json
import os
import subprocess
import sys
import time

FAILED = {"FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE"}


def run_json(argv):
    """Return a command's stdout parsed as JSON, or None when it fails."""
    try:
        out = subprocess.run(argv, capture_output=True, text=True, timeout=90, check=True).stdout
        return json.loads(out)
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def session_lines(prefix):
    """Return one line per session of the round, or None when the list can't be read."""
    rows = run_json(["claude", "agents", "--json", "--all"])
    if not isinstance(rows, list):
        return None
    return sorted(
        f"session {r.get('name')} {r.get('id')} {r.get('state')}"
        for r in rows
        if isinstance(r, dict) and str(r.get("name") or "").startswith(prefix)
    )


def checks(rollup):
    """Reduce a pull request's check list to none, pending, fail, or pass."""
    if not rollup:
        return "none"
    pending = failed = False
    for c in rollup:
        result = c.get("conclusion") or c.get("state") or ""
        if c.get("status", "COMPLETED") != "COMPLETED" or result in ("", "PENDING", "EXPECTED"):
            pending = True
        elif result in FAILED:
            failed = True
    if failed:
        return "fail"
    return "pending" if pending else "pass"


def pull_lines(repo, branch_prefix):
    """Return one line per open pull request of the round, or None on a failed read."""
    fields = "number,isDraft,headRefName,headRefOid,statusCheckRollup"
    rows = run_json(["gh", "pr", "list", "-R", repo, "--state", "open", "--limit", "100", "--json", fields])
    if not isinstance(rows, list):
        return None
    return sorted(
        f"pr #{r['number']} {r['headRefName']} {'draft' if r.get('isDraft') else 'ready'} "
        f"{str(r.get('headRefOid'))[:9]} checks {checks(r.get('statusCheckRollup'))}"
        for r in rows
        if str(r.get("headRefName") or "").startswith(branch_prefix)
    )


def main(argv):
    """Poll until the round's record changes with no session working."""
    if len(argv) != 4 or argv[1] in ("-h", "--help"):
        print("usage: round-watch <session-prefix> <owner/repo> <branch-prefix>", file=sys.stderr)
        return 2
    prefix, repo, branch_prefix = argv[1:]
    every = float(os.environ.get("ROUND_WATCH_EVERY", "120"))
    polls = int(os.environ.get("ROUND_WATCH_POLLS", "0"))

    first = {"sessions": None, "pulls": None}
    last = dict(first)
    count = 0
    while True:
        for key, read in (("sessions", session_lines(prefix)), ("pulls", pull_lines(repo, branch_prefix))):
            if read is not None:
                last[key] = read
                if first[key] is None:
                    first[key] = read
        if first["sessions"] == [] and first["pulls"] == []:
            print(f"round-watch: no session named {prefix}* and no open pull request on {branch_prefix}*", file=sys.stderr)
            return 4
        working = any(line.endswith(" working") for line in last["sessions"] or [])
        before = (first["sessions"] or []) + (first["pulls"] or [])
        now = (last["sessions"] or []) + (last["pulls"] or [])
        if before != now and not working:
            for line in before:
                if line not in now:
                    print(f"was: {line}")
            for line in now:
                if line not in before:
                    print(f"now: {line}")
            return 0
        count += 1
        if polls and count >= polls:
            return 3
        time.sleep(every)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
