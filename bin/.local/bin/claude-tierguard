#!/usr/bin/env bash
# PreToolUse guard: rpm-ostree install is allowed only for packages listed in
# ~/.dotfiles/bluefin/layered-packages.txt. No-op on machines without rpm-ostree.
# Only an rpm-ostree in command position counts: heredoc bodies that do not feed a shell are
# dropped first, so prose about layering in a file being written never trips the guard.
set -euo pipefail

cmd=$(jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
[[ "$cmd" == *rpm-ostree*install* ]] || exit 0
command -v rpm-ostree >/dev/null 2>&1 || exit 0

# Drop each heredoc body unless the line that opens it runs a shell (bash, sh, eval, source, ssh).
cmd=$(awk '
  delim != "" { if ($0 ~ "^[[:space:]]*" delim "[[:space:]]*$") delim = ""; next }
  { print }
  match($0, /(^|[^<])<<-?[[:space:]]*["'\'']?[A-Za-z_][A-Za-z0-9_]*/) {
    opener = substr($0, 1, RSTART)
    word = substr($0, RSTART, RLENGTH)
    sub(/^[^<]?<<-?[[:space:]]*["'\'']?/, "", word)
    if (opener !~ /(^|[[:space:];&|(])((ba|z|da|k)?sh|eval|source|ssh)([[:space:]]|$)/) delim = word
  }
' <<< "$cmd")
grep -qE '(^|[;&|({!`]|\$\()[[:space:]]*(sudo([[:space:]]+-[^[:space:]]+)*[[:space:]]+)?rpm-ostree[[:space:]]' <<< "$cmd" || exit 0

list="$HOME/.dotfiles/bluefin/layered-packages.txt"

deny() {
  jq -n --arg reason "$1" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: $reason
    }
  }'
  exit 0
}

[[ -f "$list" ]] || deny "layered-packages.txt not found at $list. Restore the dotfiles bluefin artifacts before layering anything."

# Allowlist contents, minus comment and blank lines. An all-comment list reads
# as empty, which denies everything; that is the intended fail-closed behavior.
allowed=$(grep -vE '^[[:space:]]*(#|$)' "$list" || true)

# Collect non-flag arguments after the install verb. $cmd is deliberately
# unquoted here so the command string splits into words; set -f keeps a glob
# character in the command from expanding against the cwd. A chain separator
# ends the install command's own arguments, so scanning stops there instead
# of denying on the next command's words.
seen_ostree=0
seen_install=0
unlisted=()
set -f
for word in $cmd; do
  if [[ $seen_ostree -eq 0 ]]; then
    [[ "$word" == "rpm-ostree" ]] && seen_ostree=1
    continue
  fi
  if [[ $seen_install -eq 0 ]]; then
    # The install verb is rpm-ostree's first non-flag word; any other verb ends this match.
    [[ "$word" == -* ]] && continue
    if [[ "$word" == "install" ]]; then seen_install=1; else seen_ostree=0; fi
    continue
  fi
  case "$word" in
    '&&'|'||'|';'|'|') break ;;
  esac
  [[ "$word" == -* ]] && continue
  if ! grep -qx "$word" <<< "$allowed"; then
    unlisted+=("$word")
  fi
done
set +f

if [[ ${#unlisted[@]} -gt 0 ]]; then
  deny "Package(s) not in layered-packages.txt: ${unlisted[*]}. The layered set stays minimal by policy. To add one: record it with a reason in ~/.dotfiles/docs/MIGRATION-BRIEF.md, add it to layered-packages.txt, commit, then retry. Prefer brew (CLI), flatpak (GUI), or mise/uv (runtimes) if the package fits a higher tier."
fi

exit 0
