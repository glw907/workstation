#!/usr/bin/env python3
"""PreToolUse hook keeping Claude's Bash away from Proton Pass and the paths that hold its keys.

Claude runs as Geoff's UID, so anything a logged-in pass-cli session can read, Claude's Bash
tool could read silently. Claude reaches Proton Pass only through claude-pass, which runs one
command as Claude's own <host>-claude agent, an editor on the vaults Geoff has granted it (his
ruling of 2026-10-20). The other reviewed scripts (ws-pass-key, secret-receive --pass) own the
age key and Geoff's own reads. This hook denies the direct routes, which would act as Geoff's
own login and reach every vault:

- pass-cli in command position, since a user session can mint tokens and read any vault. A glob
  or brace there (p*-cli, {pass-cli,}) counts when it could expand to the name;
- secret-tool lookup and search, which print the agent tokens held in GNOME Keyring;
- keyctl print, pipe, and read, which dump the kernel keyring pass-cli keeps its key in;
- any mention of a pass-cli session directory (pass-ws.*, pass-recv.*, pass-count.*,
  pass-sitting.*, claude-pass's pass-agent.*, the default ~/.local/share/proton-pass-cli). A
  session name is the prefix and a dot with no later dot-and-letter in the same path component
  (a variable, a glob, or a mktemp tail all count), or a bare prefix such as pass-ws/. So a
  file with an extension, such as tests/pass-count.test.sh, passes;
- pass-sitting in command position, in every form (bare, by path, after a wrapper, or as the
  script of bash, sh, source, or a dot; `bash -n` only checks syntax and passes). A line that
  names a .../pass-sitting path and puts a shell in command position anywhere is refused too,
  which covers a pipe, a process substitution, and stdin. Geoff alone
  runs pass-sitting under his own login, and the refusal says so: Claude writes the sitting
  file and Geoff runs it.

claude-pass itself passes, because its command text names neither pass-cli nor a session
directory, and it runs only its allowlisted subcommands (item, vault, folder, share, password,
totp, info, user). This hook also treats `claude-pass run` as a wrapper, so a pass-cli placed
after it is still denied.

There is no allowance: the agent token pops up no prompt, so a rate
limit would protect nothing. A mention inside a quoted argument (a commit message, an echo)
is not a command and passes. A (, ), |, &, or ; inside quoted text is plain text too, so a quoted
grep pattern is never read as a pipeline, unless the command holds a word that could run that
text as shell code: a wrapper, a shell, eval, ssh, su -c, script -c, find -exec, claude-pass run,
or an interpreter's -c or -e. Then the scan reads every quoted separator as syntax.

This is a guardrail, not a boundary: Claude runs as the same UID, so an indirect call
(PC=pass-cli; $PC info) or another interpreter gets past any regex. A heredoc body is
dropped unless the heredoc feeds a shell (bash, sh, eval, source, ssh, before or after the <<), so a script written with
`cat > file <<EOF` or a `python3 - <<EOF` edit may mention pass-cli. `command -v pass-cli` only
looks the name up, and a backslash-escaped bar in a grep pattern is not a pipe. Known false positives: a
line that starts with pass-cli inside a multi-line quoted message, and a plain grep for the
session-directory names.
"""

import codecs
import fnmatch
import json
import re
import sys

DENY_REASON = (
    "Proton Pass access denied: Claude reaches Proton Pass only through claude-pass, its own "
    "agent (claude-pass item list --vault-name Infrastructure; a value goes in on stdin with "
    "claude-pass item create login --from-template -). Claude never calls pass-cli directly, "
    "reads an agent token (secret-tool lookup), dumps the kernel keyring (keyctl "
    "print/pipe/read), or opens a pass-cli session directory. Use ws-pass-key for the age key, "
    "secret-set.sh and sync.sh for the store, or ask Geoff to run secret-receive --pass for a "
    "vault the claude agent cannot reach."
)

SITTING_REASON = (
    "pass-sitting denied: Geoff alone runs pass-sitting, under his own Proton login, in a Ptyxis "
    "terminal. Claude writes the sitting file (a JSON-lines list of moves, renames, notes, "
    "trashes, grants, and revokes) and tells Geoff the two commands to run: pass-sitting FILE for "
    "the dry run, then pass-sitting --apply FILE. For Claude's own reads and writes use "
    "claude-pass."
)

# A command starts at the line start or after a shell separator or keyword, behind variable
# assignments and the wrappers that pass a command through (each with options that may take a
# value, and timeout's duration). An absolute or $(...)-built path to the binary counts.
SEP = r"(?:^|(?<!\\)[;&|(`{!\n)]|\$\()\s*(?:(?:if|then|else|elif|do|while|until|coproc)\s+)*"
ASSIGN = r"(?:\w+=\S*\s+)*"
OPTS = r"(?:-\S+\s+(?:[^-\s]\S*\s+)?)*"
WRAP = (
    r"(?:(?:sudo|doas|env|nohup|time|exec|command|nice|ionice|timeout|xargs|eval|watch|stdbuf|setsid|flock"
    r"|strace|unbuffer|builtin|claude-pass\s+run|(?:busybox\s+)?(?:ba|z|da|k)?sh\s+(?:-\S+\s+)*?-\w*c)\s+" + OPTS + r"(?:\d+\S*\s+)?" + ASSIGN + r")*"
)
BIN = r"(?:\$\([^)]*\)[^\s;&|]*/|[^\s;&|]*/)?"
# A redirection may come before the command name, and a redirect may touch the name.
REDIR = r"(?:\d*[<>]+&?[^\s;&|]*\s*)*"
NAMEEND = r"(?=[\s<>&;|)$`]|$)"
START = SEP + ASSIGN + REDIR + WRAP + BIN
END = r"(?=[/\s;&|)<>`]|$)"
PATTERNS = [
    re.compile(START + r"pass-cli" + NAMEEND),
    # A glob or brace in command position that could expand to pass-cli.
    re.compile(START + r"pass-c[\w-]*[*?\[{]"),
    re.compile(START + r"secret-tool" + NAMEEND + r"\s*" + REDIR + OPTS + r"(?:lookup|search)\b"),
    re.compile(START + r"keyctl" + NAMEEND + r"\s*" + REDIR + OPTS + r"(?:print|pipe|read)\b"),
    re.compile(
        r"(?<![\w-])pass-(?:"
        # A session name is the prefix and a dot, then a suffix with no later dot-and-letter in
        # the same path component (a variable, a glob, or a mktemp tail all qualify). A file
        # with an extension, such as pass-count.test.sh, is not one.
        r"(?:ws|recv|count|agent|sitting)\.(?![^\s/;&|)<>`]*\.[A-Za-z])"
        # The bare pass-ws prefix, and a glob that could name any session directory.
        r"|ws(?:[*?\[]|" + END + r")|[*?\[{]|(?:w|r|re|rec|recv|c|co|cou|coun|count|a|ag|age|agen|agent|s|si|sit|sitt|sitti|sittin|sitting)[*?\[{])"
        r"|\.local/share/proton[-*?\[]|share/proton-pass-[*?c]"
    ),
    # A glob on the session prefix itself (pas?-agent.x, *-agent.*), with the same extension rule.
    re.compile(
        r"(?<![\w-])[\w-]*[*?\[{][\w*?\[\]{},-]*-(?:ws|recv|count|agent|sitting)\."
        r"(?![^\s/;&|)<>`]*\.[A-Za-z])"
    ),
]

# Geoff alone runs pass-sitting, so Claude's Bash never does, in any form. A shell reading the
# file counts, except `bash -n`, which only checks syntax.
SITTING_NAME = r"pass-sitting(?=[\s;&|)<>`$]|$)"
SHELL_CMD = (
    SEP + ASSIGN + WRAP + BIN
    + r"(?:busybox\s+)?(?:(?:r?ba|z|da|k)?sh|source|\.)(?!\s+-n\b(?![^;&|\n]*\s\+))(?=\s|$)"
)
# The script name as a whole word, with or without a directory.
SITTING_WORD = r"(?:^|[\s/<(=])" + SITTING_NAME
SITTING_PATTERNS = [
    re.compile(START + r"(?:" + SITTING_NAME + r"|pass-s[\w-]*[*?\[{])"),
    re.compile(
        SEP + ASSIGN + WRAP + r"(?:busybox\s+)?" + BIN + r"(?:(?:ba|z|da|k)?sh|source|\.)\s+"
        r"(?:-[oO]\s+\S+\s+|-(?!n\b)\S*\s+)*(?:<\s*)?(?:[^\s;&|]*/)?" + SITTING_NAME
    ),
    # `bash -n +o noexec FILE` and `bash -n +n FILE` run the file: any + option turns a flag off.
    re.compile(r"(?:ba|z|da|k)?sh\s+[^;&|\n]*\+\S*[^;&|\n]*" + SITTING_NAME),
    # A shell in command position anywhere on a line that names pass-sitting as a word: the
    # path may reach the shell through a pipe, a process substitution, or stdin. A false positive
    # costs nothing, since only Geoff runs pass-sitting. `bash -n` only checks syntax and passes.
    re.compile(
        r"(?:" + SHELL_CMD + r"[^\n]*" + SITTING_WORD + r"|" + SITTING_WORD + r"[^\n]*" + SHELL_CMD + r")"
    ),
]


COMMAND_WORD = re.compile(START + r"(?P<word>[^\s;&|()<>`]+)")
TOKEN = re.compile(r"[^\s;&|()<>`]+")
GLOB_CHARS = re.compile(r"[*?\[\]{}]")
BRACKET = re.compile(r"\[!?\]?[^\]]*\]")


def expand_braces(word, limit=64):
    """Return the words a {a,b} group expands to, nested groups included, capped at limit."""
    start = word.find("{")
    if start < 0:
        return [word]
    depth, commas = 0, []
    for i in range(start, len(word)):
        if word[i] == "{":
            depth += 1
        elif word[i] == "," and depth == 1:
            commas.append(i)
        elif word[i] == "}":
            depth -= 1
            if depth == 0:
                if not commas:
                    return [word]
                bounds = [start] + commas + [i]
                out = []
                for a, b in zip(bounds, bounds[1:]):
                    out += expand_braces(word[:start] + word[a + 1 : b] + word[i + 1 :], limit)
                return out[:limit]
    return [word]


def glob_names(word, names):
    """Return True when a glob or brace word's basename could expand to one of names.

    The basename needs four literal characters, so a bare * or *.md never counts. A bracket
    expression such as [a-z-] matches one character, so its letters are not literal.
    """
    if not GLOB_CHARS.search(word):
        return False
    for candidate in expand_braces(word.rsplit("/", 1)[-1]):
        if len(GLOB_CHARS.sub("", BRACKET.sub("", candidate))) >= 4 and any(
            fnmatch.fnmatchcase(name, candidate) for name in names
        ):
            return True
    return False


def command_glob(cmd, names):
    """Return True when a command-position word is a glob that could expand to one of names."""
    return any(glob_names(m.group("word"), names) for m in COMMAND_WORD.finditer(cmd))


BREW_SEGMENT = re.compile(r"^\s*(?:\w+=\S*\s+)*(?:[^\s;&|]*/)?brew(?:\s|$)")


def default_session_named(cmd):
    """Return True when a token names the default session directory, proton-pass-cli.

    A bare name counts only after a cd or pushd, and never in a brew command, where it names
    the package (Geoff, 2026-11-16: Claude upgrades anything through brew).
    """
    moved = re.search(r"(?:^|[\s;&|(])(?:cd|pushd)\s", cmd) is not None
    for segment in re.split(r"[;&|\n(]", cmd):
        brew = BREW_SEGMENT.match(segment) is not None
        for token in TOKEN.findall(segment):
            if re.search(r"/proton-pass-cli(?![\w-])|(?<![\w-])proton-pass-cli/", token):
                return True
            if moved and not brew and token == "proton-pass-cli":
                return True
            if glob_names(token, ["proton-pass-cli"]):
                return True
    return False


HEREDOC = re.compile(r"(?<![<\\])<<-?\s*(['\"]?)([A-Za-z_]\w*)\1")
SHELL_FEED = re.compile(r"(?:^|[\s;&|(/])(?:(?:ba|z|da|k)?sh|eval|source|ssh)(?:\s|$)")
LOOKUP = re.compile(r"\bcommand\s+-[vV]\b")


def real_heredoc(prefix):
    """Return True when a << sits outside a comment, a quote, and arithmetic, so it can open a heredoc.

    A fake start would hide every later line from the patterns, so any doubt keeps the body.
    """
    return (
        prefix.count("'") % 2 == 0
        and prefix.count('"') % 2 == 0
        and "#" not in prefix
        and "((" not in prefix
        and "$[" not in prefix
        and "${" not in prefix
    )


def strip_heredocs(cmd):
    """Drop the body of each heredoc that does not feed a shell, so file text is not a command."""
    kept = []
    delimiter = None
    for line in cmd.split("\n"):
        if delimiter is not None:
            if line.strip() == delimiter:
                delimiter = None
            continue
        kept.append(line)
        found = HEREDOC.search(line)
        if found and real_heredoc(line[: found.start()]):
            feeds_shell = SHELL_FEED.search(line[: found.start()]) or SHELL_FEED.search(line[found.end() :])
            if not feeds_shell:
                delimiter = found.group(2)
    return "\n".join(kept)


def decode_ansi_c(match):
    """Return the text a $'...' span expands to, so an escaped name reads as the plain name."""
    try:
        text = codecs.decode(match.group(1).encode("latin-1", "backslashreplace"), "unicode_escape")
    except (UnicodeError, ValueError):
        return match.group(1)
    return text.replace("\n", " ")


def normalize(cmd):
    """Undo the quoting tricks that hide a command name from the patterns.

    ANSI-C quoting ($'...') is decoded first, so hex and octal escapes spell the plain name. Line
    continuations, empty quote pairs, backslash escapes, and quote characters are removed, so a
    quoted name, a name split by an empty quote pair, and a backslash-escaped name all read as
    the plain command.
    """
    cmd = re.sub(r"\$'((?:[^'\\]|\\.)*)'", decode_ansi_c, cmd)
    cmd = cmd.replace("\\\n", "")
    cmd = re.sub(r"''|\"\"", "", cmd)
    cmd = re.sub(r"\\(?=\w)", "", cmd)
    cmd = re.sub(r"\$(?=['\"])", "", cmd)
    return cmd.replace("'", "").replace('"', "")


# A word that runs a string or a file as shell code, which turns a quoted separator back into
# syntax. Any of them anywhere in the command, quotes removed, keeps the strict scan: the WRAP
# wrappers and a shell in command position, and these words wherever they stand.
SHELL_WORDS = [
    re.compile(SEP + ASSIGN + REDIR + WRAP + BIN + r"(?:sudo|doas|env|nohup|time|exec|command|nice|ionice"
               r"|timeout|xargs|eval|watch|stdbuf|setsid|flock|strace|unbuffer|builtin|source"
               r"|(?:busybox\s+)?(?:r?ba|z|da|k)?sh)" + NAMEEND),
    re.compile(r"(?<![\w.-])(?:eval|ssh|xargs|claude-pass\s+run)(?![\w-])"),
    re.compile(r"(?<![\w.-])(?:busybox\s+)?(?:r?ba|z|da|k)?sh\s+(?:\S+\s+)*?-\w*c"),
    re.compile(r"(?<![\w.-])(?:su|script)\s+(?:\S+\s+)*?-\w*c"),
    re.compile(r"(?<![\w.-])(?:python[\d.]*|perl|ruby|node|osascript)\s+(?:\S+\s+)*?-\w*[ce]\b"),
    re.compile(r"(?<![\w.-])find\s[^\n]*-exec"),
]


def runs_shell(cmd):
    """Return True when the command holds a word that could run quoted text as shell code."""
    plain = normalize(cmd)
    return any(p.search(plain) for p in SHELL_WORDS)


def plain_quoted_separators(cmd):
    """Blank (, ), |, &, and ; inside quoted text, so a quoted pattern is never read as a pipeline.

    A $(...) or backtick span inside double quotes runs, so its text stays live; `stack` holds
    the open spans (a paren depth for $(, or a backtick marker). An ANSI-C $'...' span honors
    backslash escapes, and a plain single-quoted span does not.
    """
    out = list(cmd)
    index, quote = 0, ""
    stack = []
    while index < len(out):
        char = out[index]
        if char == "\\" and quote in ("", '"', "$'"):
            index += 2
            continue
        if stack and not quote:
            if stack[-1] == "`" and char == "`":
                stack.pop()
                quote = '"'
                index += 1
                continue
            if stack[-1] != "`" and char in "()":
                stack[-1] += 1 if char == "(" else -1
                if stack[-1] == 0:
                    stack.pop()
                    quote = '"'
                    index += 1
                    continue
        if quote == '"' and char == "$" and cmd[index + 1:index + 2] == "(":
            stack.append(1)
            quote = ""
            index += 2
            continue
        if quote == '"' and char == "`":
            stack.append("`")
            quote = ""
            index += 1
            continue
        if quote:
            if char == quote[-1]:
                quote = ""
            elif char in "()|&;":
                out[index] = " "
        elif char == "$" and cmd[index + 1:index + 2] == "'":
            quote = "$'"
            index += 1
        elif char in "'\"":
            quote = char
        index += 1
    return "".join(out)


def main():
    """Deny a Bash command that reaches Proton Pass; allow everything else."""
    try:
        data = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0
    if data.get("tool_name") != "Bash":
        return 0
    cmd = (data.get("tool_input") or {}).get("command", "")
    cmd = LOOKUP.sub("type", strip_heredocs(cmd))
    cmd = normalize(cmd if runs_shell(cmd) else plain_quoted_separators(cmd))
    if any(p.search(cmd) for p in SITTING_PATTERNS) or command_glob(cmd, ["pass-sitting"]):
        reason = SITTING_REASON
    elif any(p.search(cmd) for p in PATTERNS) or command_glob(cmd, ["pass-cli"]) or default_session_named(cmd):
        reason = DENY_REASON
    else:
        return 0
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
