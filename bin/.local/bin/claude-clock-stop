#!/usr/bin/env bash
# claude-clock-stop: Claude Code PostToolUse hook that stops a pass task running past twice its
# estimate (lean pass process spec, Execution item 6; Geoff's ruling 13).
#
# The session writes .pass-task-clock at its pass worktree's root at each task start: three lines,
# task=<id>, start=<epoch seconds>, estimate=<minutes>. The name sits in the global git excludes
# (bluefin/git-excludes), so the gate fingerprint holds. The worktree root is the home because a
# worktree-isolated session's guard always refuses the Write tool under .git and refuses many Bash
# forms. A pass-task-clock in the git dir, the old home, still counts for a run already under way.
# The hook resolves both from the hook input's cwd, which follows a `cd` and is the worktree root
# after EnterWorktree, so a cwd below the root finds the file too. Once elapsed time passes twice the
# estimate, it prints one JSON object whose additionalContext tells the session to write STATUS,
# notify, and wait, once per task: a record under ${XDG_STATE_HOME:-$HOME/.local/state}/claude-clock-stop/,
# keyed on the worktree root, task, and start, silences repeats, and nothing lands in the worktree.
# Every other case prints nothing: no file, under the threshold, a malformed
# file, a non-git cwd, a missing tool. It runs after every tool call, so it never exits non-zero.
{
  input=$(cat)
  cwd=$(jq -r '.cwd // empty' <<<"$input" 2>/dev/null)
  [ -n "$cwd" ] || exit 0
  root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || exit 0
  file="$root/.pass-task-clock"
  [ -f "$file" ] || file="$(git -C "$cwd" rev-parse --absolute-git-dir 2>/dev/null)/pass-task-clock"
  [ -f "$file" ] || exit 0
  task=$(sed -n 's/^task=//p' "$file" | head -n 1)
  start=$(sed -n 's/^start=//p' "$file" | head -n 1)
  estimate=$(sed -n 's/^estimate=//p' "$file" | head -n 1)
  [ -n "$task" ] || exit 0
  [[ "$start" =~ ^[0-9]+$ ]] || exit 0
  [[ "$estimate" =~ ^[0-9]+$ ]] && [ "$estimate" -gt 0 ] || exit 0
  elapsed=$(( ($(date +%s) - start) / 60 ))
  [ "$elapsed" -gt $((estimate * 2)) ] || exit 0
  state="${XDG_STATE_HOME:-$HOME/.local/state}/claude-clock-stop"
  key=$(printf '%s\n%s\n%s' "$root" "$task" "$start" | sha256sum | cut -d' ' -f1)
  [ ! -e "$state/$key" ] || exit 0
  mkdir -p "$state" && : >"$state/$key" || exit 0
  msg="Clock stop: task $task has run $elapsed minutes against a $estimate-minute estimate. Write STATUS, run \`notify-send -u normal\`, and wait for Geoff (ruling 13)."
  jq -nc --arg m "$msg" '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $m}}'
} 2>/dev/null
exit 0
