#!/usr/bin/env bash
# Receive a secret from Geoff without it transiting a Claude Code
# transcript, tool output, or shell history. Default mode raises a
# desktop password dialog (claude-askpass pattern); --op fetches from
# 1Password instead. Either way the value is piped straight into
# secret-set.sh --stdin, so it exists only in this process and the
# age store.
#
# Usage:
#   secret-receive NAME              # zenity dialog, paste the value
#   secret-receive NAME --hint TEXT  # extra dialog line: what to paste, expected shape
#   secret-receive NAME --op REF     # op read REF (e.g. op://vault/item/field)
#   secret-receive NAME --values PATH --local PATH
#                                    # store into this worktree's store and overlay, not the
#                                    #   main checkout's store and ~/.local/secrets
#
# Single-line values only; for PEMs and other multi-line material use
# secret-set.sh NAME --b64-file directly.
set -euo pipefail

SECRET_SET="$HOME/.dotfiles/scripts/secrets/secret-set.sh"
LOCAL_SECRETS="$HOME/.local/secrets"

die() { echo "secret-receive: $*" >&2; exit 1; }

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

NAME="${1:-}"
[[ "$NAME" == "-h" || "$NAME" == "--help" ]] && usage
[[ -n "$NAME" ]] || die "usage: secret-receive NAME [--op REF]"
[[ "$NAME" =~ ^[A-Z][A-Z0-9_]*$ ]] || die "NAME must be UPPER_SNAKE_CASE"
[[ -x "$SECRET_SET" ]] || die "$SECRET_SET not found or not executable"

HINT=""
OP_REF=""
SET_ARGS=()
shift
while [[ $# -gt 0 ]]; do
    case "$1" in
        --hint) HINT="${2:?--hint needs text}"; shift 2 ;;
        --op)   OP_REF="${2:?--op needs a reference like op://vault/item/field}"; shift 2 ;;
        --values) SET_ARGS+=(--values "${2:?--values needs a path}"); shift 2 ;;
        --local)  LOCAL_SECRETS="${2:?--local needs a path}"; SET_ARGS+=(--local "$LOCAL_SECRETS"); shift 2 ;;
        *)      die "unknown option: $1" ;;
    esac
done

if [[ -n "$OP_REF" ]]; then
    command -v op >/dev/null || die "op CLI not installed"
    VAL="$(op read "$OP_REF")" || die "op read failed; nothing stored"
else
    command -v zenity >/dev/null || die "zenity not installed"
    # --entry --hide-text instead of --password: the bare password
    # dialog reads as a system login prompt and invites a reflex
    # password entry instead of the intended paste.
    # The --entry dialog renders --text as plain text, not Pango markup.
    # Body carries only what the paste moment needs: the hint, or the
    # variable name when no hint is given.
    TEXT="${HINT:-Paste the value for $NAME.}"
    VAL="$(zenity --entry --hide-text --title "Store a secret" \
        --ok-label "Store" --text "$TEXT" --timeout 300 2>/dev/null)" ||
        die "dialog cancelled or timed out; nothing stored"
fi

[[ -n "$VAL" ]] || die "empty value; nothing stored"

# Length is safe to reveal and lets a wrong-shaped value (a typed
# password where a 64-char token belongs) surface immediately.
LEN=${#VAL}
printf '%s\n' "$VAL" | "$SECRET_SET" "$NAME" --stdin "${SET_ARGS[@]}"
unset VAL

grep -q "^export ${NAME}=" "$LOCAL_SECRETS" ||
    die "stored, but $NAME missing from ~/.local/secrets; run secret-set.sh --sync"
echo "secret-receive: $NAME stored and exported (${LEN} chars, value not shown)."
echo "Remember: document scope + rotation in ~/.dotfiles/secrets/registry.md"
