#!/usr/bin/env bash
# Receive a secret from Geoff without it transiting a Claude Code
# transcript, tool output, or shell history. Default mode raises a
# desktop password dialog (claude-askpass pattern); --pass fetches from
# Proton Pass and --op from 1Password instead. Either way the value is
# piped straight into secret-set.sh --stdin, so it exists only in this
# process and the age store.
#
# Usage:
#   secret-receive NAME              # zenity dialog, paste the value
#   secret-receive NAME --hint TEXT  # extra dialog line: what to paste, expected shape
#   secret-receive NAME --pass REF   # pass-cli item view REF (e.g. pass://vault/item/field),
#                                    #   after a web login into a throwaway tmpfs session that
#                                    #   is logged out and removed on exit
#   secret-receive NAME --op REF     # op read REF (e.g. op://vault/item/field)
#   secret-receive NAME --values PATH --local PATH
#                                    # store into this worktree's store and overlay, not the
#                                    #   main checkout's store and ~/.local/secrets
#
# Single-line values only; for PEMs and other multi-line material use
# secret-set.sh NAME --b64-file directly.
set -euo pipefail

SECRET_SET="$HOME/.dotfiles/scripts/secrets/secret-set.sh"
LOCAL_SECRETS="$HOME/.local/secrets"

die() { echo "secret-receive: $*" >&2; exit 1; }

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

NAME="${1:-}"
[[ "$NAME" == "-h" || "$NAME" == "--help" ]] && usage
[[ -n "$NAME" ]] || die "usage: secret-receive NAME [--pass REF | --op REF]"
[[ "$NAME" =~ ^[A-Z][A-Z0-9_]*$ ]] || die "NAME must be UPPER_SNAKE_CASE"
[[ -x "$SECRET_SET" ]] || die "$SECRET_SET not found or not executable"

# A --values or --local path must be given once and hold no "..", so a rule that allows a
# worktree prefix cannot be steered to the main checkout's store.
flag_path() {
    [[ -n "$2" && "$2" != --* ]] || die "$1 needs a path"
    [[ "$2" != *..* ]] || die "$1 path may not contain '..': $2"
    printf '%s' "$2"
}

HINT=""
OP_REF=""
PASS_REF=""
SET_ARGS=()
SAW_VALUES=""
SAW_LOCAL=""
shift
while [[ $# -gt 0 ]]; do
    case "$1" in
        --hint) HINT="${2:?--hint needs text}"; shift 2 ;;
        --pass) PASS_REF="${2:?--pass needs a reference like pass://vault/item/field}"; shift 2 ;;
        --op)   OP_REF="${2:?--op needs a reference like op://vault/item/field}"; shift 2 ;;
        --values) [[ -z "$SAW_VALUES" ]] || die "--values given twice (repeated flag refused)"
                  SAW_VALUES=1; P="$(flag_path --values "${2:-}")" || exit 1; SET_ARGS+=(--values "$P"); shift 2 ;;
        --local)  [[ -z "$SAW_LOCAL" ]] || die "--local given twice (repeated flag refused)"
                  SAW_LOCAL=1; P="$(flag_path --local "${2:-}")" || exit 1; LOCAL_SECRETS="$P"; SET_ARGS+=(--local "$P"); shift 2 ;;
        *)      die "unknown option: $1" ;;
    esac
done

[[ -z "$PASS_REF" || -z "$OP_REF" ]] || die "--pass and --op are exclusive"

if [[ -n "$PASS_REF" ]]; then
    command -v pass-cli >/dev/null || die "pass-cli not installed"
    [[ -n "${XDG_RUNTIME_DIR:-}" ]] || die "XDG_RUNTIME_DIR is not set; no tmpfs for a session"
    # A user session can mint credentials, so it never sits in the default session directory: this
    # one lives in tmpfs and is logged out and removed however the script ends.
    PASS_SESSION="$(mktemp -d "$XDG_RUNTIME_DIR/pass-recv.XXXXXX")"
    export PROTON_PASS_SESSION_DIR="$PASS_SESSION"
    export PROTON_PASS_DISABLE_TELEMETRY=1
    trap 'pass-cli logout >/dev/null 2>&1 || true; rm -rf "$PASS_SESSION"' EXIT
    echo "secret-receive: log in to Proton Pass in the browser when asked." >&2
    pass-cli login >&2 || die "pass-cli login failed; nothing stored"
    VAL="$(pass-cli item view "$PASS_REF")" || die "pass-cli item view failed; nothing stored"
elif [[ -n "$OP_REF" ]]; then
    command -v op >/dev/null || die "op CLI not installed"
    VAL="$(op read "$OP_REF")" || die "op read failed; nothing stored"
else
    command -v zenity >/dev/null || die "zenity not installed"
    # --entry --hide-text instead of --password: the bare password
    # dialog reads as a system login prompt and invites a reflex
    # password entry instead of the intended paste.
    # The --entry dialog renders --text as plain text, not Pango markup.
    # Body carries only what the paste moment needs: the hint, or the
    # variable name when no hint is given.
    TEXT="${HINT:-Paste the value for $NAME.}"
    VAL="$(zenity --entry --hide-text --title "Store a secret" \
        --ok-label "Store" --text "$TEXT" --timeout 300 2>/dev/null)" ||
        die "dialog cancelled or timed out; nothing stored"
fi

[[ -n "$VAL" ]] || die "empty value; nothing stored"

# Length is safe to reveal and lets a wrong-shaped value (a typed
# password where a 64-char token belongs) surface immediately.
LEN=${#VAL}
printf '%s\n' "$VAL" | "$SECRET_SET" "$NAME" --stdin "${SET_ARGS[@]}"
unset VAL

grep -q "^export ${NAME}=" "$LOCAL_SECRETS" ||
    die "stored, but $NAME missing from $LOCAL_SECRETS; run secret-set.sh --sync"
echo "secret-receive: $NAME stored and exported (${LEN} chars, value not shown)."
echo "Remember: document scope + rotation in ~/.dotfiles/secrets/registry.md"
