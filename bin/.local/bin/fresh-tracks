#!/usr/bin/python3 -I
"""Import new music from the Fresh Tracks share (~/FreshTracks) into ~/Music through beets.

fresh-tracks.path starts it when the inbox changes, and it runs once at login. Music beets
won't take moves to "Not imported/" with a WHY.txt; nothing it skips is deleted. The spec is
docs/specs/2026-11-24-fresh-tracks-design.md.
"""

import ctypes
from dataclasses import dataclass
import errno
import fcntl
import lzma
import os
from pathlib import Path
import re
import shutil
import stat
import struct
import subprocess
import sys
import tarfile
import tempfile
from typing import BinaryIO
import time
import unicodedata
import zipfile
import zlib

WORK = ".fresh-tracks-work"
NOT_IMPORTED = "Not imported"
LOOSE = "Loose tracks"
ARCHIVE_SUFFIXES = (".tar.gz", ".tar.xz", ".tar.bz2", ".tgz", ".tar", ".zip")
# The formats beets reads (mediafile's TYPES). Audio of these kinds still in a work folder
# after an import is what beets skipped.
AUDIO = frozenset(
    ".mp3 .aac .alac .ogg .opus .flac .ape .wv .mpc .asf .wma .aiff .aif .aifc .dsf .wav .wave"
    " .m4a .m4b .m4p .m4r .mp4 .3gp .mpg .mpeg".split()
)
# Audio beets can't read. It is set aside, never deleted with the leftovers.
UNREADABLE = frozenset(".dff .shn .tta .tak .mka .ac3 .dts .ra .caf .au .amr .mp2 .oga .spx .webm".split())
# Archives beets can't import, left in a folder or among loose tracks. Set aside, never deleted.
PACKED = frozenset(".rar .7z .zip .tar .gz .tgz .xz .txz .bz2 .tbz2 .zst".split())
# A part of a split archive: .r00, .z01, .001.
SPLIT = re.compile(r"\.([rz]\d\d|\d{3})$", re.IGNORECASE)
# The suffixes fetchart and coverrule take for cover art, and the first bytes of each raster
# format. ImageMagick and Pillow pick a decoder by content, so PostScript named cover.jpg
# would reach Ghostscript.
IMAGES = frozenset(".jpg .jpeg .png .webp .gif .bmp .tif .tiff".split())
RASTER = (b"\xff\xd8\xff", b"\x89PNG\r\n\x1a\n", b"GIF87a", b"GIF89a", b"BM", b"II*\x00", b"MM\x00*")
MAX_MEMBERS = 10_000
# A Mac writes ._name beside each file it copies, and Finder's zips hold more under __MACOSX.
APPLEDOUBLE = b"\x00\x05\x16\x07"
# tarfile reads a pax or GNU long-name header whole while it reads the next member, so
# check_members() never sees it. A real one is a few hundred bytes.
MAX_HEADER = 1 << 20
LONG_HEADERS = (
    tarfile.GNUTYPE_LONGNAME, tarfile.GNUTYPE_LONGLINK, tarfile.XHDTYPE, tarfile.XGLTYPE,
    tarfile.SOLARIS_XHDTYPE,
)
HEADROOM = 1 << 30
# A set-aside folder's name, in bytes, leaving room for " (n)" under the 255-byte limit.
NAME_BYTES = 240
IN_LIBRARY = "It is already in the library."
REASONS = {
    "skip": "MusicBrainz found no confident match for its tags.",
    # beets logs duplicate-keep for a duplicate that duplicate_action: skip left in place,
    # because log_choice tests the choice before the skip (beets 2.14.1, importer/session.py).
    "duplicate-keep": IN_LIBRARY,
    "duplicate-skip": IN_LIBRARY,
    "duplicate-replace": IN_LIBRARY,
}
WHY_HEADER = "Fresh Tracks didn't import this music. Every track and archive of it is here.\n\n"


@dataclass(frozen=True)
class Config:
    inbox: Path
    beet: Path
    quiet: float
    state: Path

    @property
    def work(self) -> Path:
        return self.inbox / WORK

    @property
    def not_imported(self) -> Path:
        return self.inbox / NOT_IMPORTED


@dataclass
class Item:
    kind: str  # "folder", "archive", or "loose"
    label: str
    sources: list[Path]


class Refused(Exception):
    """An item the importer won't hand to beets; the message is the reason in plain words."""


def load_config() -> Config:
    """Read the paths and the quiet period, which a test overrides through the environment."""
    home = Path.home()
    state_home = Path(os.environ.get("XDG_STATE_HOME") or home / ".local/state")
    return Config(
        inbox=Path(os.environ.get("FRESH_TRACKS_INBOX") or home / "FreshTracks"),
        # The user manager's PATH lacks ~/.local/bin, so beet is called by full path.
        beet=Path(os.environ.get("FRESH_TRACKS_BEET") or home / ".local/bin/beet"),
        quiet=float(os.environ.get("FRESH_TRACKS_QUIET") or 600),
        state=state_home / "fresh-tracks",
    )


# Landlock's syscalls and the rights that change a file system: write a file, then remove
# a folder or file and make a device, folder, file, socket, fifo, or link (bits 4 to 12).
_SYS_CREATE, _SYS_ADD_RULE, _SYS_RESTRICT = 444, 445, 446
_WRITE_RIGHTS = 1 << 1 | 0x1FF0
_REFER, _TRUNCATE = 1 << 13, 1 << 14
# From ABI 6, a run can't reach an abstract socket or signal a process outside its sandbox.
_SCOPE_ABSTRACT_UNIX_SOCKET, _SCOPE_SIGNAL = 1 << 0, 1 << 1


def writable(cfg: Config) -> list[Path]:
    """List the folders a run writes beneath: the inbox, its state, the library, beets' data, and scratch."""
    home = Path.home()
    share = home / ".local/share"
    return [
        cfg.inbox,
        cfg.state,
        home / "Music",
        share / "beets",
        share / "music-cover-originals",
        home / ".cache",
        Path(tempfile.gettempdir()),
        Path("/tmp"),
        Path("/var/tmp"),
        Path("/dev"),
    ]


def confine(folders: list[Path]) -> None:
    """Let this process, and every program it starts, change files only beneath folders.

    Landlock rules follow paths, not mounts, so the inbox and ~/Music stay on one mount and
    beets' move stays a rename. A file that takes over ffmpeg, ImageMagick, or Ghostscript
    then can't plant code in home's top level, such as ~/.bashrc. A folder that doesn't exist
    is skipped. A kernel without Landlock refuses the run.
    """
    libc = ctypes.CDLL(None, use_errno=True)
    libc.syscall.restype = ctypes.c_long

    def call(*args) -> int:
        got = libc.syscall(*args)
        if got < 0:
            err = ctypes.get_errno()
            raise OSError(err, f"Landlock refused the sandbox: {os.strerror(err)}")
        return got

    abi = call(_SYS_CREATE, None, ctypes.c_size_t(0), ctypes.c_uint32(1))
    if abi < 2:
        # ABI 1 refuses every rename between folders, which would turn beets' move into a copy.
        raise OSError(errno.ENOTSUP, f"Landlock ABI {abi} can't keep beets' move a rename")
    rights = _WRITE_RIGHTS | _REFER | (_TRUNCATE if abi >= 3 else 0)
    # struct landlock_ruleset_attr: the file rights, the network rights (none), then the scopes.
    if abi >= 6:
        scoped = _SCOPE_ABSTRACT_UNIX_SOCKET | _SCOPE_SIGNAL
        attr = ctypes.create_string_buffer(struct.pack("=QQQ", rights, 0, scoped))
        size = 24
    else:
        attr = ctypes.create_string_buffer(struct.pack("=Q", rights))
        size = 8
    ruleset = call(_SYS_CREATE, attr, ctypes.c_size_t(size), ctypes.c_uint32(0))
    try:
        for folder in folders:
            try:
                fd = os.open(folder, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
            except (FileNotFoundError, NotADirectoryError):
                continue
            try:
                # struct landlock_path_beneath_attr is packed: a u64 of rights, then the fd.
                rule = ctypes.create_string_buffer(struct.pack("=Qi", rights, fd))
                call(_SYS_ADD_RULE, ruleset, 1, rule, ctypes.c_uint32(0))
            finally:
                os.close(fd)
        if libc.prctl(38, 1, 0, 0, 0) < 0:  # PR_SET_NO_NEW_PRIVS, which Landlock requires
            raise OSError(ctypes.get_errno(), "The run couldn't drop new privileges.")
        call(_SYS_RESTRICT, ruleset, ctypes.c_uint32(0))
    finally:
        os.close(ruleset)


def report(cfg: Config, line: str) -> None:
    """Print a line for the journal and append it to the state log."""
    print(line, flush=True)
    with open(cfg.state / "log", "a", encoding="utf-8", errors="backslashreplace") as log:
        log.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {line}\n")


def unsafe(c: str) -> bool:
    """Report whether c is a control or line-separator character, which could forge a log line."""
    return unicodedata.category(c) in ("Cc", "Zl", "Zp")


def printable(name: str) -> str:
    """Return name as it is safe to show in a log line or WHY.txt.

    Control and format characters, bidi overrides among them, and the bytes of a name that
    isn't valid UTF-8 each show as "?".
    """
    return "".join("?" if unicodedata.category(c) in ("Cc", "Cf", "Cs", "Zl", "Zp") else c for c in name)


def fit(name: str, limit: int = NAME_BYTES) -> str:
    """Shorten name to at most limit bytes on disk."""
    while len(os.fsencode(name)) > limit:
        name = name[:-1]
    return name


def archive_stem(name: str) -> str | None:
    """Return the name without its archive suffix, or None when it isn't an archive."""
    lower = name.lower()
    for suffix in ARCHIVE_SUFFIXES:
        if lower.endswith(suffix) and len(name) > len(suffix):
            return name[: -len(suffix)]
    return None


def unique(parent: Path, name: str) -> Path:
    """Return parent/name, numbered " (2)", " (3)" and on when that name is taken."""
    path = parent / name
    n = 2
    while path.exists() or path.is_symlink():
        path = parent / f"{fit(name)} ({n})"
        n += 1
    return path


def pending(cfg: Config) -> list[Path]:
    """List the top-level entries waiting to import."""
    return sorted(
        p for p in cfg.inbox.iterdir() if not p.name.startswith(".") and p.name != NOT_IMPORTED
    )


def stamp(path: Path) -> tuple[int, ...]:
    """Return what shows a path changed. A client can set mtime, but not ctime."""
    try:
        st = path.lstat()
    except OSError:
        return (-1,)
    return (st.st_size, st.st_mtime_ns, st.st_ctime_ns)


def snapshot(cfg: Config, tops: list[Path]) -> dict[str, tuple[int, ...]]:
    """Map each path under the given top-level entries to its stamp()."""
    seen = {}
    for top in tops:
        seen[top.name] = stamp(top)
        if top.is_dir() and not top.is_symlink():
            # fwalk refuses a top swapped for a link after the check, where walk follows it.
            for root, dirs, files, _ in os.fwalk(top):
                for name in dirs + files:
                    path = Path(root, name)
                    seen[str(path.relative_to(cfg.inbox))] = stamp(path)
    return seen


def wait_quiet(cfg: Config, sleep=time.sleep, clock=time.monotonic) -> dict[str, tuple[int, ...]]:
    """Wait until nothing in the inbox has changed size, mtime, or ctime for cfg.quiet seconds.

    An SMB copy updates a file's mtime as it writes, so a copy still running keeps the clock
    from reaching the quiet period. Returns the last snapshot, for changed() to compare.
    """
    poll = max(0.05, min(30.0, cfg.quiet / 20))
    last = snapshot(cfg, pending(cfg))
    since = clock()
    while clock() - since < cfg.quiet:
        sleep(poll)
        now = snapshot(cfg, pending(cfg))
        if now != last:
            last, since = now, clock()
    return last


def changed(cfg: Config, item: "Item", quiet: dict[str, tuple[int, ...]]) -> bool:
    """Report whether an item changed since the quiet period ended, while earlier items imported."""
    names = {p.name for p in item.sources}
    then = {k: v for k, v in quiet.items() if Path(k).parts[0] in names}
    return snapshot(cfg, item.sources) != then


def gather(entries: list[Path]) -> list[Item]:
    """Make one item of each folder and archive, and one of all the loose files together.

    Loose files import as one item so beets' group_albums splits them into albums by their
    tags, instead of one-track albums that -q would skip.
    """
    items, loose = [], []
    for path in entries:
        if path.is_dir() and not path.is_symlink():
            items.append(Item("folder", printable(path.name), [path]))
        elif path.is_file() and not path.is_symlink() and archive_stem(path.name):
            items.append(Item("archive", printable(archive_stem(path.name)), [path]))
        else:
            loose.append(path)
    if loose:
        items.append(Item("loose", LOOSE, loose))
    return items


def bad_name(name: str) -> str | None:
    """Return why an archive member's name is unsafe to unpack, or None when it is safe."""
    if any(ord(c) < 32 or ord(c) == 127 for c in name):
        return f"a name with a control character in it: {name!r}"
    if name.startswith(("/", "\\")) or re.match(r"[A-Za-z]:", name):
        return f"an absolute path, which would unpack outside its folder: {name}"
    if ".." in re.split(r"[\\/]", name):
        return f'a path with "..", which would unpack outside its folder: {name}'
    return None


class SmallHeaders(tarfile.TarInfo):
    """A tar header that refuses a pax or long-name header past MAX_HEADER before reading it."""

    def _proc_member(self, tar):
        if self.type in LONG_HEADERS and self.size > MAX_HEADER:
            raise Refused(f"The archive has a header of {self.size:,} bytes, past the 1 MiB limit.")
        return super()._proc_member(tar)

    # tarfile reads a sparse file's map while it lists members, outside the size check above,
    # and an album never holds one, so a sparse member is refused before its map is read.
    def _refuse_sparse(self, *args):
        raise Refused("The archive holds a sparse file, which an album never does.")

    _proc_sparse = _proc_gnusparse_00 = _proc_gnusparse_01 = _proc_gnusparse_10 = _refuse_sparse


def tar_members(f: BinaryIO, plain: bool):
    """Yield each member of a tar archive as (name, kind, size).

    A plain tar whose copy stalled can end in zeros, which tarfile reads as a clean end, so
    more than two records past the last member refuses it.
    """
    with tarfile.open(fileobj=f, tarinfo=SmallHeaders) as tar:
        for m in tar:
            kind = (
                "link" if m.issym() or m.islnk()
                else "device" if m.isdev()
                else "file" if m.isfile()
                else "dir" if m.isdir()
                else "other"
            )
            yield m.name, kind, m.size
        if plain and os.fstat(f.fileno()).st_size - tar.offset > 2 * tarfile.RECORDSIZE:
            raise Refused(
                "The archive ends in empty space after its last file, so its copy may not have "
                "finished."
            )


def zip_members(f: BinaryIO):
    """Yield each member of a zip archive as (name, kind, size), its kind from the Unix mode."""
    with zipfile.ZipFile(f) as archive:
        for info in archive.infolist():
            mode = info.external_attr >> 16
            kind = (
                "link" if stat.S_ISLNK(mode)
                else "device" if stat.S_ISCHR(mode) or stat.S_ISBLK(mode) or stat.S_ISFIFO(mode)
                or stat.S_ISSOCK(mode)
                else "dir" if info.is_dir()
                else "file"
            )
            yield info.filename, kind, info.file_size


def check_members(members, free: int) -> None:
    """Raise Refused naming the archive's first unsafe member, or when it won't fit in free.

    The size check runs as each header is read, so a small archive that claims to unpack to
    far more than the disk holds is refused before its data is decompressed.
    """
    total = 0
    for count, (name, kind, size) in enumerate(members, 1):
        if count > MAX_MEMBERS:
            raise Refused(f"The archive holds more than {MAX_MEMBERS:,} entries.")
        if why := bad_name(name):
            raise Refused(f"The archive holds {why}")
        if kind == "link":
            raise Refused(f"The archive holds a link: {name}")
        if kind == "device":
            raise Refused(f"The archive holds a device or FIFO: {name}")
        if kind == "other":
            raise Refused(f"The archive holds an entry that is not a file: {name}")
        total += size if kind == "file" else 0
        if total + HEADROOM > free:
            raise Refused(
                f"The archive is too big to unpack: it needs more than {total / 2**30:.1f} GiB, "
                f"and {free / 2**30:.1f} GiB is free, of which 1 GiB stays spare."
            )


def free_bytes(path: Path) -> int:
    return shutil.disk_usage(path).free


def open_archive(path: Path) -> BinaryIO:
    """Open the archive once, refusing a link, and a FIFO that would block the run."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as err:
        if err.errno == errno.ELOOP:
            raise Refused("The archive is a link, not a file.") from err
        raise
    f = os.fdopen(fd, "rb")
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        f.close()
        raise Refused("The archive isn't a regular file.")
    return f


def unpack(cfg: Config, archive: Path, dest: Path) -> None:
    """Check the archive whole, then unpack it into dest, or raise Refused.

    The check and the unpack read one open file, so a swap between them changes nothing.
    """
    name = archive.name.lower()
    try:
        with open_archive(archive) as f:
            members = zip_members(f) if name.endswith(".zip") else tar_members(f, name.endswith(".tar"))
            check_members(members, free_bytes(cfg.inbox))
            dest.mkdir()
            f.seek(0)
            if name.endswith(".zip"):
                with zipfile.ZipFile(f) as z:
                    z.extractall(dest)
            else:
                with tarfile.open(fileobj=f, tarinfo=SmallHeaders) as tar:
                    tar.extractall(dest, filter="data")
    # zipfile raises RuntimeError for an encrypted member.
    except (
        tarfile.TarError, zipfile.BadZipFile, zlib.error, lzma.LZMAError, EOFError, OSError,
        RuntimeError, UnicodeError,
    ) as err:
        raise Refused(f"The archive can't be read, so it may be damaged or incomplete: {err}") from err


def unlock(path: Path) -> None:
    """Give a top-level folder its owner's rwx bits, which moving it into the work folder needs.

    The chmod goes through an O_PATH handle opened without following a link, so a folder a
    client swaps for a link can't redirect it.
    """
    try:
        fd = os.open(path, os.O_PATH | os.O_NOFOLLOW | os.O_DIRECTORY)
    except OSError:
        return  # Not a folder, or gone: the move or check_links() handles it.
    try:
        mode = os.fstat(fd).st_mode
        if mode & 0o700 != 0o700:
            os.chmod(f"/proc/self/fd/{fd}", stat.S_IMODE(mode) | 0o700)
    finally:
        os.close(fd)


def check_links(target: Path) -> None:
    """Raise Refused unless everything under target is a plain folder or a plain file.

    beets follows a link, a hard link keeps a second name a client can still write through,
    and a control character in a name could forge a log line. A file named as an image must
    start like one. Each folder gets mode 0755 and each file 0644, so beets can move them,
    the clean-up can delete them, and no mode a client set reaches ~/Music. A Mac's
    AppleDouble files are metadata, and are deleted, with each __MACOSX folder they leave empty.
    """
    def unreadable(err: OSError) -> None:
        raise Refused(f"It holds a folder the importer can't read: {printable(str(err.filename))}")

    macosx = []
    for root, dirs, files in os.walk(target, onerror=unreadable):
        for name in dirs + files:
            path = Path(root, name)
            rel = printable(str(path.relative_to(target)))
            st = path.lstat()
            is_dir = stat.S_ISDIR(st.st_mode)
            if not (is_dir or stat.S_ISREG(st.st_mode)):
                raise Refused(f"It holds a link or a special file: {rel}")
            if not is_dir and st.st_nlink > 1:
                raise Refused(f"It holds a file with a second name, a hard link: {rel}")
            if any(unsafe(c) for c in name):
                raise Refused(f"It holds a name with a control character in it: {rel}")
            if is_dir and name == "__MACOSX":
                macosx.append(path)
            # The work folder is hidden from clients, so a plain chmod here can't be redirected.
            mode = 0o755 if is_dir else 0o644
            if stat.S_IMODE(st.st_mode) != mode:
                os.chmod(path, mode)
            if not is_dir and name.startswith("._") and head(path, 4) == APPLEDOUBLE:
                path.unlink()
                continue
            if not is_dir and path.suffix.lower() in IMAGES and not is_raster(path):
                raise Refused(f"It holds a file named as an image that isn't one: {rel}")
    # A folder that held only AppleDouble files is now empty folders. One that still holds a
    # file was a client's own, and stays.
    for path in macosx:
        if path.exists() and not any(p.is_file() for p in path.rglob("*")):
            shutil.rmtree(path)


def head(path: Path, size: int) -> bytes:
    with open(path, "rb") as f:
        return f.read(size)


def is_raster(path: Path) -> bool:
    start = head(path, 12)
    return start.startswith(RASTER) or (start[:4] == b"RIFF" and start[8:12] == b"WEBP")


def beet(cfg: Config, *args: str) -> str:
    """Run beet and return its stdout; a failed run raises, and main() sets the item aside."""
    return subprocess.run(
        [str(cfg.beet), *args], check=True, stdout=subprocess.PIPE, text=True, errors="replace"
    ).stdout


def album_count(cfg: Config) -> int:
    return sum(1 for line in beet(cfg, "ls", "-a", "-f", "$id").splitlines() if line.isdigit())


def read_log(log: Path) -> list[tuple[str, str]]:
    """Return the import log's (tag, paths) pairs; beets joins an album's paths with "; "."""
    if not log.exists():
        return []
    pairs = []
    for line in log.read_text(errors="replace").splitlines():
        tag, _, rest = line.partition(" ")
        if tag != "import" and rest:
            pairs.append((tag, rest))
    return pairs


def covers(stdout: str) -> list[str]:
    """Return the albums coverrule listed under "Covers outside the rule:" at exit."""
    lines, inside = [], False
    for line in stdout.splitlines():
        if line.strip() == "Covers outside the rule:":
            inside = True
        elif inside and line.startswith("  "):
            lines.append(line.strip())
        else:
            inside = False
    return lines


def leftover_audio(target: Path, entries: list[tuple[str, str]]) -> list[Path]:
    """List what beets left that may be music: audio, and archives it can't open.

    A file counts when its suffix names audio or an archive, or when the import log names it
    in a skip, since beets reads a file by its header and logs every path of an album it skips.
    """
    if not target.exists():
        return []
    logged = " ".join(rest for tag, rest in entries if tag in REASONS)
    # The ._ files a Mac leaves beside each file are metadata, not music beets skipped.
    return sorted(
        p for p in target.rglob("*")
        if p.is_file() and not p.name.startswith("._") and (
            p.suffix.lower() in AUDIO | UNREADABLE | PACKED or SPLIT.search(p.name) or str(p) in logged
        )
    )


def write_why(dest: Path, lines: list[str]) -> None:
    text = WHY_HEADER + "".join(f"{line}\n" for line in lines)
    (dest / "WHY.txt").write_text(text, encoding="utf-8", errors="backslashreplace")


def open_not_imported(cfg: Config) -> int:
    """Open Not imported/ without following a link, moving aside whatever took its name."""
    for _ in range(3):
        try:
            os.mkdir(cfg.not_imported)
        except FileExistsError:
            pass
        try:
            return os.open(cfg.not_imported, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        except OSError as err:
            if err.errno not in (errno.ELOOP, errno.ENOTDIR):
                raise
            # A link or a file a client put there. Moved, it imports like any drop.
            moved = unique(cfg.inbox, f"{NOT_IMPORTED} (moved)")
            cfg.not_imported.rename(moved)
            report(cfg, f"Moved {moved.name} aside: it wasn't a folder.")
    raise RuntimeError(f"{cfg.not_imported} keeps changing into something other than a folder")


def set_aside(cfg: Config, slot: Path, label: str, moves: list[tuple[Path, Path]], why: list[str]) -> str:
    """Move each (source, path under the folder) into Not imported/<label>/ beside a WHY.txt.

    The folder is built in the work slot, which Samba hides, and then renamed into place
    through a handle that doesn't follow links, so a client can't redirect a write. Returns
    the folder's path under the inbox, for the log line.
    """
    label = fit(label)
    aside = slot / "aside"
    aside.mkdir()
    for src, rel in moves:
        (aside / rel).parent.mkdir(parents=True, exist_ok=True)
        src.rename(aside / rel)
    if os.path.lexists(aside / "WHY.txt"):
        # A loose WHY.txt a client dropped keeps its text under another name.
        (aside / "WHY.txt").rename(unique(aside, "WHY (dropped).txt"))
    write_why(aside, why)
    fd = open_not_imported(cfg)
    try:
        for n in range(1, 10_000):
            name = label if n == 1 else f"{label} ({n})"
            try:
                os.lstat(name, dir_fd=fd)
                continue
            except FileNotFoundError:
                pass
            try:
                os.rename(aside, name, dst_dir_fd=fd)
                return f"{NOT_IMPORTED}/{name}"
            except OSError as err:
                if err.errno not in (errno.EEXIST, errno.ENOTEMPTY, errno.ENOTDIR, errno.EISDIR):
                    raise
        raise RuntimeError(f"no free name for {label} in {cfg.not_imported}")
    finally:
        os.close(fd)


def is_our_why(path: Path) -> bool:
    """Report whether path is a WHY.txt this script wrote, not a file a client dropped."""
    if path.name != "WHY.txt" or path.is_symlink() or not path.is_file():
        return False
    with open(path, "rb") as f:
        return f.read(len(WHY_HEADER)) == WHY_HEADER.encode()


def guard_work(cfg: Config) -> None:
    """Remove whatever took the work folder's name if it isn't a real folder.

    Samba vetoes the name, so only a gap in the veto lets a client make it a link, and a
    link would point recover() and the clean-up at a folder outside the inbox.
    """
    if cfg.work.is_symlink() or (cfg.work.exists() and not cfg.work.is_dir()):
        cfg.work.unlink()
        report(cfg, f"Removed {WORK}: it wasn't a folder.")


def restore(cfg: Config, slot: Path) -> list[str]:
    """Move an item's files in a work slot back to the inbox's top level, then delete the slot.

    src/ holds what beets hadn't moved, and aside/ what set_aside() hadn't yet moved into
    Not imported. The rest of the slot is an archive's unpacked copy and our own WHY.txt.
    A failed rename raises before the slot is deleted, so the next run's recover() retries.
    Returns the names the files now have in the inbox.
    """
    names = []
    if slot.is_dir() and not slot.is_symlink():
        for part in ("src", "aside"):
            if (slot / part).is_dir() and not (slot / part).is_symlink():
                for entry in sorted((slot / part).iterdir()):
                    if not is_our_why(entry):
                        dest = unique(cfg.inbox, entry.name)
                        entry.rename(dest)
                        names.append(dest.name)
        shutil.rmtree(slot)
    elif os.path.lexists(slot):
        slot.unlink()
    return names


def recover(cfg: Config) -> None:
    """Move what a crashed run left in the work folder back to the inbox's top level."""
    guard_work(cfg)
    if not cfg.work.exists():
        return
    for slot in sorted(cfg.work.iterdir()):
        restore(cfg, slot)
        report(cfg, f"Moved a crashed run's leftovers in {slot.name} back to the inbox.")


def process(cfg: Config, item: Item, slot: Path, albums: int | None) -> int | None:
    """Import one item through beets, set aside what it skipped, and log one line.

    Takes the library's album count before the item, or None when no item has counted it
    yet, and returns it after, so each item lists the library once.
    """
    src = slot / "src"
    src.mkdir(parents=True)
    # A rename on the inbox's file system, so beets' move into ~/Music is a rename too.
    for path in item.sources:
        unlock(path)
        path.rename(src / path.name)
    whole = [(src / p.name, Path(p.name)) for p in item.sources]
    try:
        # Each source is checked where it now sits, so one a client swapped for a link
        # after gather() is refused.
        check_links(src)
        if item.kind == "archive":
            target = slot / "unpacked"
            unpack(cfg, whole[0][0], target)
            check_links(target)
        else:
            target = whole[0][0] if item.kind == "folder" else src
    except Refused as refused:
        # A reason can quote a name from the archive or the folder, so it is shown escaped.
        why = printable(str(refused))
        dest = set_aside(cfg, slot, item.label, whole, [why])
        shutil.rmtree(slot)
        report(cfg, f"{item.label}: not imported, moved to {dest}. {why}")
        return albums

    if albums is None:
        albums = album_count(cfg)
    log = slot / "import.log"
    stdout = beet(cfg, "import", "-q", "-l", str(log), str(target))
    after = album_count(cfg)
    entries = read_log(log)
    left = leftover_audio(target, entries)
    # beets logs each album it skips, once.
    skipped = sum(1 for tag, _ in entries if tag in REASONS)
    line = f"{item.label}: {after - albums} albums imported, {skipped} skipped"

    why = why_lines(target, left, entries, item.label)
    if not left and after == albums:
        why = [f"{item.label}: It holds no music beets can read."]
    if why:
        # A skipped archive is kept whole; a folder keeps only the audio beets left.
        keep = whole if item.kind == "archive" or not left else [(p, p.relative_to(target)) for p in left]
        line += f", moved to {set_aside(cfg, slot, item.label, keep, why)}"
    shutil.rmtree(slot)
    if cover_lines := covers(stdout):
        line += ". Covers outside the rule: " + "; ".join(map(printable, cover_lines))
    report(cfg, line + ".")
    return after


def why_lines(target: Path, left: list[Path], entries, label: str) -> list[str]:
    """Name each folder holding audio beets left, with the reason its import log gives."""
    folders: dict[str, str] = {}
    for path in left:
        rel = path.parent.relative_to(target)
        name = printable(str(rel)) if rel.parts else label
        if path.suffix.lower() in PACKED or SPLIT.search(path.name):
            reason = f"beets can't import a {path.suffix.lower()} archive; unpack it and drop the folder."
        elif path.suffix.lower() in UNREADABLE:
            reason = f"beets can't read {path.suffix.lower()} files."
        else:
            reason = next(
                (REASONS.get(tag, f"beets logged {tag}.") for tag, rest in entries if str(path) in rest),
                "beets left it without logging why; see journalctl --user -u fresh-tracks.",
            )
        folders.setdefault(name, reason)
    return [f"{name}: {reason}" for name, reason in folders.items()]


def main() -> int:
    cfg = load_config()
    if not cfg.inbox.is_dir():
        return 0
    cfg.state.mkdir(parents=True, exist_ok=True)
    with open(cfg.state / "lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        recover(cfg)
        # Inbox names of the items that failed, skipped for the rest of this run.
        failed: set[str] = set()

        def todo() -> list[Path]:
            return [p for p in pending(cfg) if p.name not in failed]

        # Sweep again after each batch, so a drop that lands mid-run imports in this run.
        while todo():
            quiet = wait_quiet(cfg)
            guard_work(cfg)
            cfg.work.mkdir(exist_ok=True)
            albums = None
            for n, item in enumerate(gather(todo()), 1):
                if changed(cfg, item, quiet):
                    report(cfg, f"{item.label}: still changing, so it waits for the next quiet period.")
                    continue
                slot = unique(cfg.work, str(n))
                try:
                    albums = process(cfg, item, slot, albums)
                except Exception as err:
                    # One bad item fails the service but never blocks the items after it. What
                    # beets hadn't imported goes back to the inbox, and the next run retries it.
                    failed |= {p.name for p in item.sources}
                    albums = None
                    try:
                        failed |= set(restore(cfg, slot))
                        where = "what is left of it is back in the inbox for the next run"
                    except Exception as again:
                        where = f"its files wait in {WORK}/{slot.name} for the next run ({again})"
                    line = f"{item.label}: the importer failed on it, and {where}."
                    report(cfg, printable(f"{line} {type(err).__name__}: {err}"))
    return 1 if failed else 0


if __name__ == "__main__":
    config = load_config()
    config.state.mkdir(parents=True, exist_ok=True)
    confine(writable(config))
    sys.exit(main())
