#!/usr/bin/env python3
"""Answer the gh calls pass-report makes from the JSON file named by FAKE_GH_DATA."""
import json
import os
import sys

data = json.load(open(os.environ["FAKE_GH_DATA"]))
argv = sys.argv[1:]
log = os.environ.get("FAKE_GH_LOG")
if log:
    with open(log, "a") as fh:
        fh.write(" ".join(argv) + "\n")


def opt(name):
    return argv[argv.index(name) + 1]


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


if data.get("fail"):
    fail(data["fail"])
if argv[:2] == ["repo", "list"]:
    out = [{"name": n} for n in data["repos"]]
elif argv[:2] == ["pr", "list"]:
    repo = opt("-R").split("/")[1]
    if repo in data.get("ratelimit", []):
        fail("API rate limit exceeded; resets at 2020-01-01T00:00:00Z")
    out = data.get("prs", {}).get(repo, [])
elif argv[:2] == ["run", "list"]:
    repo = opt("-R").split("/")[1]
    lo, hi = opt("--created").split("..")
    runs = [r for r in data.get("runs", {}).get(repo, []) if lo <= r["startedAt"] <= hi]
    out = runs[: int(opt("--limit"))]
elif argv[:2] == ["run", "view"]:
    out = data["jobs"][argv[2]]
else:
    fail("unexpected gh call: " + " ".join(argv))
print(json.dumps(out))
