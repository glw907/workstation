#!/usr/bin/env bash
# A fake pass-cli for the secret-script tests. It records every call, serves a fixture vault from
# disk, and mimics the three behaviors the scripts depend on: a session lives in
# PROTON_PASS_SESSION_DIR, an agent session refuses a read with no PROTON_PASS_AGENT_REASON, and
# a bad token fails the login. It touches no network and no real Proton session.
#
# Environment (all set by the test):
#   FAKE_PASS_LOG        file (an item create's stdin goes to $FAKE_PASS_LOG.stdin); one line per call: "<args> | session=<dir> reason=<text> token=<set|none>"
#   FAKE_PASS_FIXTURE    directory; pass://V/I/F is served from the file $FAKE_PASS_FIXTURE/V/I/F
#   FAKE_PASS_GOOD_TOKEN the one token a login accepts (default pst_fake::KEY)
#   FAKE_PASS_WEB_FAIL   non-empty: a web login (no token) fails
set -uo pipefail

log="${FAKE_PASS_LOG:?FAKE_PASS_LOG is not set}"
sess="${PROTON_PASS_SESSION_DIR:-}"
token="${PROTON_PASS_PERSONAL_ACCESS_TOKEN:-}"
printf '%s | session=%s reason=%s token=%s\n' "$*" "${sess:-UNSET}" "${PROTON_PASS_AGENT_REASON:-}" \
    "$([[ -n "$token" ]] && echo set || echo none)" >> "$log"

# The default session directory is the one a real user session lives in; a script must never use it.
[[ -n "$sess" && "$sess" != "$HOME/.local/share/proton-pass-cli"* ]] || {
    echo "fake pass-cli: refusing the default session directory" >&2
    exit 90
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
    login)
        if [[ -n "$token" ]]; then
            [[ "$token" == "${FAKE_PASS_GOOD_TOKEN:-pst_fake::KEY}" ]] || { echo "fake pass-cli: token rejected" >&2; exit 1; }
            mkdir -p "$sess" && echo agent > "$sess/session"
        else
            [[ -z "${FAKE_PASS_WEB_FAIL:-}" ]] || { echo "fake pass-cli: web login failed" >&2; exit 1; }
            mkdir -p "$sess" && echo web > "$sess/session"
        fi
        ;;
    info)
        [[ -f "$sess/session" ]] || { echo "fake pass-cli: not logged in" >&2; exit 1; }
        ;;
    logout)
        rm -f "$sess/session"
        ;;
    vault)
        [[ -f "$sess/session" ]] || { echo "fake pass-cli: not logged in" >&2; exit 1; }
        if [[ "${1:-}" == member && "${2:-}" == list ]]; then
            # SYNTHETIC: modeled on the pass-cli docs, not on a recorded run. Served from
            # $FAKE_PASS_FIXTURE/_members-<vault name>.json.
            shift 2
            name=""
            while [[ $# -gt 0 ]]; do
                case "$1" in --vault-name) name="${2:-}" ;; --vault-name=*) name="${1#*=}" ;; esac
                shift
            done
            cat "${FAKE_PASS_FIXTURE:?FAKE_PASS_FIXTURE is not set}/_members-$name.json"
            exit $?
        fi
        [[ "${1:-}" == list ]] || { echo "fake pass-cli: unsupported: vault ${1:-}" >&2; exit 2; }
        cat "${FAKE_PASS_FIXTURE:?FAKE_PASS_FIXTURE is not set}/_vaults.json"
        ;;
    agent)
        [[ -f "$sess/session" ]] || { echo "fake pass-cli: not logged in" >&2; exit 1; }
        # SYNTHETIC: `agent list --output json` and `agent access grant|revoke` follow the
        # pass-cli docs; no run recorded a reply to either.
        case "${1:-} ${2:-}" in
            "list "*) cat "${FAKE_PASS_FIXTURE:?FAKE_PASS_FIXTURE is not set}/_agents.json" ;;
            "access grant"|"access revoke") ;;
            *) echo "fake pass-cli: unsupported: agent ${1:-} ${2:-}" >&2; exit 2 ;;
        esac
        ;;
    share)
        # SYNTHETIC: a reply modeled on the pass-cli docs' fields (share_type, name, share_role),
        # not on a recorded run. A test supplies $FAKE_PASS_FIXTURE/_shares.json.
        [[ "${1:-}" == list ]] || { echo "fake pass-cli: unsupported: share ${1:-}" >&2; exit 2; }
        [[ -f "$sess/session" ]] || { echo "fake pass-cli: not logged in" >&2; exit 1; }
        cat "${FAKE_PASS_FIXTURE:?FAKE_PASS_FIXTURE is not set}/_shares.json"
        ;;
    item)
        if [[ "${1:-}" == list ]]; then
            [[ -f "$sess/session" ]] || { echo "fake pass-cli: not logged in" >&2; exit 1; }
            share=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --share-id|--vault-name) share="${2:-}" ;;
                    --vault-name=*) share="${1#*=}" ;;
                esac
                shift
            done
            [[ -z "${FAKE_PASS_NOISE:-}" ]] || echo "Error opening share deadbeef" >&2
            [[ -z "${FAKE_PASS_SLEEP:-}" ]] || sleep "$FAKE_PASS_SLEEP"
            cat "${FAKE_PASS_FIXTURE:?FAKE_PASS_FIXTURE is not set}/_items-$share.json"
            exit $?
        fi
        if [[ "${1:-}" == update || "${1:-}" == trash || "${1:-}" == move ]] && [[ "$*" == *--item-id* ]]; then
            # Replies modeled on ~/.local/state/credential-hygiene/apply.sh and apply2.sh: each
            # prints nothing on success; the noise line is the one those scripts filter.
            [[ -f "$sess/session" ]] || { echo "fake pass-cli: not logged in" >&2; exit 1; }
            [[ -z "${FAKE_PASS_NOISE:-}" ]] || echo "Error opening share deadbeef" >&2
            exit 0
        fi
        if [[ "${1:-}" == view && "$*" == *--item-id* ]]; then
            [[ -f "$sess/session" ]] || { echo "fake pass-cli: not logged in" >&2; exit 1; }
            id=""
            for a in "$@"; do case "$a" in --item-id=*) id="${a#*=}" ;; esac; done
            cat "${FAKE_PASS_FIXTURE:?FAKE_PASS_FIXTURE is not set}/_view-$id.json"
            exit $?
        fi
        if [[ "${1:-}" == create ]]; then
            [[ -f "$sess/session" && -n "${PROTON_PASS_AGENT_REASON:-}" ]] || { echo "fake pass-cli: create needs a session and a reason" >&2; exit 1; }
            cat > "$log.stdin"
            exit 0
        fi
        [[ "${1:-}" == view ]] || { echo "fake pass-cli: unsupported: item ${1:-}" >&2; exit 2; }
        shift
        [[ -f "$sess/session" ]] || { echo "fake pass-cli: not logged in" >&2; exit 1; }
        if [[ "$(cat "$sess/session")" == agent ]]; then
            reason="${PROTON_PASS_AGENT_REASON:-}"
            [[ -n "$reason" && ${#reason} -le 300 ]] || { echo "fake pass-cli: agent read needs a reason of 1 to 300 characters" >&2; exit 1; }
        fi
        ref="${1:-}"
        [[ "$ref" == pass://* ]] || { echo "fake pass-cli: want a pass:// reference" >&2; exit 2; }
        file="${FAKE_PASS_FIXTURE:?FAKE_PASS_FIXTURE is not set}/${ref#pass://}"
        [[ -f "$file" ]] || { echo "fake pass-cli: no such item: $ref" >&2; exit 1; }
        cat "$file"
        ;;
    *)
        echo "fake pass-cli: unsupported command: $cmd" >&2
        exit 2
        ;;
esac
