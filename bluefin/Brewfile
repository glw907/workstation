# Homebrew formulae for the Bluefin DX CLI estate.
# Curated from the CLI estate list in docs/MIGRATION-BRIEF.md.
#
# khard, vdirsyncer, and yt-dlp are Python tools: installed via `uv tool
# install` in bootstrap.sh setup instead of Homebrew.
#
# npm globals decision: browser-sync, markdownlint-cli, prettier stay
# per-project via mise node, deliberately not installed globally.

brew "age"
brew "gh"
brew "googleworkspace-cli"   # gws: Google Docs/Drive/Sheets from Claude Code (2026-09-14)
brew "git"
brew "jq"
brew "yq"
brew "micro"
brew "stow"
brew "tmux"
brew "pandoc"
brew "hugo"
brew "sqlite"
brew "imagemagick"
brew "ffmpeg"
brew "socat"
brew "ttyd"
brew "rsync"
brew "vale"
brew "syncthing"
brew "chafa"

# tui-visual-verify's kitty-shot harness: it locates and focuses the kitty
# window with xdotool and captures it with ImageMagick's `import`, both
# X11-only. kitty.conf forces XWayland so they can see it. (imagemagick is
# already above; `import` comes from it.)
brew "xdotool"

# Go toolchain (brief: "Go via Homebrew")
brew "go"
brew "gofumpt"
brew "golangci-lint"

# Android tooling dependency
brew "openjdk@17"

# Runtime/tool version managers (brief: "Node via mise ... Python tools via uv")
brew "mise"
brew "uv"

# Claude Code. The cask, not the native ~/.local/bin installer: Homebrew is
# the CLI tier on this machine, and the cask updates with `ujust update`
# alongside everything else instead of self-updating on its own schedule.
cask "claude-code@latest" # switched from stable cask 2026-09-04: Fable 5.1 needs >=2.1.251, stable lagged at 2.1.236

# No font casks, deliberately. The Bluefin base image already ships
# JetBrains Mono and Symbols Nerd Font Mono, which is what kitty.conf now
# asks for, and Ptyxis (the daily terminal) uses the system monospace.
brew "gitleaks"     # staged-secret scan in the pre-commit hook and scripts/check.sh
brew "shellcheck"   # bash lint; adopted 2026-08-30 after check-drift flagged it installed-unmanifested
brew "bats-core"    # bash test framework; musicbox scripts run their bats suites on this machine
brew "libarchive"   # for bsdtar: safe archive extraction in the musicbox inbox scripts
