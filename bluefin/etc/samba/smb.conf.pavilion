# Pavilion's Samba config: one share, Fresh Tracks, the household network's inbox
# for new music. fresh-tracks imports what lands there into ~/Music through beets,
# and nothing shares ~/Music itself. It replaces Fedora's stock file, which shares
# home directories and printers. Staged in ~/.dotfiles/bluefin/etc/samba/; see
# etc-drift.md.
[global]
	workgroup = WORKGROUP
	server string = pavilion
	security = user
	passdb backend = tdbsam
	map to guest = never
	# Only the Warwick network and pavilion itself; Warwick-Devices and
	# Warwick-Guest are refused here and at the firewall.
	hosts allow = 192.168.1.0/24 127.0.0.1
	server min protocol = SMB3
	# SMB3 POSIX extensions, Samba's default, pinned: a Linux kernel mount with
	# -o posix stores names with : * ? " < > | \ or a trailing space or dot
	# unchanged. GNOME Files and Dolphin can't use them, and Samba refuses
	# those characters from them before any VFS module could rename them.
	smb3 unix extensions = yes
	load printers = no
	printing = bsd
	printcap name = /dev/null
	disable spoolss = yes

# Oliver signs in as oliver and Geoff as glw907. Every read and write acts as
# glw907, so the files stay glw907's and the importer can move them. SELinux lets
# Samba into ~/FreshTracks alone, through its samba_share_t label (etc-drift.md).
# The importer's work folder is vetoed, so a drop can't touch an import in flight.
[Fresh Tracks]
	comment = New music: drop albums, tracks, or archives here
	path = /var/home/glw907/FreshTracks
	read only = no
	browseable = yes
	valid users = oliver glw907
	force user = glw907
	force group = glw907
	create mask = 0644
	directory mask = 0755
	hide dot files = yes
	veto files = /.fresh-tracks-work/
	# An inbox needs no links, and a link a POSIX client makes could reach the vetoed folder.
	follow symlinks = no
