[Unit]
Description=Import new music from ~/Fresh Tracks into ~/Music through beets
ConditionHost=pavilion
# No implicit ordering before default.target: the run at login can wait out a
# 10-minute quiet period, and the login shouldn't wait with it.
DefaultDependencies=no
# The path unit makes ~/Fresh Tracks, and the bind below needs it to exist.
After=fresh-tracks.path
Conflicts=shutdown.target
Before=shutdown.target
# Each successful run starts the artist photos, so new artists get theirs
# within minutes of the import.
OnSuccess=artist-photos.service

[Service]
# fresh-tracks.path starts this when the inbox changes. It also runs once at
# login, because PathChanged= doesn't fire for entries already waiting.
Type=oneshot
ExecStart=%h/.local/bin/fresh-tracks
# Home is an empty tmpfs except for what beets and the script use. Each path
# below is its own mount, so beets' move into ~/Music copies each file to a
# temporary name there and renames it into place.
ProtectHome=tmpfs
BindPaths="%h/Fresh Tracks" %h/Music %h/.local/share/beets
BindReadOnlyPaths=%h/.config/beets %h/.dotfiles/beets %h/.dotfiles/bin
BindReadOnlyPaths=%h/.local/bin %h/.local/share/uv/tools/beets
StateDirectory=fresh-tracks
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target
