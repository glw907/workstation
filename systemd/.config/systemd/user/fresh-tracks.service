[Unit]
Description=Import new music from ~/FreshTracks into ~/Music through beets
ConditionHost=pavilion
# No implicit ordering before default.target: the run at login can wait out a
# 10-minute quiet period, and the login shouldn't wait with it.
DefaultDependencies=no
# Each top-level change starts a run, and one with nothing waiting exits at once. No
# start limit, so a burst of those can't fail the unit and stop the path unit watching.
StartLimitIntervalSec=0
# The path unit makes ~/FreshTracks, so a run at login finds it.
After=fresh-tracks.path
Conflicts=shutdown.target
Before=shutdown.target

[Service]
# fresh-tracks.path starts this when the inbox changes. It also runs once at
# login, because PathChanged= doesn't fire for entries already waiting.
Type=oneshot
ExecStart=%h/.local/bin/fresh-tracks
# A oneshot has no start timeout by default, and a run that hangs would stop every later
# import. A run killed here leaves its item for the next run's recovery.
TimeoutStartSec=6h
MemoryMax=4G
# beets hands files from a share others write to on to ImageMagick, Ghostscript, and ffmpeg,
# so a hostile file must not reach a secret or plant code for a later run. The inbox and
# ~/Music stay on home's mount, since a bind of each would turn beets' move between them
# into a copy. Instead the run's config and code are read-only, and the rest of .config,
# .local, and .dotfiles is replaced with an empty tmpfs.
TemporaryFileSystem=%h/.config:ro %h/.local:ro %h/.dotfiles:ro
# uv and go trust their caches on reuse, so a run gets a scratch ~/.cache it can't leave behind.
TemporaryFileSystem=%h/.cache
BindReadOnlyPaths=%h/.config/beets %h/.local/bin %h/.local/share/uv %h/.dotfiles/bin %h/.dotfiles/beets
BindPaths=%h/.local/share/beets %h/.local/share/music-cover-originals
StateDirectory=fresh-tracks
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.claude -%h/.claude.json -%h/.clasprc.json -%h/.mozilla -%h/.var -%h/.vdirsyncer -%h/.contacts -%h/.npm -%h/Projects -%h/Documents -%h/.bash_history -%h/.viminfo -%h/.subversion -%h/.android
# The user manager and session bus could start a process outside the sandbox, and the docker
# and libvirt sockets give root, so the run gets no Unix sockets and no runtime folder.
InaccessiblePaths=-%t
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
# The security key, camera, microphone, and open terminals stay out of reach.
PrivateDevices=yes
RestrictNamespaces=yes
ReadOnlyPaths=-%h/.bashrc -%h/.bash_profile -%h/.bash_logout -%h/.profile -%h/.zshrc -%h/.zprofile -%h/.gitconfig
# Every shell runs brew from here, and PATH holds these, so a run must not rewrite them.
ReadOnlyPaths=-/var/home/linuxbrew -%h/go -%h/.homebrew
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
