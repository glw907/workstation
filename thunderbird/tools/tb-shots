#!/usr/bin/env bash
set -euo pipefail

# tb-shots: build a scratch Thunderbird profile from the tracked test
# messages, install this checkout's theme layer into it, run Thunderbird
# headless, and write the screenshot set into <outdir> (see tb_shots.py).
#
# Usage: tb-shots [--keep] <outdir>
#   <outdir>  must not exist or must be empty (exit 2 otherwise)
#   --keep    leave the scratch profile in place for the sync's --check
#
# It never touches a live profile: the scratch profile has its own folder,
# and Thunderbird is stopped only by `flatpak kill <numeric instance id>`
# (never by app id, which would also end an open Thunderbird).

HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
REPO="$(cd "$HERE/../.." && pwd)"
PORT=28282
# The same folder seen from the host and from inside the Flatpak sandbox.
HOST_PROFILE="$HOME/.var/app/org.mozilla.thunderbird/.thunderbird/tb-nord-harness"
SANDBOX_PROFILE="$HOME/.thunderbird/tb-nord-harness"

keep=0
outdir=""
for arg in "$@"; do
    case "$arg" in
        --keep) keep=1 ;;
        -*) echo "usage: tb-shots [--keep] <outdir>" >&2; exit 2 ;;
        *) [[ -z "$outdir" ]] || { echo "usage: tb-shots [--keep] <outdir>" >&2; exit 2; }
           outdir="$arg" ;;
    esac
done
[[ -n "$outdir" ]] || { echo "usage: tb-shots [--keep] <outdir>" >&2; exit 2; }

if [[ -e "$outdir" ]] && [[ -n "$(ls -A "$outdir" 2>/dev/null)" ]]; then
    echo "tb-shots: $outdir is not empty" >&2
    exit 2
fi

port_taken() { ss -ltn | grep -q ":$PORT "; }

if port_taken; then
    echo "tb-shots: port $PORT is taken; another Thunderbird holds it" >&2
    exit 1
fi

mkdir -p "$outdir"
tmp="$(mktemp -d)"
: > "$tmp/instance"
runpid=""

# Stops the harness Thunderbird by its numeric instance id and nothing else,
# then removes the scratch profile unless --keep was given.
cleanup() {
    local id=""
    [[ -s "$tmp/instance" ]] && id="$(tr -d '[:space:]' < "$tmp/instance")"
    if [[ "$id" =~ ^[0-9]+$ ]]; then
        flatpak kill "$id" 2>/dev/null || true
        # The sandbox's helper processes outlive the kill by a moment.
        local n
        for _ in $(seq 1 50); do
            flatpak ps --columns=instance | grep -qx "$id" || break
            sleep 0.2
        done
    fi
    if [[ -n "$runpid" ]]; then
        local i
        for _ in $(seq 1 50); do
            kill -0 "$runpid" 2>/dev/null || break
            sleep 0.2
        done
    fi
    # Read-only wait for the sandbox's last processes to go; nothing is signalled.
    local m
    for _ in $(seq 1 50); do
        ps -eo args | grep -q '[t]b-nord-harness' || break
        sleep 0.2
    done
    if [[ "$keep" -eq 0 ]]; then
        rm -rf "$HOST_PROFILE"
    fi
    rm -rf "$tmp"
}
trap cleanup EXIT

# A leftover profile (from --keep or a crash) goes only while the port is free.
rm -rf "$HOST_PROFILE"
mkdir -p "$HOST_PROFILE/Mail/Local Folders"

# The mbox: every fixture message in file order, one "From " line each.
inbox="$HOST_PROFILE/Mail/Local Folders/Inbox"
: > "$inbox"
for f in "$HERE"/fixtures/messages/*.eml; do
    echo "From - Tue Oct 13 10:00:00 2026" >> "$inbox"
    cat "$f" >> "$inbox"
done
cp "$HERE/fixtures/prefs.js" "$HOST_PROFILE/prefs.js"

"$REPO/bin/.local/bin/thunderbird-theme-sync" --profile "$HOST_PROFILE" >/dev/null

flatpak run --instance-id-fd=3 --env=MOZ_HEADLESS=1 org.mozilla.thunderbird \
    --profile "$SANDBOX_PROFILE" --no-remote --marionette \
    -remote-allow-system-access 3>"$tmp/instance" >"$tmp/tb.log" 2>&1 &
runpid=$!

for _ in $(seq 1 100); do
    [[ -s "$tmp/instance" ]] && break
    sleep 0.1
done
if [[ ! -s "$tmp/instance" ]]; then
    echo "tb-shots: Thunderbird never reported an instance id" >&2
    exit 1
fi
echo "tb-shots: instance id $(tr -d '[:space:]' < "$tmp/instance")"

uv run --quiet --with marionette_driver python "$HERE/tb_shots.py" \
    --profile "$SANDBOX_PROFILE" --port "$PORT" --out "$outdir" \
    --messages "$HERE/fixtures/messages" ${TB_SHOTS_PYARGS:-}
