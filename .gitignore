# Ignore backup files
*.backup.*
*.bak
*~

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore sensitive data (in case accidentally placed here)
*.key
*.pem
*.p12
*.env
*_rsa
*_dsa
*_ecdsa
*_ed25519

# Ignore vim swap files
*.swp
*.swo

# Ignore temporary files
*.tmp
.*.tmp

# Python bytecode caches
__pycache__/
*.pyc

# Wrangler local state (e.g. under scripts/secrets/)
.wrangler/

# Secrets — decrypted plaintext, never commit
# values.age is NOT excluded — encrypted files are safe to commit
secrets/*.txt
secrets/*.env
secrets/*.decrypted

# Browser-state dumps and databases never belong in this repo (a places.sqlite
# with session tokens sat in public history Jan-Apr 2026; see registry.md)
*.sqlite
*places*
*bookmarks*

# Tool caches (each also self-ignores, but do not depend on that)
.pytest_cache/
.ruff_cache/

# Claude Code runtime cache of claude.ai-synced skills
claude/.claude/skills/synced/
